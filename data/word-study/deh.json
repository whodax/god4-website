  "entries": {
    "dehisce": {
      "word": "DEHISCE",
      "definitions": [
        {
          "text": "To gape; to open by dehiscence.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "dehiscence": {
      "word": "DEHISCENCE",
      "definitions": [
        {
          "text": "The act of gaping.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Biol.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A gaping or bursting open along a definite line of attachment or suture, without tearing, as in the opening of pods, or the bursting of capsules at maturity so as to emit seeds, etc.; also, the bursting open of follicles, as in the ovaries of animals, for the expulsion of their contents.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "dehiscent": {
      "word": "DEHISCENT",
      "definitions": [
        {
          "text": "Characterized by dehiscence; opening in some definite way, as the capsule of a plant.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "dehonestate": {
      "word": "DEHONESTATE",
      "definitions": [
        {
          "text": "To disparage. [Obs.]",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "dehonestation": {
      "word": "DEHONESTATION",
      "definitions": [
        {
          "text": "A dishonoring; disgracing. [Obs.] Gauden.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "dehorn": {
      "word": "DEHORN",
      "definitions": [
        {
          "text": "To deprive of horns; to prevent the growth or the horns of (cattle) by burning their ends soon after they start. See Dishorn. \"Dehorning cattle.\" Farm Journal (1886).",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "dehors": {
      "word": "DEHORS",
      "definitions": [
        {
          "text": "Out of; without; foreign to; out of the agreement, record, will, or other instrument.",
          "partOfSpeech": "preposition"
        },
        {
          "text": "All sorts of outworks in general, at a distance from the main works; any advanced works for protection or cover. Farrow.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "dehort": {
      "word": "DEHORT",
      "definitions": [
        {
          "text": "To urge to abstain or refrain; to dissuade. [Obs.] The apostles vehemently dehort us from unbelief. Bp. Ward. \"Exhort\" remains, but dehort, a word whose place neither \"dissuade\" nor any other exactly supplies, has escaped us. Trench.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "dehortation": {
      "word": "DEHORTATION",
      "definitions": [
        {
          "text": "Dissuasion; advice against something. [R.]",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "dehortative": {
      "word": "DEHORTATIVE",
      "definitions": [
        {
          "text": "Dissuasive. [R.]",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "dehortatory": {
      "word": "DEHORTATORY",
      "definitions": [
        {
          "text": "Fitted or designed to dehort or dissuade. Bp. Hall.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "dehorter": {
      "word": "DEHORTER",
      "definitions": [
        {
          "text": "A dissuader; an adviser to the contrary. [Obs.]",
          "partOfSpeech": "noun"
        }

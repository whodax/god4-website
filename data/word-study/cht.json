    "chthonophagia": {
      "word": "CHTHONOPHAGIA; CHTHONOPHAGY",
      "definitions": [
        {
          "text": "A disease characterized by an irresistible desire to eat earth, observed in some parts of the southern United States, the West Indies, etc.",
          "partOfSpeech": "noun"

    "chthonic": {
      "word": "CHTHONIC",
      "definitions": [
        {
          "text": "Pertaining to the earth; earthy; as, chthonic religions. [The] chthonic character of the wife of Zeus. Max Müller.",
          "partOfSpeech": "adjective"
        }
      ],

    "heddle": {
      "word": "HEDDLE",
      "definitions": [
        {
          "text": "One of the sets of parallel doubled threads which, with mounting, compose the harness employed to guide the warp threads to the lathe or batten in a loom.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To draw (the warp thread) through the heddle-eyes, in weaving.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "heddleeye": {
      "word": "HEDDLE-EYE",
      "definitions": [
        {
          "text": "The eye or loop formed in each heddle to receive a warp thread.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "heddling": {
      "word": "HEDDLING",

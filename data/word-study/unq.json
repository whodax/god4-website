      "word": "UNQUESTIONED",
      "definitions": [
        {
          "text": "Not called in question; not doubted.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Not interrogated; having no questions asked; not examined or examined into. Shak. She muttering prayers, as holy rites she meant, Through the divided crowd unquestioned went. Dryden.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Indisputable; not to be opposed or impugned. Their unquestioned pleasures must be served. B. Jonson.",
          "partOfSpeech": "adjective"
        }
      ],

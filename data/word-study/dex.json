    "dexterous": {
      "word": "DEXTEROUS",
      "definitions": [
        {
          "text": "Ready and expert in the use of the body and limbs; skillful and active with the hands; handy; ready; as, a dexterous hand; a dexterous workman.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Skillful in contrivance; quick at inventing expedients; expert; as, a dexterous manager. Dexterous the craving, fawning crowd to quit. Pope.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Done with dexterity; skillful; artful; as, dexterous management. \"Dexterous sleights of hand.\" Trench. handy; versed.",
          "partOfSpeech": "adjective"
        }
      ],

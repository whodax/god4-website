    "dextrorotatory": {
      "word": "DEXTROROTATORY",
      "definitions": [
        {
          "text": "Turning, or causing to turn, toward the right hand; esp., turning the plane of polarization of luminous rays toward the right hand; as, dextrorotatory crystals, sugars, etc. Cf. Levorotatory.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "dextrorsal": {
      "word": "DEXTRORSAL; DEXTRORSE",
      "definitions": [
        {
          "text": "Turning from the left to the right, in the ascending line, as in the spiral inclination of the stem of the common morning-glóry. quality of the plant regarded objectively; formerly the plant was regarded subjectively, and what is now called dextrorse was then considered sinistrorse.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "dextrorse": {
      "word": "DEXTRORSAL; DEXTRORSE",
      "definitions": [
        {
          "text": "Turning from the left to the right, in the ascending line, as in the spiral inclination of the stem of the common morning-glóry. quality of the plant regarded objectively; formerly the plant was regarded subjectively, and what is now called dextrorse was then considered sinistrorse.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "dextrose": {
      "word": "DEXTROSE",
      "definitions": [
        {
          "text": "A sirupy, or white crystalline, variety of sugar, C6H12O6 (so called from turning the plane of polarization to the right), occurring in many ripe fruits. Dextrose and levulose are obtained by the inversion of cane sugar or sucrose, and hence called invert sugar. Dextrose is chiefly obtained by the action of heat and acids on starch, and hence called also starch sugar. It is also formed from starchy food by the action of the amylolytic ferments of saliva and pancreatic juice. sirupy products as glucose, or mixing sirup. These are harmless, but are only about half as sweet as cane or sucrose.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

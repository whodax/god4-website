    "exquisite": {
      "word": "EXQUISITE",
      "definitions": [
        {
          "text": "Carefully selected or sought out; hence, of distinguishing and surpassing quality; exceedingly nice; delightfully excellent; giving rare satisfaction; as, exquisite workmanship. Plate of rare device, and jewels Of reach and exquisite form. Shak. I have no exquisite reason for 't, but I have reason good enough. Shak.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Exceeding; extreme; keen; -- used in a bad or a good sense; as, exquisite pain or pleasure.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Of delicate perception or close and accurate discrimination; not easy to satisfy; exact; nice; fastidious; as, exquisite judgment, taste, or discernment. His books of Oriental languages, wherein he was exquisite. Fuller. consummate; perfect.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "One who manifests an exquisite attention to external appearance; one who is overnice in dress or ornament; a fop; a dandy.",
          "partOfSpeech": "noun"
        }
      ],

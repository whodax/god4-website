    "bayard": {
      "word": "BAYARD",
      "definitions": [
        {
          "text": "Etym: [OF. bayard, baiart, bay horse; bai bay + -ard. See Bay, a., and -ard.]",
          "partOfSpeech": "noun"
        },
        {
          "text": "Properly, a bay horse, but often any horse. Commonly in the phrase blind bayard, an old blind horse. Blind bayard moves the mill. Philips.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Etym: [Cf. F. bayeur, fr. bayer to gape.]",
          "partOfSpeech": "noun"
        },
        {
          "text": "A stupid, clownish fellow. [Obs.] B. Jonson.",
          "partOfSpeech": "noun"
        }
      ],

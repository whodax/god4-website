    "energeticenergetical": {
      "word": "ENERGETIC; ENERGETICAL",
      "definitions": [
        {
          "text": "Having energy or energies; possessing a capacity for vigorous action or for exerting force; active. \"A Being eternally energetic.\" Grew.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Exhibiting energy; operating with force, vigor, and effect; forcible; powerful; efficacious; as, energetic measures; energetic laws.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "energetics": {
      "word": "ENERGETICS",
      "definitions": [
        {
          "text": "That branch of science which treats of the laws governing the physical or mechanical, in distinction from the vital, forces, and which comprehends the consideration and general investigation of the whole range of the forces concerned in physical phenomena. [R.]",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "energicenergical": {
      "word": "ENERGIC; ENERGICAL",
      "definitions": [
        {
          "text": "In a state of action; acting; operating.",
          "partOfSpeech": "adjective"

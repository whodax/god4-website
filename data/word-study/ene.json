    "enervate": {
      "word": "ENERVATE",
      "definitions": [
        {
          "text": "To deprive of nerve, force, strength, or courage; to render feeble or impotent; to make effeminate; to impair the moral powers of. A man . . . enervated by licentiousness. Macaulay. And rhyme began t' enervate poetry. Dryden.",
          "partOfSpeech": "verb"
        },
        {
          "text": "Weakened; weak; without strength of force. Pope.",
          "partOfSpeech": "adjective"
        }
      ],

    "energize": {
      "word": "ENERGIZE",
      "definitions": [
        {
          "text": "To use strength in action; to act or operate with force or vigor; to act in producing an effect. Of all men it is true that they feel and energize first, they reflect and judge afterwards. J. C. Shairp.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To give strength or force to; to make active; to alacrify; as, to energize the will.",
          "partOfSpeech": "verb"
        }
      ],

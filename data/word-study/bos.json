    "bossage": {
      "word": "BOSSAGE",
      "definitions": [
        {
          "text": "(Arch.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A stone in a building, left rough and projecting, to be afterward carved into shape. Gwilt.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Arch.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "Rustic work, consisting of stones which seem to advance beyond the level of the building, by reason of indentures or channels left in the joinings. Gwilt.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

    "dichotomize": {
      "word": "DICHOTOMIZE",
      "definitions": [
        {
          "text": "To cut into two parts; to part into two divisions; to divide into pairs; to bisect. [R.] The apostolical benediction dichotomizes all good things into grace and peace. Bp. Hall.",
          "partOfSpeech": "verb"
        },
        {
          "text": "(Astron.)",
          "partOfSpeech": "verb"
        },
        {
          "text": "To exhibit as a half disk. See Dichotomy,",
          "partOfSpeech": "verb"
        },
        {
          "text": "\"[The moon] was dichotomized.\" Whewell.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To separate into two parts; to branch dichotomously; to become dichotomous.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "dichotomous": {
      "word": "DICHOTOMOUS",
      "definitions": [

    "bequest": {
      "word": "BEQUEST",
      "definitions": [
        {
          "text": "The act of bequeathing or leaving by will; as, a bequest of property by A. to B.",
          "partOfSpeech": "noun"
        },
        {
          "text": "That which is left by will, esp. personal property; a legacy; also, a gift.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To bequeath, or leave as a legacy. [Obs.] \"All I have to bequest.\" Gascoigne.",
          "partOfSpeech": "verb"
        }

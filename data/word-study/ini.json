    "iniquity": {
      "word": "INIQUITY",
      "definitions": [
        {
          "text": "Absence of, or deviation from, just dealing; want of rectitude or uprightness; gross injustice; unrighteousness; wickedness; as, the iniquity of bribery; the iniquity of an unjust judge. Till the world from his perfection fell Into all filth and foul iniquity. Spenser.",
          "partOfSpeech": "noun"
        },
        {
          "text": "An iniquitous act or thing; a deed of injustice o Milton. Your iniquities have separated between you and your God. Is. lix. 2.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A character or personification in the old English moralities, or moral dramas, having the name sometimes of one vice and sometimes of another. See Vice. Acts old Iniquity, and in the fit Of miming gets the opinion of a wit. B. Jonson.",
          "partOfSpeech": "noun"
        }
      ],

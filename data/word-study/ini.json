    "iniquitous": {
      "word": "INIQUITOUS",
      "definitions": [
        {
          "text": "Characterized by iniquity; unjust; wicked; as, an iniquitous bargain; an iniquitous proceeding. Demagogues . . . bribed to this iniquitous service. Burke. Iniquitous is stronger, denoting a violation of the rights of others, usually by fraud or circumvention. Nefarious is still stronger, implying a breach of the most sacred obligations, and points more directly to the intrinsic badness of the deed.",
          "partOfSpeech": "adjective"
        }

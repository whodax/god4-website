    "haft": {
      "word": "HAFT",
      "definitions": [
        {
          "text": "A handle; that part of an instrument or vessel taken into the hand, and by which it is held and used; -- said chiefly of a knife, sword, or dagger; the hilt. This brandish'dagger I'll bury to the haft in her fair breast. Dryden.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A dwelling. [Scot.] Jamieson.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To set in, or furnish with, a haft; as, to haft a dagger.",

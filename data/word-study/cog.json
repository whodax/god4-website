    "cognate": {
      "word": "COGNATE",
      "definitions": [
        {
          "text": "Allied by blood; kindred by birth; specifically (Law), related on the mother's side.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Of the same or a similar nature; of the same family; proceeding from the same stock or root; allied; kindred; as, a cognate language.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Law)",
          "partOfSpeech": "noun"
        },
        {
          "text": "One who is related to another on the female side. Wharton.",
          "partOfSpeech": "noun"
        },
        {
          "text": "One of a number of things allied in origin or nature; as, certain letters are cognates.",
          "partOfSpeech": "noun"
        }
      ],

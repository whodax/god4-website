    "cognation": {
      "word": "COGNATION",
      "definitions": [
        {
          "text": "Relationship by blood; descent from the same original; kindred. As by our cognation to the body of the first Adam. Jer. Taylor.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Participation of the same nature. Sir T. Browne. A like temper and cognation. Sir K. Digby.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Law)",
          "partOfSpeech": "noun"
        },
        {
          "text": "That tie of consanguinity which exists between persons descended from the same mother; -- used in distinction from agnation.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

    "cavalier": {
      "word": "CAVALIER",
      "definitions": [
        {
          "text": "A military man serving on horseback; a knight.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A gay, sprightly, military man; hence, a gallant.",
          "partOfSpeech": "noun"
        },
        {
          "text": "One of the court party in the time of king Charles L. as contrasted with a Roundhead or an adherent of Parliament. Clarendon.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Fort.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A work of more that ordinary heigh, rising from the level ground of a bastion, etc., and overlooking surrounding parts.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Gay; easy; offhand; frank. The plodding, persevering scupulous accuracy of the one, and the easy, cavalier, verbal fluency of the other, from a complete contrast. Hazlitt.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "High-spirited. [Obs.] \"The people are naturally not valiant, and not much cavalier.\" Suckling.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Supercilious; haughty; disdainful; curt; brusque.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Of or pertaining to the party of King Charles I. \"An old Cavalier family.\" Beaconsfleld.",
          "partOfSpeech": "adjective"
        }
      ],

    "enmity": {
      "word": "ENMITY",
      "definitions": [
        {
          "text": "The quality of being an enemy; hostile or unfriendly disposition. No ground of enmity between us known. Milton.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A state of opposition; hostility. The friendship of the world is enmity with God. James iv. 4. animosity; ill will; malice; malevolence. See Animosity, Rancor.",
          "partOfSpeech": "noun"
        }
      ],

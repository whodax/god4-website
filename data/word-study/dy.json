    "dyad": {
      "word": "DYAD",
      "definitions": [
        {
          "text": "Two units treated as one; a couple; a pair.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Chem.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "An element, atom, or radical having a valence or combining power of two.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Having a valence or combining power of two; capable of being substituted for, combined with, or replaced by, two atoms of hydrogen; as, oxygen and calcium are dyad elements. See Valence.",
          "partOfSpeech": "adjective"
        }
      ],

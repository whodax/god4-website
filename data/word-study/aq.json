    "aqueous": {
      "word": "AQUEOUS",
      "definitions": [
        {
          "text": "Partaking of the nature of water, or abounding with it; watery. The aqueous vapor of the air. Tyndall.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Made from, or by means of, water. An aqueous deposit. Dana. Aqueous extract, an extract obtained from a vegetable substance by steeping it in water. occupying the space between the crystalline lens and the cornea. (See Eye.) -- Aqueous rocks (Geol.), those which are deposited from water and lie in strata, as opposed to volcanic rocks, which are of igneous origin; -- called also sedimentary rocks.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },

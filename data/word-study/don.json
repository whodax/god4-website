    "donatist": {
      "word": "DONATIST",
      "definitions": [
        {
          "text": "A follower of Donatus, the leader of a body of North African schismatics and purists, who greatly disturbed the church in the 4th century. They claimed to be the true church.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "donatistic": {
      "word": "DONATISTIC",

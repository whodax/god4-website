    "donative": {
      "word": "DONATIVE",
      "definitions": [
        {
          "text": "A gift; a largess; a gratuity; a present. \"The Romans were entertained with shows and donatives.\" Dryden.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Eccl. Law)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A benefice conferred on a person by the founder or patron, without either presentation or institution by the ordinary, or induction by his orders. See the Note under Benefice, n., 3.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Vested or vesting by donation; as, a donative advowson. Blackstone.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "donator": {
      "word": "DONATOR",

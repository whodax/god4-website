    "fid": {
      "word": "FID",
      "definitions": [
        {
          "text": "(Naut.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A square bar of wood or iron, used to support the topmast, being passed through a hole or mortise at its heel, and resting on the trestle trees.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A wooden or metal bar or pin, used to support or steady anything.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A pin of hard wood, tapering to a point, used to open the strands of a rope in splicing. the others, and stand upon a flat base). An iron implement for this purpose is called a marline spike.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Mil.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A block of wood used in mounting and dismounting heavy guns.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

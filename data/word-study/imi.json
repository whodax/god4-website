    "imitative": {
      "word": "IMITATIVE",
      "definitions": [
        {
          "text": "Inclined to imitate, copy, or follow; imitating; exhibiting some of the qualities or characteristics of a pattern or model; dependent on example; not original; as, man is an imitative being; painting is an imitative art.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Formed after a model, pattern, or original. This temple, less in form, with equal grace, Was imitative of the first in Thrace. Dryden.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Nat. Hist.)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Designed to imitate another species of animal, or a plant, or inanimate object, for some useful purpose, such as protection from enemies; having resamblance to something else; as, imitative colors; imitative habits; dendritic and mammillary forms of minerals are imitative.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "A verb expressive of imitation or resemblance. [R.]",
          "partOfSpeech": "noun"
        }
      ],

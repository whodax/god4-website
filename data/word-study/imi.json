  "entries": {
    "imide": {
      "word": "IMIDE",
      "definitions": [
        {
          "text": "A compound with, or derivative of, the imido group; specif., a compound of one or more acid radicals with the imido group, or with a monamine; hence, also, a derivative of ammonia, in which two atoms of hydrogen have been replaced by divalent basic or acid radicals; -- frequently used as a combining form; as, succinimide.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "imido": {
      "word": "IMIDO",
      "definitions": [
        {
          "text": "Pertaining to, containing, or combined with, the radical NH, which is called the imido group. Imido acid, an organic acid, consisting of one or more acid radicals so united with the imido group that it contains replaceable acid hydrogen, and plays the part of an acid; as, uric acid, succinimide, etc., are imido acids.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "imitability": {
      "word": "IMITABILITY",
      "definitions": [
        {
          "text": "The quality of being imitable. Norris.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "imitable": {
      "word": "IMITABLE",
      "definitions": [
        {
          "text": "Capble of being imitated or copied. The characters of man placed in lower stations of life are more usefull, as being imitable by great numbers. Atterbury.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Worthy of imitation; as, imitable character or qualities. Sir W. Raleigh.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "imitableness": {
      "word": "IMITABLENESS",
      "definitions": [
        {
          "text": "The state or quality of being imitable; worthness of imitation.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "imitancy": {
      "word": "IMITANCY",
      "definitions": [
        {
          "text": "Tendency to imitation. [R.] Carlyle.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "imitate": {
      "word": "IMITATE",
      "definitions": [
        {
          "text": "To follow as a pattern, model, or example; to copy or strive to copy, in acts, manners etc. Despise wealth and imitate a dog. Cowlay.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To produce a semblance or likeness of, in form, character, color, qualities, conduct, manners, and the like; to counterfeit; to copy. A place picked out by choice of best alive The Nature's work by art can imitate. Spenser. This hand appeared a shining sword to weild, And that sustained an imitated shield. Dryden.",
          "partOfSpeech": "verb"
        },
        {
          "text": "(Biol.)",
          "partOfSpeech": "verb"
        },
        {
          "text": "To resemble (another species of animal, or a plant, or inanimate object) in form, color, ornamentation, or instinctive habits, so as to derive an advantage thereby; sa, when a harmless snake imitates a venomous one in color and manner, or when an odorless insect imitates, in color, one having secretion offensive to birds.",
          "partOfSpeech": "verb"
        }
      ],

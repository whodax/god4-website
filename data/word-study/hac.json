    "hackberry": {
      "word": "HACKBERRY",
      "definitions": [
        {
          "text": "A genus of trees (Celtis) related to the elm, but bearing drupes with scanty, but often edible, pulp. C. occidentalis is common in the Eastern United States. Gray.",
          "partOfSpeech": "noun"

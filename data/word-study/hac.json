    "hackle": {
      "word": "HACKLE",
      "definitions": [
        {
          "text": "A comb for dressing flax, raw silk, etc.; a hatchel.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Any flimsy substance unspun, as raw silk.",
          "partOfSpeech": "noun"
        },
        {
          "text": "One of the peculiar, long, narrow feathers on the neck of fowls, most noticeable on the cock, -- often used in making artificial flies; hence, any feather so used.",
          "partOfSpeech": "noun"
        },
        {
          "text": "An artificial fly for angling, made of feathers.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To separate, as the coarse part of flax or hemp from the fine, by drawing it through the teeth of a hackle or hatchel.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To tear asunder; to break in pieces. The other divisions of the kingdom being hackled and torn to pieces. Burke.",
          "partOfSpeech": "verb"
        }
      ],

    "hackmatack": {
      "word": "HACKMATACK",
      "definitions": [
        {
          "text": "The American larch (Larix Americana), a coniferous tree with slender deciduous leaves; also, its heavy, close-grained timber. Called also tamarack.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "hackney": {
      "word": "HACKNEY",
      "definitions": [
        {
          "text": "A horse for riding or driving; a nag; a pony. Chaucer.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A horse or pony kept for hire.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A carriage kept for hire; a hack; a hackney coach.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A hired drudge; a hireling; a prostitute.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Let out for hire; devoted to common use; hence, much used; trite; mean; as, hackney coaches; hackney authors. \"Hackney tongue.\" Roscommon.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "To devote to common or frequent use, as a horse or carriage; to wear out in common service; to make trite or commonplace; as, a hackneyed metaphor or quotation. Had I lavish of my presence been, So common-hackneyed in the eyes of men. Shak.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To carry in a hackney coach. Cowper.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "hackneyman": {
      "word": "HACKNEYMAN",
      "definitions": [

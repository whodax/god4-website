    "ingeminate": {
      "word": "INGEMINATE",
      "definitions": [
        {
          "text": "Redoubled; repeated. Jer. Taylor.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "To redouble or repeat; to reiterate. Clarendon. . . . She yet ingeminates The last of sounds, and what she hears relates. Sandys.",

    "fake": {
      "word": "FAKE",
      "definitions": [
        {
          "text": "One of the circles or windings of a cable or hawser, as it lies in a coil; a single turn or coil.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To coil (a rope, line, or hawser), by winding alternately in opposite directions, in layers usually of zigzag or figure of eight form,, to prevent twisting when running out. Faking box, a box in which a long rope is faked; used in the life-saving service for a line attached to a shot.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To cheat; to swindle; to steal; to rob.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To make; to construct; to do.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To manipulate fraudulently, so as to make an object appear better or other than it really is; as, to fake a bulldog, by burning his upper lip and thus artificially shortening it.",
          "partOfSpeech": "verb"
        },
        {
          "text": "A trick; a swindle. [Slang]",
          "partOfSpeech": "noun"
        }
      ],

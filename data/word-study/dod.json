    "dodder": {
      "word": "DODDER",
      "definitions": [
        {
          "text": "A plant of the genus Cuscuta. It is a leafless parasitical vine with yellowish threadlike stems. It attaches itself to some other plant, as to flax, goldenrod, etc., and decaying at the root. is nourished by the plant that supports it.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To shake, tremble, or totter. \"The doddering mast.\" Thomson.",
          "partOfSpeech": "verb"
        }
      ],

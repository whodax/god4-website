    "hatchet": {
      "word": "HATCHET",
      "definitions": [
        {
          "text": "A small ax with a short handle, to be used with one hand.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Specifically, a tomahawk. Buried was the bloody hatchet. Longfellow. Hatchet face, a thin, sharp face, like the edge of a hatchet; hence: Hatchet-faced, sharp-visaged. Dryden. phrases are derived from the practice of the American Indians.",
          "partOfSpeech": "noun"
        }

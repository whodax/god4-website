    "hatchel": {
      "word": "HATCHEL",
      "definitions": [
        {
          "text": "An instrument with long iron teeth set in a board, for cleansing flax or hemp from the tow, hards, or coarse part; a kind of large comb; -- called also hackle and heckle.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To draw through the teeth of a hatchel, as flax or hemp, so as to separate the coarse and refuse parts from the fine, fibrous parts.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To tease; to worry; to torment. [Colloq.]",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },

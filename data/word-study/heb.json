    "hebraic": {
      "word": "HEBRAIC",
      "definitions": [
        {
          "text": "Of or pertaining to the Hebrews, or to the language of the Hebrews.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "hebraically": {
      "word": "HEBRAICALLY",
      "definitions": [
        {
          "text": "After the manner of the Hebrews or of the Hebrew language.",
          "partOfSpeech": "adverb"
        }
      ],
      "relatedWords": []
    },
    "hebraism": {
      "word": "HEBRAISM",
      "definitions": [
        {
          "text": "A Hebrew idiom or custom; a peculiar expression or manner of speaking in the Hebrew language. Addison.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The type of character of the Hebrews. The governing idea of Hebraism is strictness of conscience. M. Arnold.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "hebraist": {
      "word": "HEBRAIST",
      "definitions": [
        {
          "text": "One versed in the Hebrew language and learning.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "hebraistic": {
      "word": "HEBRAISTIC",
      "definitions": [
        {
          "text": "Pertaining to, or resembling, the Hebrew language or idiom.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "hebraistically": {
      "word": "HEBRAISTICALLY",
      "definitions": [
        {
          "text": "In a Hebraistic sense or form. Which is Hebraistically used in the New Testament. Kitto.",
          "partOfSpeech": "adverb"
        }
      ],
      "relatedWords": []
    },
    "hebraize": {
      "word": "HEBRAIZE",
      "definitions": [
        {
          "text": "To convert into the Hebrew idiom; to make Hebrew or Hebraistic. J. R. Smith.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To speak Hebrew, or to conform to the Hebrew idiom, or to Hebrew customs.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "hebrew": {
      "word": "HEBREW",
      "definitions": [
        {
          "text": "An appellative of Abraham or of one of his descendants, esp. in the line of Jacob; an Israelite; a Jew. There came one that had escaped and told Abram the Hebrew. Gen. xiv. 13.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The language of the Hebrews; -- one of the Semitic family of languages.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Of or pertaining to the Hebrews; as, the Hebrew language or rites.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },

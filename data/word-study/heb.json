    "hebdomad": {
      "word": "HEBDOMAD",
      "definitions": [
        {
          "text": "A week; a period of seven days. [R.] Sir T. Browne.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "hebdomadal": {
      "word": "HEBDOMADAL; HEBDOMADARY",
      "definitions": [
        {
          "text": "Consisting of seven days, or occurring at intervals of seven days; weekly.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "hebdomadally": {
      "word": "HEBDOMADALLY",
      "definitions": [
        {
          "text": "In periods of seven days; weekly. Lowell.",
          "partOfSpeech": "adverb"
        }
      ],
      "relatedWords": []
    },
    "hebdomadary": {
      "word": "HEBDOMADAL; HEBDOMADARY",
      "definitions": [
        {
          "text": "Consisting of seven days, or occurring at intervals of seven days; weekly.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "A member of a chapter or convent, whose week it is to officiate in the choir, and perform other services, which, on extraordinary occasions, are performed by the superiors.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "hebdomatical": {
      "word": "HEBDOMATICAL",
      "definitions": [
        {
          "text": "Weekly; hebdomadal. [Obs.]",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "hebe": {
      "word": "HEBE",
      "definitions": [
        {
          "text": "(Class. Myth.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "The goddess of youth, daughter of Jupiter and Juno. She was believed to have the power of restoring youth and beauty to those who had lost them.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Zoöl.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "An African ape; the hamadryas.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

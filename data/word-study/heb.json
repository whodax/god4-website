    "hebetate": {
      "word": "HEBETATE",
      "definitions": [
        {
          "text": "To render obtuse; to dull; to blunt; to stupefy; as, to hebetate the intellectual faculties. Southey",
          "partOfSpeech": "verb"
        },
        {
          "text": "Obtuse; dull.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Bot.)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Having a dull or blunt and soft point. Gray.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "hebetation": {
      "word": "HEBETATION",
      "definitions": [
        {
          "text": "The act of making blunt, dull, or stupid.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The state of being blunted or dulled.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

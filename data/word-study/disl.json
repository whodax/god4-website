    "dislocation": {
      "word": "DISLOCATION",
      "definitions": [
        {
          "text": "The act of displacing, or the state of being displaced. T. Burnet.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Geol.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "The displacement of parts of rocks or portions of strata from the situation which they originally occupied. Slips, faults, and the like, are dislocations.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Surg.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "The act of dislocating, or putting out of joint; also, the condition of being thus displaced.",
          "partOfSpeech": "noun"

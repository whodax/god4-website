    "dislodge": {
      "word": "DISLODGE",
      "definitions": [
        {
          "text": "To drive from a lodge or place of rest; to remove from a place of quiet or repose; as, shells resting in the sea at a considerate depth are not dislodged by storms.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To drive out from a place of hiding or defense; as, to dislodge a deer, or an enemy. The Volscians are dislodg'd. Shak.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To go from a place of rest. [R.] Where Light and Darkness in perpetual round Lodge and dislodge by turns. Milton.",
          "partOfSpeech": "verb"
        },
        {
          "text": "Dwelling apart; separation. [R.]",
          "partOfSpeech": "noun"
        }
      ],

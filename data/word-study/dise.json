    "disesteem": {
      "word": "DISESTEEM",
      "definitions": [
        {
          "text": "Want of esteem; low estimation, inclining to dislike; disfavor; disrepute. Disesteem and contempt of the public affairs. Milton.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To feel an absence of esteem for; to regard with disfavor or slight contempt; to slight. But if this sacred gift you disesteem. Denham. Qualities which society does not disesteem. Ld. Lytton.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To deprive of esteem; to bring into disrepute; to cause to be regarded with disfavor. [Obs.] What fables have you vexed, what truth redeemed, Antiquities searched, opinions disesteemed B. Jonson.",
          "partOfSpeech": "verb"
        }

    "gypsy": {
      "word": "GYPSY",
      "definitions": [
        {
          "text": "One of a vagabond race, whose tribes, coming originally from India, entered Europe in 14th or 15th centry, and are now scattered over Turkey, Russia, Hungary, Spain, England, etc., living by theft, fortune telling, horsejockeying, tinkering, etc. Cf. Bohemian, Romany. Like a right gypsy, hath, at fast and loose, Beguiled me to the very heart of loss. Shak.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The language used by the gypsies. Shak.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A dark-complexioned person. Shak.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A cunning or crafty person [Collog.] Prior.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Pertaining to, or suitable for, gypsies. Gypsy hat, a woman's or child's broad-brimmed hat, usually of straw or felt. by a ratchet and pawl through a lever working up and down.",
          "partOfSpeech": ""
        },
        {
          "text": "To play the gypsy; to picnic in the woods. Mostly. Gyp\"sy*ing, vb. n.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "gypsyism": {
      "word": "GYPSYISM",
      "definitions": [
        {
          "text": "The arts and practices or habits of gypsies; deception; cheating; flattery.",

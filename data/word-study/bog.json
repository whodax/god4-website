    "boggle": {
      "word": "BOGGLE",
      "definitions": [
        {
          "text": "To stop or hesitate as if suddenly frightened, or in doubt, or impeded by unforeseen difficulties; to take alarm; to exhibit hesitancy and indecision. We start and boggle at every unusual appearance. Glanvill. Boggling at nothing which serveth their purpose. Barrow.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To do anything awkwardly or unskillfully.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To play fast and loose; to dissemble. Howell.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To embarrass with difficulties; to make a bungle or botch of. [Local, U. S.]",
          "partOfSpeech": "verb"
        }
      ],

    "beech": {
      "word": "BEECH",
      "definitions": [
        {
          "text": "A tree of the genus Fagus. foliage, and bears an edible triangular nut, of which swine are fond. The Fagus sylvatica is the European species, and the F. ferruginea that of America. Beech drops (Bot.), a parasitic plant which grows on the roots of beeches (Epiphegus Americana). trees, in autumn. colored, shining leaves.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

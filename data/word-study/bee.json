    "beebread": {
      "word": "BEEBREAD",
      "definitions": [
        {
          "text": "A brown, bitter substance found in some of the cells of honeycomb. It is made chiefly from the pollen of flowers, which is collected by bees as food for their young.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []

    "beefeater": {
      "word": "BEEFEATER",
      "definitions": [
        {
          "text": "One who eats beef; hence, a large, fleshy person.",
          "partOfSpeech": "noun"
        },
        {
          "text": "One of the yeomen of the guard, in England.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Zoöl.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "An African bird of the genus Buphaga, which feeds on the larvæ of botflies hatched under the skin of oxen, antelopes, etc. Two species are known.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

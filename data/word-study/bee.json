    "beer": {
      "word": "BEER",
      "definitions": [
        {
          "text": "A fermented liquor made from any malted grain, but commonly from barley malt, with hops or some other substance to impart a bitter flavor. stout, lager beer, according to its strength, or other qualities. See Ale.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A fermented extract of the roots and other parts of various plants, as spruce, ginger, sassafras, etc. Small beer, weak beer; (fig.) insignificant matters. \"To suckle fools, and chronicle small beer.\" Shak.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

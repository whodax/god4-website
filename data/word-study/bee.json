    "beet": {
      "word": "BEET",
      "definitions": [
        {
          "text": "(Bot.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A biennial plant of the genus Beta, which produces an edible root the first year and seed the second year.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The root of plants of the genus Beta, different species and varieties of which are used for the table, for feeding stock, or in making sugar. The Old \"white beet\", cultivated for its edible leafstalks, is a distinct species (Beta Cicla).",

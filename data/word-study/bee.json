    "beef": {
      "word": "BEEF",
      "definitions": [
        {
          "text": "An animal of the genus Bos, especially the common species, B. taurus, including the bull, cow, and ox, in their full grown state; esp., an ox or cow fattened for food. beeves (.] A herd of beeves, fair oxen and fair kine. Milton.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The flesh of an ox, or cow, or of any adult bovine animal, when slaughtered for food. Shak.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Applied colloquially to human flesh.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Of, pertaining to, or resembling, beef. Beef tea, essence of beef, or strong beef broth.",
          "partOfSpeech": "adjective"
        }
      ],

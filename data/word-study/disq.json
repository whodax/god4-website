    "disquietal": {
      "word": "DISQUIETAL",
      "definitions": [
        {
          "text": "The act of disquieting; a state of disquiet. [Obs.] [It] roars and strives 'gainst its disquietal. Dr. H. More.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "disquieter": {
      "word": "DISQUIETER",
      "definitions": [
        {
          "text": "One who, or that which, disquiets, or makes uneasy; a disturber.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "disquietful": {
      "word": "DISQUIETFUL",
      "definitions": [
        {
          "text": "Producing inquietude or uneasiness. [R.] Barrow.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "disquietive": {
      "word": "DISQUIETIVE",
      "definitions": [
        {
          "text": "Tending to disquiet. [R.]",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "disquietly": {
      "word": "DISQUIETLY",
      "definitions": [
        {
          "text": "In a disquiet manner; uneasily; as, he rested disquietly that night. [R.] Wiseman.",
          "partOfSpeech": "adverb"
        }
      ],
      "relatedWords": []
    },
    "disquietment": {
      "word": "DISQUIETMENT",
      "definitions": [
        {
          "text": "State of being disquieted; uneasiness; harassment. [R.] Hopkins.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "disquietness": {
      "word": "DISQUIETNESS",
      "definitions": [
        {
          "text": "Disturbance of quiet in body or mind; restlessness; uneasiness. Hooker.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "disquietous": {
      "word": "DISQUIETOUS",
      "definitions": [
        {
          "text": "Causing uneasiness. [R.] So distasteful and disquietous to a number of men. Milton.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "disquiettude": {
      "word": "DISQUIETTUDE",
      "definitions": [
        {
          "text": "Want of peace or tranquility; uneasiness; disturbance; agitation; anxiety. Fears and disquietude, and unavoidable anxieties of mind. Abp. Sharp.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "disquisition": {
      "word": "DISQUISITION",
      "definitions": [
        {
          "text": "A formal or systematic inquiry into, or discussion of, any subject; a full examination or investigation of a matter, with the arguments and facts bearing upon it; elaborate essay; dissertation. For accurate research or grave disquisition he was not well qualified. Macaulay.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "disquisitional": {
      "word": "DISQUISITIONAL",
      "definitions": [
        {
          "text": "Pertaining to disquisition; of the nature of disquisition.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "disquisitionary": {
      "word": "DISQUISITIONARY",
      "definitions": [
        {
          "text": "Pertaining to disquisition; disquisitional.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "disquisitive": {
      "word": "DISQUISITIVE",
      "definitions": [
        {
          "text": "Relating to disquisition; fond discussion or investigation; examining; inquisitive.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "disquisitorial": {
      "word": "DISQUISITORIAL",
      "definitions": [
        {
          "text": "Disquisitory.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "disquisitory": {
      "word": "DISQUISITORY",
      "definitions": [
        {
          "text": "Of or pertaining to disquisition; disquisitive. Ed. Rev.",

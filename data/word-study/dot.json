    "dot": {
      "word": "DOT",
      "definitions": [
        {
          "text": "A marriage portion; dowry. [Louisiana]",
          "partOfSpeech": "noun"
        },
        {
          "text": "A small point or spot, made with a pen or other pointed instrument; a speck, or small mark.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Anything small and like a speck comparatively; a small portion or specimen; as, a dot of a child.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To mark with dots or small spots; as, to dot a line.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To mark or diversify with small detached objects; as, a landscape dotted with cottages.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To make dots or specks.",
          "partOfSpeech": "verb"
        }
      ],

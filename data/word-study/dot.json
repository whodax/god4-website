    "dotage": {
      "word": "DOTAGE",
      "definitions": [
        {
          "text": "Feebleness or imbecility of understanding or mind, particularly in old age; the childishness of old age; senility; as, a venerable man, now in his dotage. Capable of distinguishing between the infancy and the dotage of Greek literature. Macaulay.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Foolish utterance; drivel. The sapless dotages of old Paris and Salamanca. Milton.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Excessive fondness; weak and foolish affection. The dotage of the nation on presbytery. Bp. Burnet.",
          "partOfSpeech": "noun"
        }
      ],

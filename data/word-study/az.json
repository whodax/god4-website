    "azure": {
      "word": "AZURE",
      "definitions": [
        {
          "text": "Sky-blue; resembling the clear blue color of the unclouded sky; cerulean; also, cloudless. Azure stone (Min.), the lapis lazuli; also, the lazulite.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "The lapis lazuli. [Obs.]",
          "partOfSpeech": "noun"
        },
        {
          "text": "The clear blue color of the sky; also, a pigment or dye of this color. \"In robes of azure.\" Wordsworth.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The blue vault above; the unclouded sky. Not like those steps On heaven's azure. Milton.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Her.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A blue color, represented in engraving by horizontal parallel lines.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To color blue.",
          "partOfSpeech": "verb"
        }
      ],

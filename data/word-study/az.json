    "aztec": {
      "word": "AZTEC",
      "definitions": [
        {
          "text": "Of or relating to one of the early races in Mexico that inhabited the great plateau of that country at the time of the Spanish conquest in 1519.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "One of the Aztec race or people.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []

    "fico": {
      "word": "FICO",
      "definitions": [
        {
          "text": "A fig; an insignificant trifle, no more than the snap of one's thumb; a sign of contempt made by the fingers, expressing. A fig for you. Steal! foh, a fico for the phrase. Shak.",
          "partOfSpeech": "noun"
        }
      ],

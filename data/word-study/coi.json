    "coincidence": {
      "word": "COINCIDENCE",
      "definitions": [
        {
          "text": "The condition of occupying the same place in space; as, the coincidence of circles, surfaces, etc. Bentley.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The condition or fact of happening at the same time; as, the coincidence of the deaths of John Adams and Thomas Jefferson.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Exact correspondence in nature, character, result, circumstances, etc.; concurrence; agreement. The very concurrence and coincidence of ao many evidences . . . carries a great weight. Sir M. Hale. Those who discourse . . . of the nature of truth . . . affirm a perfect coincidence between truth and goodness. South.",
          "partOfSpeech": "noun"
        }
      ],

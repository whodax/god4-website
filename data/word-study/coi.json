    "coinage": {
      "word": "COINAGE",
      "definitions": [
        {
          "text": "The act or process of converting metal into money. The care of the coinage was committed to the inferior magistrates. Arbuthnot.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Coins; the aggregate coin of a time or place.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The cost or expense of coining money.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The act or process of fabricating or inventing; formation; fabrication; that which is fabricated or forged. \"Unnecessary coinage . . . of words.\" Dryden. This is the very coinage of your brain. Shak.",
          "partOfSpeech": "noun"

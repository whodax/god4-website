    "coin": {
      "word": "COIN",
      "definitions": [
        {
          "text": "To make of a definite fineness, and convert into coins, as a mass of metal; to mint; to manufacture; as, to coin silver dollars; to coin a medal.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To make or fabricate; to invent; to originate; as, to coin a word. Some tale, some new pretense, he daily coined, To soothe his sister and delude her mind. Dryden.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To acquire rapidly, as money; to make. Tenants cannot coin rent just at quarter day. Locke.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To manufacture counterfeit money. They cannot touch me for coining. Shak.",
          "partOfSpeech": "verb"
        }
      ],

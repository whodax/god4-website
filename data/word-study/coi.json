    "coincident": {
      "word": "COINCIDENT",
      "definitions": [
        {
          "text": "Having coincidence; occupying the same place; contemporaneous; concurrent; -- followed by with. Christianity teaches nothing but what is perfectly suitable to, and coincident with, the ruling principles of a virtuous and well- inclined man. South.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "One of two or more coincident events; a coincidence. [R.] \"Coincidents and accidents.\" Froude.",
          "partOfSpeech": "noun"
        }

    "coincide": {
      "word": "COINCIDE",
      "definitions": [
        {
          "text": "To occupy the same place in space, as two equal triangles, when placed one on the other. If the equator and the ecliptic had coincided, it would have rendered the annual revoluton of the earth useless. Cheyne.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To occur at the same time; to be contemporaneous; as, the fall of Granada coincided with the discovery of America.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To correspond exactly; to agree; to concur; as, our aims coincide. The rules of right jugdment and of good ratiocination often coincide with each other. Watts.",
          "partOfSpeech": "verb"
        }
      ],

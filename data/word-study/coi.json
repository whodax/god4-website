    "coign": {
      "word": "COIGN",
      "definitions": [
        {
          "text": "A var. spelling of Coin, Quoin, a corner, wedge; -- chiefly used in the phrase coign of vantage, a position advantageous for action or observation. From some shielded nook or coign of vantage. The Century. The lithosphere would be depressed on four faces; . . . the four projecting coigns would stand up as continents. Nature.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "coigne": {
      "word": "COIGNE",
      "definitions": [
        {
          "text": "A quoin. See you yound coigne of the Capitol yon corner stone Shak.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "coignecoigny": {
      "word": "COIGNE; COIGNY",
      "definitions": [
        {
          "text": "The practice of quartering one's self as landlord on a tenant; a quartering of one's self on anybody. [Ireland] Spenser.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "coil": {
      "word": "COIL",
      "definitions": [
        {
          "text": "To wind cylindrically or spirally; as, to coil a rope when not in use; the snake coiled itself before springing.",
          "partOfSpeech": "transitive verb"
        },
        {
          "text": "To encircle and hold with, or as with, coils. [Obs. or R.] T. Edwards.",
          "partOfSpeech": "transitive verb"
        },
        {
          "text": "To wind itself cylindrically or spirally; to form a coil; to wind; -- often with about or around. You can see his flery serpents . . . Coiting, playing in the water. Longfellow.",
          "partOfSpeech": "verb"
        },
        {
          "text": "A ring, series of rings, or spiral, into which a rope, or other like thing, is wound. The wild grapevines that twisted their coils from trec to tree. W. Irving.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Fig.: Entanglement; toil; mesh; perplexity.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A series of connected pipes in rows or layers, as in a steam heating apparatus. Induction coil. (Elec.) See under Induction. from Ruhmkorff (, a prominent manufacturer of the apparatus.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A noise, tumult, bustle, or confusion. [Obs.] Shak.",
          "partOfSpeech": "noun"
        }
      ],

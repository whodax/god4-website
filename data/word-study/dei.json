    "deify": {
      "word": "DEIFY",
      "definitions": [
        {
          "text": "To make a god of; to exalt to the rank of a deity; to enroll among the deities; to apotheosize; as, Julius Cæsar was deified.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To praise or revere as a deity; to treat as an object of supreme regard; as, to deify money. He did again to extol and deify the pope. Bacon.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To render godlike. By our own spirits are we deified. Wordsworth.",
          "partOfSpeech": "verb"
        }
      ],

    "deicide": {
      "word": "DEICIDE",
      "definitions": [
        {
          "text": "The act of killing a being of a divine nature; particularly, the putting to death of Jesus Christ. [R.] Earth profaned, yet blessed, with deicide. Prior.",
          "partOfSpeech": "noun"
        },
        {
          "text": "One concerned in putting Christ to death.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "deictic": {
      "word": "DEICTIC",
      "definitions": [
        {
          "text": "Direct; proving directly; -- applied to reasoning, and opposed to elenchtic or refutative.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "deictically": {
      "word": "DEICTICALLY",
      "definitions": [
        {
          "text": "In a manner to show or point out; directly; absolutely; definitely. When Christ spake it deictically. Hammond.",
          "partOfSpeech": "adverb"
        }
      ],
      "relatedWords": []
    },

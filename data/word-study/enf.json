    "enforce": {
      "word": "ENFORCE",
      "definitions": [
        {
          "text": "To put force upon; to force; to constrain; to compel; as, to enforce obedience to commands. Inward joy enforced my heart to smile. Shak.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To make or gain by force; to obtain by force; as, to enforce a passage. \"Enforcing furious way.\" Spenser.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To put in motion or action by violence; to drive. As swift as stones Enforced from the old Assyrian slings. Shak.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To give force to; to strengthen; to invigorate; to urge with energy; as, to enforce arguments or requests. Enforcing sentiment of the thrust humanity. Burke.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To put in force; to cause to take effect; to give effect to; to execute with vigor; as, to enforce the laws.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To urge; to ply hard; to lay much stress upon. Enforce him with his envy to the people. Shak.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To attempt by force. [Obs.]",
          "partOfSpeech": "verb"
        },
        {
          "text": "To prove; to evince. [R.] Hooker.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To strengthen; to grow strong. [Obs.] Chaucer.",
          "partOfSpeech": "verb"
        },
        {
          "text": "Force; strength; power. [Obs.] A petty enterprise of small enforce. Milton.",
          "partOfSpeech": "noun"
        }
      ],

    "enfeoff": {
      "word": "ENFEOFF",
      "definitions": [
        {
          "text": "(Law)",
          "partOfSpeech": "verb"
        },
        {
          "text": "To give a feud, or right in land, to; to invest with a fief or fee; to invest (any one) with a freehold estate by the process of feoffment. Mozley & W.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To give in vassalage; to make subservient. [Obs.] [The king] enfeoffed himself to popularity. Shak.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },

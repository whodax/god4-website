    "enfilade": {
      "word": "ENFILADE",
      "definitions": [
        {
          "text": "A line or straight passage, or the position of that which lies in a straight line. [R.]",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Mil.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A firing in the direction of the length of a trench, or a line of parapet or troops, etc.; a raking fire.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To pierce, scour, or rake with shot in the direction of the length of, as a work, or a line of troops. Campbell.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },

    "enface": {
      "word": "ENFACE",
      "definitions": [
        {
          "text": "To write or print on the face of (a draft, bill, etc.); as, to enface drafts with memoranda.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To write or print (a memorandum, direction, or the like) on the face of a draft, bill, etc.; as, to enface the words \"Payable in Calcutta\" upon the face of a draft. Enfaced paper (Com.), Indian government securities the principal and interest of which are enfaced as payable in silver rupees. Dict. of Pol. Econ.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },

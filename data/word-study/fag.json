    "fagendfagend": {
      "word": "FAGEND; FAG-END",
      "definitions": [
        {
          "text": "An end of poorer quality, or in a spoiled condition, as the coarser end of a web of cloth, the untwisted end of a rope, ect.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The refuse or meaner part of anything. The fag-end of business. Collier.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "fagging": {
      "word": "FAGGING",
      "definitions": [
        {
          "text": "Laborious drudgery; esp., the acting as a drudge for another at an English school.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "faginoncfgothfahedsjoyandfrthesamerootasefairsrr": {
      "word": "faginon, cf. Goth. faheds joy; and fr. the same root as E. fair. Srr",
      "definitions": [
        {
          "text": "Well-pleased; glad; apt; wont; fond; inclined. Men and birds are fain of climbing high. Shak. To a busy man, temptation is fainto climb up together with his business. Jer. Taylor.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Satisfied; contented; also, constrained. Shak. The learned Castalio was fain to make trechers at Basle to keep himself from starving. Locke.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "fagot": {
      "word": "FAGOT",
      "definitions": [
        {
          "text": "A bundle of sticks, twigs, or small branches of trees, used for fuel, for raising batteries, filling ditches, or other purposes in fortification; a fascine. Shak.",
          "partOfSpeech": ""
        },
        {
          "text": "A bundle of pieces of wrought iron to be worked over into bars or other shapes by rolling or hammering at a welding heat; a pile.",
          "partOfSpeech": ""
        },
        {
          "text": "(Mus.)",
          "partOfSpeech": ""
        },
        {
          "text": "A bassoon. See Fagotto.",
          "partOfSpeech": ""
        },
        {
          "text": "A person hired to take the place of another at the muster of a company. [Eng.] Addison.",
          "partOfSpeech": ""
        },
        {
          "text": "An old shriveled woman. [Slang, Eng.] Fagot iron, iron, in bars or masses, manufactured from fagots. by being made a landholder, for party purposes. [Political cant, Eng.]",
          "partOfSpeech": ""
        },
        {
          "text": "To make a fagot of; to bind together in a fagot or bundle; also, to collect promiscuously. Dryden.",
          "partOfSpeech": ""
        }
      ],

    "fag": {
      "word": "FAG",
      "definitions": [
        {
          "text": "A knot or coarse part in cloth. [Obs.]",
          "partOfSpeech": ""
        },
        {
          "text": "To become weary; to tire. Creighton withheld his force till the Italian began to fag. G. Mackenzie.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To labor to wearness; to work hard; to drudge. Read, fag, and subdue this chapter. Coleridge.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To act as a fag, or perform menial services or drudgery, for another, as in some English schools. To fag out, to become untwisted or frayed, as the end of a rope, or the edge of canvas.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To tire by labor; to exhaust; as, he was almost fagged out.",
          "partOfSpeech": "verb"
        },
        {
          "text": "Anything that fatigues. [R.] It is such a fag, I came back tired to death. Miss Austen. Brain fag. (Med.) See Cerebropathy.",
          "partOfSpeech": "verb"
        }
      ],

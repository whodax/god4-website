    "dishonest": {
      "word": "DISHONEST",
      "definitions": [
        {
          "text": "Dishonorable; shameful; indecent; unchaste; lewd. [Obs.] Inglorious triumphs and dishonest scars. Pope. Speak no foul or dishonest words before them [the women]. Sir T. North.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Dishonored; disgraced; disfigured. [Obs.] Dishonest with lopped arms the youth appears, Spoiled of his nose and shortened of his ears. Dryden.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Wanting in honesty; void of integrity; faithless; disposed to cheat or defraud; not trustworthy; as, a dishonest man.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Characterized by fraud; indicating a want of probity; knavish; fraudulent; unjust. To get dishonest gain. Ezek. xxii. 27. The dishonest profits of men in office. Bancroft.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "To disgrace; to dishonor; as, to dishonest a maid. [Obs.] I will no longer dishonest my house. Chapman.",
          "partOfSpeech": "verb"
        }
      ],

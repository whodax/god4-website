    "disulphide": {
      "word": "DISULPHIDE",
      "definitions": [
        {
          "text": "A binary compound of sulphur containing two atoms of sulphur in each molecule; -- formerly called disulphuret. Cf. Bisulphide.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "disulphuret": {
      "word": "DISULPHURET",
      "definitions": [
        {
          "text": "See Disulphide.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "disulphuric": {
      "word": "DISULPHURIC",
      "definitions": [
        {
          "text": "Applied to an acid having in each molecule two atoms of sulphur in the higher state of oxidation. Disulphuric acid, a thick oily liquid, H2S2O7, called also Nordhausen acid (from Nordhausen in the Harts, where it was originally manufactured), fuming sulphuric acid, and especially pyrosulphuric acid. See under Pyrosulphuric.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "disuniform": {
      "word": "DISUNIFORM",
      "definitions": [
        {
          "text": "Not uniform. [Obs.]",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "disunion": {
      "word": "DISUNION",
      "definitions": [
        {
          "text": "The termination of union; separation; disjunction; as, the disunion of the body and the soul.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A breach of concord and its effect; alienation. Such a disunion between the two houses as might much clouClarendon.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The termination or disruption of the union of the States forming the United States. I have not accustomed myself to hang over the precipice of disunion. D. Webster.",
          "partOfSpeech": "noun"
        }
      ],

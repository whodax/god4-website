    "disusage": {
      "word": "DISUSAGE",
      "definitions": [
        {
          "text": "Gradual cessation of use or custom; neglect of use; disuse. [R.] Hooker.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "disuse": {
      "word": "DISUSE",
      "definitions": [
        {
          "text": "To cease to use; to discontinue the practice of.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To disaccustom; -- with to or from; as, disused to toil. \"Disuse me from . . . pain.\" Donne.",
          "partOfSpeech": "verb"
        },
        {
          "text": "Cessation of use, practice, or exercise; inusitation; desuetude; as, the limbs lose their strength by disuse. The disuse of the tongue in the only . . . remedy. Addison. Church discipline then fell into disuse. Southey.",
          "partOfSpeech": "noun"
        }
      ],

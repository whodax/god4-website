    "doze": {
      "word": "DOZE",
      "definitions": [
        {
          "text": "To slumber; to sleep lightly; to be in a dull or stupefied condition, as if half asleep; to be drowsy. If he happened to doze a little, the jolly cobbler waked him. L'Estrange.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To pass or spend in drowsiness; as, to doze away one's time.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To make dull; to stupefy. [Obs.] I was an hour . . . in casting up about twenty sums, being dozed with much work. Pepys. They left for a long time dozed and benumbed. South.",
          "partOfSpeech": "verb"
        },
        {
          "text": "A light sleep; a drowse. Tennyson.",
          "partOfSpeech": "noun"
        }
      ],

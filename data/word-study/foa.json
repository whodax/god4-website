    "foal": {
      "word": "FOAL",
      "definitions": [
        {
          "text": "The young of any animal of the Horse family (Equidæ); a colt; a filly. Foal teeth (Zoöl.), the first set of teeth of a horse. or she ass.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To bring forth (a colt); -- said of a mare or a she ass.",
          "partOfSpeech": "transitive verb"
        },
        {
          "text": "To bring forth young, as an animal of the horse kind.",
          "partOfSpeech": "intransitive verb"
        }

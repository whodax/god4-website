    "inoculate": {
      "word": "INOCULATE",
      "definitions": [
        {
          "text": "To bud; to insert, or graft, as the bud of a tree or plant in another tree or plant.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To insert a foreign bud into; as, to inoculate a tree.",
          "partOfSpeech": "verb"
        },
        {
          "text": "(Med.)",
          "partOfSpeech": "verb"
        },
        {
          "text": "To communicate a disease to ( a person ) by inserting infectious matter in the skin or flesh; as, to inoculate a person with the virus of smallpox,rabies, etc. See Vaccinate.",
          "partOfSpeech": "verb"
        },
        {
          "text": "Fig.: To introduce into the mind; -- used especially of harmful ideas or principles; to imbue; as, to inoculate one with treason or infidelity.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To graft by inserting buds.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To communicate disease by inoculation.",
          "partOfSpeech": "verb"
        }
      ],

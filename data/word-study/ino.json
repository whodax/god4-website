    "inofficious": {
      "word": "INOFFICIOUS",
      "definitions": [
        {
          "text": "Indifferent to obligation or duty. [Obs.] Thou drown'st thyself in inofficious sleep. B. Jonson.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Not officious; not civil or attentive. [Obs.] Jonhson.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Law)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Regardless of natural obligation; contrary to natural duty; unkind; -- commonly said of a testament made without regard to natural obligation, or by which a child is unjustly deprived of inheritance. \"The inofficious testament.\" Blackstone. \"An inofficious disposition of his fortune.\" Paley.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },

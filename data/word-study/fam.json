    "fame": {
      "word": "FAME",
      "definitions": [
        {
          "text": "Public report or rumor. The fame thereof was heard in Pharaoh's house. Gen. xlv. 16.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Report or opinion generally diffused; renown; public estimation; celebrity, either favorable or unfavorable; as, the fame of Washington. I find thou art no less than fame hath bruited. Shak.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To report widely or honorably. The field where thou art famed To have wrought such wonders. Milton.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To make famous or renowned. Those Hesperian gardens famed of old. Milton.",
          "partOfSpeech": "verb"
        }
      ],

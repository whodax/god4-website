    "fade": {
      "word": "FADE",
      "definitions": [
        {
          "text": "Weak; insipid; tasteless; commonplace. [R.] \"Passages that are somewhat fade.\" Jeffrey. His masculine taste gave him a sense of something fade and ludicrous. De Quincey.",
          "partOfSpeech": ""
        },
        {
          "text": "To cause to wither; to deprive of freshness or vigor; to wear away. No winter could his laurels fade. Dryden.",
          "partOfSpeech": "verb"
        }
      ],

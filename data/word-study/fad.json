    "fadedly": {
      "word": "FADEDLY",
      "definitions": [
        {
          "text": "In a faded manner. A dull room fadedly furnished. Dickens.",
          "partOfSpeech": "adverb"
        }
      ],
      "relatedWords": []
    },
    "fadeless": {
      "word": "FADELESS",
      "definitions": [
        {
          "text": "Not liable to fade; unfading.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "fadenvadenprobfrfadeacfprovdvaddentofade": {
      "word": "faden, vaden, prob. fr. fade, a.; cf. Prov. D. vadden to fade,",
      "definitions": [
        {
          "text": "To become fade; to grow weak; to lose strength; to decay; to perish gradually; to wither, as a plant. The earth mourneth and fadeth away. Is. xxiv. 4.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "To lose freshness, color, or brightness; to become faint in hue or tint; hence, to be wanting in color. \"Flowers that never fade.\" Milton.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "To sink away; to disappear gradually; to grow dim; to vanish. The stars shall fade away. Addison He makes a swanlike end, Fading in music. Shak.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "fader": {
      "word": "FADER",
      "definitions": [
        {
          "text": "Father. [Obs.] Chaucer.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "fadge": {
      "word": "FADGE",
      "definitions": [
        {
          "text": "To fit; to suit; to agree. They shall be made, spite of antipathy, to fadge together. Milton. Well, Sir, how fadges the new design Wycherley.",
          "partOfSpeech": "verb"
        },
        {
          "text": "A small flat loaf or thick cake; also, a fagot. [Prov. Eng.] Halliwell.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "fading": {
      "word": "FADING",
      "definitions": [
        {
          "text": "Losing freshness, color, brightness, or vigor.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "An Irish dance; also, the burden of a song. \"Fading is a fine jig.\" [Obs.] Beau. & Fl.",
          "partOfSpeech": "noun"
        }
      ],

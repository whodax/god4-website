    "deepen": {
      "word": "DEEPEN",
      "definitions": [
        {
          "text": "To make deep or deeper; to increase the depth of; to sink lower; as, to deepen a well or a channel. It would . . . deepen the bed of the Tiber. Addison.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To make darker or more intense; to darken; as, the event deepened the prevailing gloom. You must deepen your colors. Peacham.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To make more poignant or affecting; to increase in degree; as, to deepen grief or sorrow.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To make more grave or low in tone; as, to deepen the tones of an organ. Deepens the murmur of the falling floods. Pope.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To become deeper; as, the water deepens at every cast of the lead; the plot deepens. His blood-red tresses deepening in the sun. Byron.",
          "partOfSpeech": "verb"
        }
      ],

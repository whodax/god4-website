    "deem": {
      "word": "DEEM",
      "definitions": [
        {
          "text": "To decide; to judge; to sentence; to condemn. [Obs.] Claudius . . . Was demed for to hang upon a tree. Chaucer.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To account; to esteem; to think; to judge; to hold in opinion; to regard. For never can I deem him less him less than god. Dryden.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To be of opinion; to think; to estimate; to opine; to suppose. And deemest thou as those who pore, With aged eyes, short way before Emerson.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To pass judgment. [Obs.] Spenser.",
          "partOfSpeech": "verb"
        },
        {
          "text": "Opinion; judgment. [Obs.] Shak.",
          "partOfSpeech": "noun"
        }
      ],

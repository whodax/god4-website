    "fixation": {
      "word": "FIXATION",
      "definitions": [
        {
          "text": "The act of fixing, or the state of being fixed. An unalterable fixation of resolution. Killingbeck. To light, created in the first day, God gave no proper place or fixation. Sir W. Raleigh. Marked stiffness or absolute fixation of a joint. Quain. A fixation and confinement of thought to a few objects. Watts.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The act of uniting chemically with a solid substance or in a solid form; reduction to a non-volatile condition; -- said of gaseous elements.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The act or process of ceasing to be fluid and becoming firm. Glanvill.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A state of resistance to evaporation or volatilization by heat; -- said of metals. Bacon.",
          "partOfSpeech": "noun"
        }
      ],

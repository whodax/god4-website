    "fixedly": {
      "word": "FIXEDLY",
      "definitions": [
        {
          "text": "In a fixed, stable, or constant manner.",
          "partOfSpeech": "adverb"
        }
      ],
      "relatedWords": []
    },
    "fixedness": {
      "word": "FIXEDNESS",
      "definitions": [
        {
          "text": "The state or quality of being fixed; stability; steadfastness.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The quality of a body which resists evaporation or volatilization by heat; solidity; cohesion of parts; as, the fixedness of gold.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "fixidity": {
      "word": "FIXIDITY",
      "definitions": [
        {
          "text": "Fixedness. [Obs.] Boyle.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "fixing": {
      "word": "FIXING",
      "definitions": [
        {
          "text": "The act or process of making fixed.",
          "partOfSpeech": "noun"
        },
        {
          "text": "That which is fixed; a fixture.",
          "partOfSpeech": "noun"
        },
        {
          "text": "pl.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Arrangements; embellishments; trimmings; accompaniments. [Colloq. U.S.]",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "fixity": {
      "word": "FIXITY",
      "definitions": [
        {
          "text": "Fixedness; as, fixity of tenure; also, that which is fixed.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Coherence of parts. Sir I. Newton.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "fixture": {
      "word": "FIXTURE",
      "definitions": [
        {
          "text": "That which is fixed or attached to something as a permanent appendage; as, the fixtures of a pump; the fixtures of a farm or of a dwelling, that is, the articles which a tenant may not take away.",
          "partOfSpeech": "noun"
        },
        {
          "text": "State of being fixed; fixedness. The firm fixture of thy foot. Shak.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Law)",
          "partOfSpeech": "noun"
        },
        {
          "text": "Anything of an accessory character annexed to houses and lands, so as to constitute a part of them. This term is, however, quite frequently used in the peculiar sense of personal chattels annexed to lands and tenements, but removable by the person annexing them, or his personal representatives. In this latter sense, the same things may be fixtures under some circumstances, and not fixtures under others. Wharton (Law Dict. ). Bouvier. word in common use) in new editions of old works.",
          "partOfSpeech": "noun"
        }
      ],

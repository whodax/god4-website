    "dismember": {
      "word": "DISMEMBER",
      "definitions": [
        {
          "text": "To tear limb from limb; to dilacerate; to disjoin member from member; to tear or cut in pieces; to break up. Fowls obscene dismembered his remains. Pope. A society lacerated and dismembered. Gladstone. By whose hands the blow should be struck which would dismember that once mighty empire. Buckle.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To deprive of membership. [Obs.] They were dismembered by vote of the house. R. North.",
          "partOfSpeech": "verb"
        }

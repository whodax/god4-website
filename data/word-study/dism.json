    "dismantle": {
      "word": "DISMANTLE",
      "definitions": [
        {
          "text": "To strip or deprive of dress; to divest.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To strip of furniture and equipments, guns, etc.; to unrig; to strip of walls or outworks; to break down; as, to dismantle a fort, a town, or a ship. A dismantled house, without windows or shutters to keep out the rain. Macaulay.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To disable; to render useless. Comber.",
          "partOfSpeech": "verb"
        }
      ],

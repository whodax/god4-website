    "dismiss": {
      "word": "DISMISS",
      "definitions": [
        {
          "text": "To send away; to give leave of departure; to cause or permit to go; to put away. He dismissed the assembly. Acts xix. 41. Dismiss their cares when they dismiss their flock. Cowper. Though he soon dismissed himself from state affairs. Dryden.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To discard; to remove or discharge from office, service, or employment; as, the king dismisses his ministers; the matter dismisses his servant.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To lay aside or reject as unworthy of attentions or regard, as a petition or motion in court.",
          "partOfSpeech": "verb"
        },
        {
          "text": "Dismission. [Obs.] Sir T. Herbert.",
          "partOfSpeech": "noun"
        }
      ],

    "bubbler": {
      "word": "BUBBLER",
      "definitions": [
        {
          "text": "To cheat; to deceive. She has bubbled him out of his youth. Addison. The great Locke, who was seldom outwitted by false sounds, was nevertheless bubbled here. Sterne.",
          "partOfSpeech": "verb"
        },
        {
          "text": "One who cheats. All the Jews, jobbers, bubblers, subscribers, projectors, etc. Pope.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Zoöl.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A fish of the Ohio river; -- so called from the noise it makes.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

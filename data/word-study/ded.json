    "deducible": {
      "word": "DEDUCIBLE",
      "definitions": [
        {
          "text": "Capable of being deduced or inferred; derivable by reasoning, as a result or consequence. All properties of a triangle depend on, and are deducible from, the complex idea of three lines including a space. Locke.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Capable of being brought down. [Obs.] As if God [were] deducible to human imbecility. State Trials (1649).",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },

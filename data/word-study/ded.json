    "deductive": {
      "word": "DEDUCTIVE",
      "definitions": [
        {
          "text": "Of or pertaining to deduction; capable of being deduced from premises; deducible. All knowledge of causes is deductive. Glanvill. Notions and ideas . . . used in a deductive process. Whewell.",
          "partOfSpeech": "adjective"
        }
      ],

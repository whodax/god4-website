    "deduct": {
      "word": "DEDUCT",
      "definitions": [
        {
          "text": "To lead forth or out. [Obs.] A people deducted out of the city of Philippos. Udall.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To take away, separate, or remove, in numbering, estimating, or calculating; to subtract; -- often with from or out of. Deduct what is but vanity, or dress. Pope. Two and a half per cent should be deducted out of the pay of the foreign troops. Bp. Burnet. We deduct from the computation of our years that part of our time which is spent in . . . infancy. Norris.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To reduce; to diminish. [Obs.] \"Do not deduct it to days.\" Massinger.",
          "partOfSpeech": "verb"
        }
      ],

    "exulcerate": {
      "word": "EXULCERATE",
      "definitions": [
        {
          "text": "To ulcerate. [Obs.] \"To exulcerate the lungs.\" Evelyn.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To corrode; to fret; to chafe; to inflame. [Obs.] Minds exulcerated in themselves. Hooker.",
          "partOfSpeech": "verb"
        },
        {
          "text": "Very sore; ulcerated. [Obs.] Bacon.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },

    "exudation": {
      "word": "EXUDATION",
      "definitions": [
        {
          "text": "The act of exuding; sweating; a discharge of humors, moisture, juice, or gum, as through pores or incisions; also, the substance exuded. Resins, a class of proximate principles, existing in almost all plants and appearing on the external surface of many of them in the form of exudations. Am. Cyc.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "exude": {
      "word": "EXUDE",
      "definitions": [
        {
          "text": "To discharge through pores or incisions, as moisture or other liquid matter; to give out. Our forests exude turpentine in . . . abundance. Dr. T. Dwight.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To flow from a body through the pores, or by a natural discharge, as juice.",
          "partOfSpeech": "verb"
        }
      ],

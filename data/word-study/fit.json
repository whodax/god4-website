    "fitch": {
      "word": "FITCH",
      "definitions": [
        {
          "text": "(Bot.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A vetch. [Obs.]",
          "partOfSpeech": "noun"
        },
        {
          "text": "pl. (Bot.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A word found in the Authorized Version of the Bible, representing different Hebrew originals. In Isaiah xxviii. 25, 27, it means the black aromatic seeds of Nigella sativa, still used as a flavoring in the East. In Ezekiel iv. 9, the Revised Version now reads spelt.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The European polecat; also, its fur.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

    "fitforfoodusefulpropertemperatethedativeoffruxfrugis": {
      "word": "fit for food, useful, proper, temperate, the dative of frux, frugis,",
      "definitions": [
        {
          "text": "Economical in the use or appropriation of resources; not wasteful or lavish; wise in the expenditure or application of force, materials, time, etc.; characterized by frugality; sparing; economical; saving; as, a frugal housekeeper; frugal of time. I oft admire How Nature, wise and frugal, could commit Such disproportions. Milton.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Obtained by, or appropriate to, economy; as, a frugal fortune. \"Frugal fare.\" Dryden.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

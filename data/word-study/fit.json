    "fitter": {
      "word": "FITTER",
      "definitions": [
        {
          "text": "One who fits or makes to fit; esp.: (a) One who tries on, and adjusts, articles of dress. (b) One who fits or adjusts the different parts of machinery to each other.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A coal broker who conducts the sales between the owner of a coal pit and the shipper. [Eng.] Simmonds.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A little piece; a flitter; a flinder. [Obs.] Where's the Frenchman Alas, he's all fitters. Beau. & Fl.",
          "partOfSpeech": "noun"
        }
      ],

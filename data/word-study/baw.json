    "bawl": {
      "word": "BAWL",
      "definitions": [
        {
          "text": "To cry out with a loud, full sound; to cry with vehemence, as in calling or exultation; to shout; to vociferate.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To cry loudly, as a child from pain or vexation.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To proclaim with a loud voice, or by outcry, as a hawker or town-crier does. Swift.",
          "partOfSpeech": "verb"
        },
        {
          "text": "A loud, prolonged cry; an outcry.",
          "partOfSpeech": "noun"
        }
      ],

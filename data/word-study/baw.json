    "bawdry": {
      "word": "BAWDRY",
      "definitions": [
        {
          "text": "The practice of procuring women for the gratification of lust.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Illicit intercourse; fornication. Shak.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Obscenity; filthy, unchaste language. \"The pert style of the pit bawdry.\" Steele.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

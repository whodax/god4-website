    "cachinnation": {
      "word": "CACHINNATION",
      "definitions": [
        {
          "text": "Loud or immoderate laughter; -- often a symptom of hysterical or maniacal affections. Hideous grimaces . . . attended this unusual cachinnation. Sir W. Scott.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "cachinnatory": {
      "word": "CACHINNATORY",
      "definitions": [
        {
          "text": "Consisting of, or accompanied by, immoderate laughter. Cachinnatory buzzes of approval. Carlyle.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "cachiri": {
      "word": "CACHIRI",

    "hove": {
      "word": "HOVE",
      "definitions": [
        {
          "text": "of Heave. Hove short, Hove to. See To heave a cable short, To heave a ship to, etc., under Heave.",
          "partOfSpeech": ""
        },
        {
          "text": "To rise; to swell; to heave; to cause to swell. [Obs. or Scot.] Holland. Burns.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To hover around; to loiter; to lurk. [Obs.] Gower.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "hovel": {
      "word": "HOVEL",
      "definitions": [
        {
          "text": "An open shed for sheltering cattle, or protecting produce, etc., from the weather. Brande & C.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A poor cottage; a small, mean house; a hut.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Porcelain Manuf.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A large conical brick structure around which the firing kilns are grouped. Knight.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To put in a hovel; to shelter. To hovel thee with swine, and rogues forlon. Shak. The poor are hoveled and hustled together. Tennyson.",
          "partOfSpeech": "verb"
        }
      ],

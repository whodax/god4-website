    "degraded": {
      "word": "DEGRADED",
      "definitions": [
        {
          "text": "Reduced in rank, character, or reputation; debased; sunken; low; base. The Netherlands . . . were reduced practically to a very degraded condition. Motley.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Biol.)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Having the typical characters or organs in a partially developed condition, or lacking certain parts. Some families of plants are degraded dicotyledons. Dana.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Etym: [Cf. F. degré step.] (Her.)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Having steps; -- said of a cross each of whose extremities finishes in steps growing larger as they leave the center; -- termed also on degrees.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },

    "degarnish": {
      "word": "DEGARNISH",
      "definitions": [
        {
          "text": "To strip or deprive of entirely, as of furniture, ornaments, etc.; to disgarnish; as, to degarnish a house, etc. [R.]",
          "partOfSpeech": "verb"
        },
        {
          "text": "To deprive of a garrison, or of troops necessary for defense; as, to degarnish a city or fort. [R.] Washington.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "degarnishment": {
      "word": "DEGARNISHMENT",
      "definitions": [
        {
          "text": "The act of depriving, as of furniture, apparatus, or a garrison. [R.]",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "degenderdegener": {
      "word": "DEGENDER; DEGENER",
      "definitions": [
        {
          "text": "To degenerate. [Obs.] \"Degendering to hate.\" Spenser. He degenereth into beastliness. Joye.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "degeneracy": {
      "word": "DEGENERACY",
      "definitions": [
        {
          "text": "The act of becoming degenerate; a growing worse. Willful degeneracy from goodness. Tillotson.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The state of having become degenerate; decline in good qualities; deterioration; meanness. Degeneracy of spirit in a state of slavery. Addison. To recover mankind out of their universal corruption and degeneracy. S. Clarke.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "degenerate": {
      "word": "DEGENERATE",
      "definitions": [
        {
          "text": "Having become worse than one's kind, or one's former state; having declined in worth; having lost in goodness; deteriorated; degraded; unworthy; base; low. Faint-hearted and degenerate king. Shak. A degenerate and degraded state. Milton. Degenerate from their ancient blood. Swift. These degenerate days. Pope. I had planted thee a noble vine . . . : how then art thou turned into the degenerate plant of a strange vine unto me Jer. ii. 21.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "To be or grow worse than one's kind, or than one was originally; hence, to be inferior; to grow poorer, meaner, or more vicious; to decline in good qualities; to deteriorate. When wit transgresseth decency, it degenerates into insolence and impiety. Tillotson.",
          "partOfSpeech": "verb"
        },
        {
          "text": "(Biol.)",
          "partOfSpeech": "verb"
        },
        {
          "text": "To fall off from the normal quality or the healthy structure of its kind; to become of a lower type.",
          "partOfSpeech": "verb"
        }
      ],

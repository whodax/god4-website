    "disjunct": {
      "word": "DISJUNCT",
      "definitions": [
        {
          "text": "Disjoined; separated. [R.]",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Zoöl.)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Having the head, thorax, and abdomen separated by a deep constriction. Disjunct tetrachords (Mus.), tetrachords so disposed to each other that the gravest note of the upper is one note higher than the acutest note of the other.",
          "partOfSpeech": "adjective"
        }

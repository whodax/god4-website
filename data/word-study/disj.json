    "disjoin": {
      "word": "DISJOIN",
      "definitions": [
        {
          "text": "To part; to disunite; to separate; to sunder. That marriage, therefore, God himself disjoins. Milton. Never let us lay down our arms against France, till we have utterly disjoined her from the Spanish monarchy. Addison. Windmill Street consisted of disjoined houses. Pennant. disconnect.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To become separated; to part.",
          "partOfSpeech": "verb"
        }
      ],

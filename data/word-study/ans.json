    "answerable": {
      "word": "ANSWERABLE",
      "definitions": [
        {
          "text": "Obliged to answer; liable to be called to account; liable to pay, indemnify, or make good; accountable; amenable; responsible; as, an agent is answerable to his principal; to be answerable for a debt, or for damages. Will any man argue that . . . he can not be justly punished, but is answerable only to God Swift.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Capable of being answered or refuted; admitting a satisfactory answer. The argument, though subtle, is yet answerable. Johnson.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Correspondent; conformable; hence, comparable. What wit and policy of man is answerable to their discreet and orderly course Holland. This revelation . . . was answerable to that of the apostle to the Thessalonians. Milton.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Proportionate; commensurate; suitable; as, an achievement answerable to the preparation for it.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Equal; equivalent; adequate. [Archaic] Had the valor of his soldiers been answerable, he had reached that year, as was thought, the utmost bounds of Britain. Milton.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "answerableness": {
      "word": "ANSWERABLENESS",
      "definitions": [
        {
          "text": "The quality of being answerable, liable, responsible, or correspondent.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "answerably": {
      "word": "ANSWERABLY",
      "definitions": [
        {
          "text": "In an answerable manner; in due proportion or correspondence; suitably.",
          "partOfSpeech": "adverb"
        }
      ],
      "relatedWords": []
    },
    "answerer": {
      "word": "ANSWERER",
      "definitions": [
        {
          "text": "One who answers.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "answerless": {
      "word": "ANSWERLESS",
      "definitions": [
        {
          "text": "Having no answer, or impossible to be answered. Byron.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    }
  }

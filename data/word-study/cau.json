          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "causative": {
      "word": "CAUSATIVE",
      "definitions": [
        {
          "text": "Effective, as a cause or agent; causing. Causative in nature of a number of effects. Bacon.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Expressing a cause or reason; causal; as, the ablative is a causative case.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "A word which expresses or suggests a cause.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "causatively": {

    "caucasian": {
      "word": "CAUCASIAN",
      "definitions": [
        {
          "text": "Of or pertaining to the Caucasus, a mountainous region between the Black and Caspian seas.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Of or pertaining to the white races of mankind, of whom the people about Mount Caucasus were formerly taken as the type.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "A native or inhabitant of the Caucasus, esp. a Circassian or Georgian.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A member of any of the white races of mankind.",
          "partOfSpeech": "noun"
        }
      ],

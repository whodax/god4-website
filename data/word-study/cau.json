    "causal": {
      "word": "CAUSAL",
      "definitions": [
        {
          "text": "Relating to a cause or causes; inplying or containing a cause or causes; expressing a cause; causative. Causal propositions are where two propositions are joined by causal words. Watts.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "A causal word or form of speech. Anglo-Saxon drencan to drench, causal of Anglo-Saxon drincan to drink. Skeat.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "causality": {
      "word": "CAUSALITY",
      "definitions": [
        {
          "text": "The agency of a cause; the action or power of a cause, in producing its effect. The causality of the divine mind. Whewell.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Phren.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "The faculty of tracing effects to their causes. G. Combe.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "causally": {
      "word": "CAUSALLY",
      "definitions": [
        {
          "text": "According to the order or series of causes; by tracing effects to causes.",
          "partOfSpeech": "adverb"
        },
        {
          "text": "The lighter, earthy parts of ore, carried off washing.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "causation": {
      "word": "CAUSATION",
      "definitions": [
        {
          "text": "The act of causing; also the act or agency by which an effect is produced. The kind of causation by which vision is produced. Whewell. Law of universal causation, the theoretical or asserted law that every event or phenomenon results from, or is the sequel of, some previous event or phenomenon, which being present, the other is certain to take place.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "causationist": {
      "word": "CAUSATIONIST",

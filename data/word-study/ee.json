    "eel": {
      "word": "EEL",
      "definitions": [
        {
          "text": "An elongated fish of many genera and species. The common eels of Europe and America belong to the genus Anguilla. The electrical eel is a species of Gymnotus. The so called vinegar eel is a minute nematode worm. See Conger eel, Electric eel, and Gymnotus.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

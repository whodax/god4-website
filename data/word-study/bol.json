    "bolter": {
      "word": "BOLTER",
      "definitions": [
        {
          "text": "One who bolts; esp.: (a) A horse which starts suddenly aside. (b) A man who breaks away from his party.",
          "partOfSpeech": "noun"
        },
        {
          "text": "One who sifts flour or meal.",
          "partOfSpeech": "noun"
        },
        {
          "text": "An instrument or machine for separating bran from flour, or the coarser part of meal from the finer; a sieve.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A kind of fishing line. See Boulter.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

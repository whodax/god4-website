      "definitions": [
        {
          "text": "(Gardening)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A bed of earth heated by fermenting manure or other substances, and covered with glass, intended for raising early plants, or for nourishing exotics.",
          "partOfSpeech": "noun"
        },

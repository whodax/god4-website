    "ghastly": {
      "word": "GHASTLY",
      "definitions": [
        {
          "text": "Like a ghost in appearance; deathlike; pale; pallid; dismal. Each turned his face with a ghastly pang. Coleridge. His face was so ghastly that it could scarcely be recognized. Macaulay.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Horrible; shocking; dreadful; hideous. Mangled with ghastly wounds through plate and mail. Milton.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "In a ghastly manner; hideously. Staring full ghastly like a strangled man. Shak.",
          "partOfSpeech": "adverb"
        }
      ],

    "inboard": {
      "word": "INBOARD",
      "definitions": [
        {
          "text": "(Naut.)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Inside the line of a vessel's bulwarks or hull; the opposite of outboard; as, an inboard cargo; haul the boom inboard.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Mech.)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "From without inward; toward the inside; as, the inboard stroke of a steam engine piston, the inward or return stroke.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },

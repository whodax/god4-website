    "hectare": {
      "word": "HECTARE",
      "definitions": [
        {
          "text": "A measure of area, or superficies, containing a hundred ares, or 10,000 square meters, and equivalent to 2.471 acres.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []

    "hectic": {
      "word": "HECTIC",
      "definitions": [
        {
          "text": "Habitual; constitutional; pertaining especially to slow waste of animal tissue, as in consumption; as, a hectic type in disease; a hectic flush.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "In a hectic condition; having hectic fever; consumptive; as, a hectic patient. Hectic fever (Med.), a fever of irritation and debility, occurring usually at a advanced stage of exhausting disease, as a in pulmonary consumption.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Med.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "Hectic fever.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A hectic flush. It is no living hue, but a strange hectic. Byron.",
          "partOfSpeech": "noun"
        }
      ],

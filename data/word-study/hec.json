  "entries": {
    "hecatomb": {
      "word": "HECATOMB",
      "definitions": [
        {
          "text": "A sacrifice of a hundred oxen or cattle at the same time; hence, the sacrifice or slaughter of any large number of victims. Slaughtered hecatombs around them bleed. Addison. More than a human hecatomb. Byron.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "hecatompedon": {
      "word": "HECATOMPEDON",
      "definitions": [
        {
          "text": "A name given to the old Parthenon at Athens, because measuring 100 Greek feet, probably in the width across the stylobate.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "hecdecane": {
      "word": "HECDECANE",
      "definitions": [
        {
          "text": "A white, semisolid, spermaceti-like hydrocarbon, C16H34, of the paraffin series, found dissolved as an important ingredient of kerosene, and so called because each molecule has sixteen atoms of carbon; -- called also hexadecane.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "heck": {
      "word": "HECK",
      "definitions": [
        {
          "text": "The bolt or latch of a door. [Prov. Eng.]",
          "partOfSpeech": "noun"
        },
        {
          "text": "A rack for cattle to feed at. [Prov. Eng.]",
          "partOfSpeech": "noun"
        },
        {
          "text": "A door, especially one partly of latticework; -- called also heck door. [Prov. Eng.] Halliwell.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A latticework contrivance for catching fish.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Weaving)",
          "partOfSpeech": "noun"
        },
        {
          "text": "An apparatus for separating the threads of warps into sets, as they are wound upon the reel from the bobbins, in a warping machine.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A bend or winding of a stream. [Prov. Eng.] Half heck, the lower half of a door.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "heckimal": {
      "word": "HECKIMAL",
      "definitions": [
        {
          "text": "The European blue titmouse (Parus coeruleus). [Written also heckimel, hackeymal, hackmall, hagmall, and hickmall.]",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

    "hectocotylus": {
      "word": "HECTOCOTYLUS",
      "definitions": [
        {
          "text": "One of the arms of the male of most kinds of cephalopods, which is specially modified in various ways to effect the fertilization of the eggs. In a special sense, the greatly modified arm of Argonauta and allied genera, which, after receiving the spermatophores, becomes detached from the male, and attaches itself to the female for reproductive purposes.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "hectogram": {
      "word": "HECTOGRAM",
      "definitions": [
        {
          "text": "A measure of weight, containing a hundred grams, or about 3.527 ounces avoirdupois.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

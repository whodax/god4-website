    "anoetic": {
      "word": "ANOETIC",
      "definitions": [
        {
          "text": "Unthinkable. [Rare]",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Psychol.) Not subject to conscious attention; having an indefinite, relatively passive, conscious being; characteristic of the \"fringe\" or \"margin\" of consciousness. Presentation considered as having an existence relatively independent of thought, may be called sentience, or anoetic consciousness. Thought and sentience are fundamentally distinct mental functions. G. F. Stout.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },

    "igneous": {
      "word": "IGNEOUS",
      "definitions": [
        {
          "text": "Pertaining to, having the nature of, fire; containing fire; resembling fire; as, an igneous appearance.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Geol.)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Resulting from, or produced by, the action of fire; as, lavas and basalt are igneous rocks.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },

    "ignite": {
      "word": "IGNITE",
      "definitions": [
        {
          "text": "To kindle or set on fire; as, to ignite paper or wood.",
          "partOfSpeech": "verb"
        },
        {
          "text": "(Chem.)",
          "partOfSpeech": "verb"
        },
        {
          "text": "To subject to the action of intense heat; to heat strongly; -- often said of incombustible or infusible substances; as, to ignite iron or platinum.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To take fire; to begin to burn.",
          "partOfSpeech": "verb"
        }

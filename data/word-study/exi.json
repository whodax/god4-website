    "exist": {
      "word": "EXIST",
      "definitions": [
        {
          "text": "To be as a fact and not as a mode; to have an actual or real being, whether material or spiritual. Who now, alas! no more is missed Than if he never did exist. Swift. To conceive the world . . . to have existed from eternity. South.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To be manifest in any manner; to continue to be; as, great evils existed in his reign.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To live; to have life or the functions of vitality; as, men can not exist water, nor fishes on land.",
          "partOfSpeech": "verb"
        }
      ],

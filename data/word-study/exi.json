    "exile": {
      "word": "EXILE",
      "definitions": [
        {
          "text": "Forced separation from one's native country; expulsion from one's home by the civil authority; banishment; sometimes, voluntary separation from one's native country. Let them be recalled from their exile. Shak.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The person expelled from his country by authority; also, one who separates himself from his home. Thou art in exile, and thou must not stay. Shak.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To banish or expel from one's own country or home; to drive away. \"Exiled from eternal God.\" Tennyson. Calling home our exiled friends abroad. Shak.",
          "partOfSpeech": ""
        },
        {
          "text": "Small; slender; thin; fine. [Obs.] \"An exile sound.\" Bacon.",
          "partOfSpeech": "adjective"
        }
      ],

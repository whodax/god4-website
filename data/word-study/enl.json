    "enlighten": {
      "word": "ENLIGHTEN",
      "definitions": [
        {
          "text": "To supply with light; to illuminate; as, the sun enlightens the earth. His lightnings enlightened the world. Ps. xcvii. 4.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To make clear to the intellect or conscience; to shed the light of truth and knowledge upon; to furnish with increase of knowledge; to instruct; as, to enlighten the mind or understanding. The conscience enlightened by the Word and Spirit of God. Trench.",
          "partOfSpeech": "verb"
        }
      ],

    "enlace": {
      "word": "ENLACE",
      "definitions": [
        {
          "text": "To bind or encircle with lace, or as with lace; to lace; to encircle; to enfold; hence, to entangle. Ropes of pearl her neck and breast enlace. P. Fletcher.",

    "enlist": {
      "word": "ENLIST",
      "definitions": [
        {
          "text": "To enter on a list; to enroll; to register.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To engage for military or naval service, the name being entered on a list or register; as, to enlist men.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To secure the support and aid of; to employ in advancing interest; as, to enlist persons in the cause of truth, or in a charitable enterprise.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To enroll and bind one's self for military or naval service; as, he enlisted in the regular army; the men enlisted for the war.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To enter heartily into a cause, as if enrolled.",
          "partOfSpeech": "verb"
        }
      ],

    "fawn": {
      "word": "FAWN",
      "definitions": [
        {
          "text": "(Zoöl.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A young deer; a buck or doe of the first year. See Buck.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The young of an animal; a whelp. [Obs.] [The tigress] . . . followeth . . . after her fawns. Holland.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A fawn color.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Of the color of a fawn; fawn-colored.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "To bring forth a fawn.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To court favor by low cringing, frisking, etc., as a dog; to flatter meanly; -- often followed by on or upon. You showed your teeth like apes, and fawned like hounds. Shak. Thou with trembling fear, Or like a fawning parasite, obeyest. Milton. Courtiers who fawn on a master while they betray him. Macaulay.",
          "partOfSpeech": "verb"
        },
        {
          "text": "A servile cringe or bow; mean flattery; sycophancy. Shak.",
          "partOfSpeech": "noun"
        }
      ],

    "foe": {
      "word": "FOE",
      "definitions": [
        {
          "text": "See Fiend, and cf. Feud a quarrel.",
          "partOfSpeech": "noun"
        },
        {
          "text": "One who entertains personal enmity, hatred, grudge, or malice, against another; an enemy. A man's foes shall be they of his own household. Matt. x. 36",
          "partOfSpeech": "noun"
        },
        {
          "text": "An enemy in war; a hostile army.",
          "partOfSpeech": "noun"
        },
        {
          "text": "One who opposes on principle; an opponent; an adversary; an ill- wisher; as, a foe to religion. A foe to received doctrines. I. Watts",
          "partOfSpeech": "noun"
        },
        {
          "text": "To treat as an enemy. [Obs.] Spenser.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": [
        "adversary",
        "antagonist",
        "archenemy",
        "assailant",
        "bitter enemy",
        "combatant",
        "devil",
        "enemy",

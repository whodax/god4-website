    "chyometer": {
      "word": "CHYOMETER",
      "definitions": [
        {
          "text": "An instrument for measuring liquids. It consists of a piston moving in a tube in which is contained the liquid, the quantity expelled being indicated by the graduation upon the piston rod.",
          "partOfSpeech": "noun"

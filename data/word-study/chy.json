  "entries": {
    "chylaceous": {
      "word": "CHYLACEOUS",
      "definitions": [
        {
          "text": "Possessed of the properties of chyle; consisting of chyle.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "chylaqueous": {
      "word": "CHYLAQUEOUS",
      "definitions": [
        {
          "text": "Consisting of chyle much diluted with water; -- said of a liquid which forms the circulating fluid of some inferior animals.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "chyle": {
      "word": "CHYLE",
      "definitions": [
        {
          "text": "A milky fluid containing the fatty matter of the food in a state of emulsion, or fine mechanical division; formed from chyme by the action of the intestinal juices. It is absorbed by the lacteals, and conveyed into the blood by the thoracic duct.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "chylifaction": {
      "word": "CHYLIFACTION",
      "definitions": [
        {
          "text": "The act or process by which chyle is formed from food in animal bodies; chylification, -- a digestive process.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "chylifactive": {
      "word": "CHYLIFACTIVE",
      "definitions": [
        {
          "text": "Producing, or converting into, chyle; having the power to form chyle.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "chyliferous": {
      "word": "CHYLIFEROUS",
      "definitions": [
        {
          "text": "[Chyle + -ferous: cf. F. chylifère.] (Physiol.) Transmitting or conveying chyle; as, chyliferous vessels.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "chylific": {
      "word": "CHYLIFIC",
      "definitions": [
        {
          "text": "Chylifactive.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "chylification": {

    "hooded": {
      "word": "HOODED",
      "definitions": [
        {
          "text": "Covered with a hood.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Furnished with a hood or something like a hood.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Hood-shaped; esp. (Bot.), rolled up like a cornet of paper; cuculate, as the spethe of the Indian turnip.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Zoöl.) (a) Having the head conspicuously different in color from the rest of the plumage; -- said of birds. (b) Having a hoodlike crest or prominence on the head or neck; as, the hooded seal; a hooded snake. Hooded crow, a European crow (Corvus cornix); -- called also hoody, dun crow, and royston crow. The male has a large, inflatible, hoodlike sac upon the head. Called also hoodcap.",
          "partOfSpeech": "adjective"
        }
      ],

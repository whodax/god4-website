    "enumeration": {
      "word": "ENUMERATION",
      "definitions": [
        {
          "text": "The act of enumerating, making separate mention, or recounting.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A detailed account, in which each thing is specially noticed. Because almost every man we meet possesses these, we leave them out of our enumeration. Paley.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Rhet.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A recapitulation, in the peroration, of the heads of an argument.",

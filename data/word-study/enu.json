    "enunciate": {
      "word": "ENUNCIATE",
      "definitions": [
        {
          "text": "To make a formal statement of; to announce; to proclaim; to declare, as a truth. The terms in which he enunciates the great doctrines of the gospel. Coleridge.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To make distinctly audible; to utter articulately; to pronounce; as, to enunciate a word distinctly.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To utter words or syllables articulately.",
          "partOfSpeech": "verb"
        }
      ],

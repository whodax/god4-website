    "dop": {
      "word": "DOP; DOOP",
      "definitions": [
        {
          "text": "A little copper cup in which a diamond is held while being cut.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To dip. [Obs.] Walton.",
          "partOfSpeech": "verb"
        },
        {
          "text": "A dip; a low courtesy. [Obs.] B. Jonson.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "dope": {
      "word": "DOPE",
      "definitions": [
        {
          "text": "Any thick liquid or pasty preparation, as of opium for medicinal purposes, of grease for a lubricant, etc.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Any preparation, as of opium, used to stupefy or, in the case of a race horse, to stimulate. [Slang or Cant]",
          "partOfSpeech": "noun"
        },
        {
          "text": "An absorbent material; esp., in high explosives, the sawdust, infusorial earth, mica, etc., mixed with nitroglycerin to make a damp powder (dynamite, etc.) less dangerous to transport, and ordinarily explosive only by suitable fulminating caps.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Information concerning the previous performances of race horses, or other facts concerning them which may be of assistance in judging of their chances of winning future races; sometimes, similar information concerning other sports. [Sporting Slang]",
          "partOfSpeech": "noun"
        },
        {
          "text": "To treat or affect with dope; as, to dope nitroglycerin; specif.: (a) To give stupefying drugs to; to drug. [Slang] (b) To administer a stimulant to (a horse) to increase his speed. It is a serious offense against the laws of racing. [Race-track Slang]",
          "partOfSpeech": "verb"
        },
        {
          "text": "To judge or guess; to predict the result of, as by the aid of dope. [Slang]",
          "partOfSpeech": "verb"
        }
      ],

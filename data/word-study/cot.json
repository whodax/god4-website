    "cote": {
      "word": "COTE",
      "definitions": [
        {
          "text": "A cottage or hut. [Obs.]",
          "partOfSpeech": "noun"
        },
        {
          "text": "A shed, shelter, or inclosure for small domestic animals, as for sheep or doves. Watching where shepherds pen their flocks, at eve, In hurdled cotes. Milton.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To go side by side with; hence, to pass by; to outrun and get before; as, a dog cotes a hare. [Obs.] Drayton. We coted them on the way, and hither are they coming. Shak.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To quote. [Obs.] Udall.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },

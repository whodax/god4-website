    "cot": {
      "word": "COT",
      "definitions": [
        {
          "text": "A small house; a cottage or hut. The sheltered cot, the cultivated farm. Goldsmith.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A pen, coop, or like shelter for small domestic animals, as for sheep or pigeons; a cote.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A cover or sheath; as, a roller cot (the clothing of a drawing roller in a spinning frame); a cot for a sore finger.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Etym: [Cf. Ir. cot.]",
          "partOfSpeech": "noun"
        },
        {
          "text": "A small, rudely-formed boat. Bell cot. (Arch.) See under Bell.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A sleeping place of limited size; a little bed; a cradle; a piece of canvas extended by a frame, used as a bed. [Written also cott.]",
          "partOfSpeech": "noun"
        }
      ],

    "cotarnine": {
      "word": "COTARNINE",
      "definitions": [
        {
          "text": "A white, crystalline substance, C12H13NO3, obtained as a product of the decomposition of narcotine. It has weak basic properties, and is usually regarded as an alkaloid.",

    "conjecturally": {
      "word": "CONJECTURALLY",
      "definitions": [
        {
          "text": "That which depends upon guess; guesswork. [R.] Sir T. Browne.",
          "partOfSpeech": "noun"
        },
        {
          "text": "In a conjectural manner; by way of conjecture. Boyle.",

    "conject": {
      "word": "CONJECT",
      "definitions": [
        {
          "text": "To throw together, or to throw. [Obs.] Bp. Montagu.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To conjecture; also, to plan. [Obs.]",
          "partOfSpeech": "verb"
        }

    "conjunctive": {
      "word": "CONJUNCTIVE",
      "definitions": [
        {
          "text": "Serving to unite; connecting together.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Closely united. [Obs.] Shak. Conjunctive mood (Gram.), the mood which follows a conjunction or expresses contingency; the subjunctive mood. of most animals. It yields gelatin on boiling, and consists of vriously arranged fibers which are imbedded protoplasmic cells, or corpuscles; -- called also cellular tissue and connective tissue. Adipose or fatty tissue is one of its many forms, and cartilage and bone are sometimes included by the phrase.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "conjunctively": {

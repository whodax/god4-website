    "conjoin": {
      "word": "CONJOIN",
      "definitions": [
        {
          "text": "To join together; to unite. The English army, that divided was Into two parties, is now conjoined in one. Shak. If either of you know any inward impediment why you should not be conjoined. Shak. Let that which he learns next be nearly conjoined with what he knows already. Locke.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To unite; to join; to league. Shak.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },

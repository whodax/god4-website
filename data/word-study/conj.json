    "conjugation": {
      "word": "CONJUGATION",
      "definitions": [
        {
          "text": "the act of uniting or combining; union; assemblage. [Obs.] Mixtures and conjugations of atoms. Bentley.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Two things conjoined; a pair; a couple. [Obs.] The sixth conjugations or pair of nerves. Sir T. Browne.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Gram.) (a) The act of conjugating a verb or giving in order its various parts and inflections. (b) A scheme in which are arranged all the parts of a verb. (c) A class of verbs conjugated in the same manner.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Biol.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A kind of sexual union; -- applied to a blending of the contents of two or more cells or individuals in some plants and lower animals, by which new spores or germs are developed.",
          "partOfSpeech": "noun"
        }
      ],

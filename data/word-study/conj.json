    "conjuncture": {
      "word": "CONJUNCTURE",
      "definitions": [
        {
          "text": "The act of joining, or state of being joined; union; connection; combination. The conjuncture of philosophy and divinity. Hobbes. A fit conjuncture or circumstances. Addison.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A crisis produced by a combination of circumstances; complication or combination of events or circumstances; plight resulting from various conditions. He [Chesterfield] had recently governed Ireland, at a momentous conjuncture, with eminent firmness, wisdom, and humanity. Macaulay.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "conjuration": {
      "word": "CONJURATION",
      "definitions": [
        {
          "text": "The act of calling or summoning by a sacred name, or in solemn manner; the act of binding by an oath; an earnest entreaty; adjuration. We charge you, in the name of God, take heed; . . . Under this conjuration speak, my lord. Shak.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The act or process of invoking supernatural aid by the use of a magical form of words; the practice of magic arts; incantation; enchantment. Pretended conjurations and prophecies of that event. Hallam.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A league for a criminal purpose; conspiracy. [Obs.] \"The conjuration of Catiline.\" Sir T. Elyot.",
          "partOfSpeech": "noun"
        }
      ],

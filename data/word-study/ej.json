    "ejaculation": {
      "word": "EJACULATION",
      "definitions": [
        {
          "text": "The act of throwing or darting out with a sudden force and rapid flight. [Archaic or Technical] \"An ejaculation or irradiation of the eye.\" Bacon.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The uttering of a short, sudden exclamation or prayer, or the exclamation or prayer uttered. In your dressing, let there be jaculations fitted to the several actions of dressing. Jer. Taylor.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Physiol.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "The act of ejecting or suddenly throwing, as a fluid from a duct.",
          "partOfSpeech": "noun"
        }
      ],

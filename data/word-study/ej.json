    "ejecta": {
      "word": "EJECTA",
      "definitions": [
        {
          "text": "Matter ejected; material thrown out; as, the ejecta of a volcano; the ejecta, or excreta, of the body.",
          "partOfSpeech": "noun"
        }
      ],

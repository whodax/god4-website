    "ejaculate": {
      "word": "EJACULATE",
      "definitions": [
        {
          "text": "To throw out suddenly and swiftly, as if a dart; to dart; to eject. [Archaic or Technical] Its active rays ejaculated thence. Blackmore.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To throw out, as an exclamation; to utter by a brief and sudden impulse; as, to ejaculate a prayer.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To utter ejaculations; to make short and hasty exclamations. [R.] \"Ejaculating to himself.\" Sir W. Scott.",
          "partOfSpeech": "verb"
        }
      ],

    "ejectment": {
      "word": "EJECTMENT",
      "definitions": [
        {
          "text": "A casting out; a dispossession; an expulsion; ejection; as, the ejectment of tenants from their homes.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Law)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A species of mixed action, which lies for the recovery of possession of real property, and damages and costs for the wrongful withholding of it. Wharton.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "ejector": {
      "word": "EJECTOR",
      "definitions": [
        {
          "text": "One who, or that which, ejects or dispossesses.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Mech.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A jet jump for lifting water or withdrawing air from a space. Ejector condenser (Steam Engine), a condenser in which the vacuum is maintained by a jet pump.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

    "eject": {
      "word": "EJECT",
      "definitions": [
        {
          "text": "To expel; to dismiss; to cast forth; to thrust or drive out; to discharge; as, to eject a person from a room; to eject a traitor from the country; to eject words from the language. \"Eyes ejecting flame.\" H. Brooke.",
          "partOfSpeech": "verb"
        },
        {
          "text": "(Law)",
          "partOfSpeech": "verb"
        },
        {
          "text": "To cast out; to evict; to dispossess; as, to eject tenants from an estate. extrude; void.",
          "partOfSpeech": "verb"
        }

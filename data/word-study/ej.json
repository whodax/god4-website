    "ejection": {
      "word": "EJECTION",
      "definitions": [
        {
          "text": "The act of ejecting or casting out; discharge; expulsion; evacuation. \"Vast ejection of ashes.\" Eustace. \"The ejection of a word.\" Johnson.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Physiol.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "The act or process of discharging anything from the body, particularly the excretions.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The state of being ejected or cast out; dispossession; banishment.",
          "partOfSpeech": "noun"
        }
      ],

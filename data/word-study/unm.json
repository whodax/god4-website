    "unmanned": {
      "word": "UNMANNED",
      "definitions": [
        {
          "text": "Etym: [Properly p. p. of unman.]",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Deprived of manly qualities; deficient in vigor, strength, courage, etc.; weak; effeminate.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Etym: [Pref. un- not + man + -ed.] (Falconry)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Not tamed; not made familiar with, or subject to, man; -- also used figuratively. [Obs.] Hood my unmanned blood bating in my cheeks With thy black mantle. Shak.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Etym: [Pref. un- not + manned.]",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Not furnished with men; as, an unmanned ship.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },

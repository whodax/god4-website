    "unmake": {
      "word": "UNMAKE",
      "definitions": [
        {
          "text": "To destroy the form and qualities of; to deprive of being; to uncreate. God does not make or unmake things to try experiments. T. Burnet.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "unman": {
      "word": "UNMAN",
      "definitions": [
        {
          "text": "To deprive of the distinctive qualities of a human being, as reason, or the like. [R.] South.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To emasculate; to deprive of virility.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To deprive of the courage and fortitude of a man; to break or subdue the manly spirit in; to cause to despond; to dishearten; to make womanish. Let's not unman each other. Byron.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To deprive of men; as, to unman a ship.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "unmanacle": {
      "word": "UNMANACLE",
      "definitions": [
        {

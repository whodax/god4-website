    "unmade": {
      "word": "UNMADE",
      "definitions": [
        {
          "text": "Etym: [Pref. un- not + made.]",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Not yet made or formed; as, an unmade grave. Shak.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Etym: [Properly p. p. of unmake.]",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Deprived of form, character, etc.; disunited.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "unmagistrate": {

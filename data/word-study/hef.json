  "entries": {
    "heft": {
      "word": "HEFT",
      "definitions": [
        {
          "text": "The act or effort of heaving [Obs.] He craks his gorge, his sides, With violent hefts. Shak.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Weight; ponderousness. [Colloq.] A man of his age and heft. T. Hughes.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The greater part or bulk of anything; as, the heft of the crop was spoiled. [Colloq. U. S.] J. Pickering.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To heave up; to raise aloft. Inflamed with wrath, his raging blade he heft. Spenser.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To prove or try the weight of by raising. [Colloq.]",
          "partOfSpeech": "verb"
        }
      ],

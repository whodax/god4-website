    "beforehand": {
      "word": "BEFOREHAND",
      "definitions": [
        {
          "text": "In a state of anticipation ore preoccupation; in advance; -- often followed by with. Agricola . . . resolves to be beforehand with the danger. Milton. The last cited author has been beforehand with me. Addison.",
          "partOfSpeech": "adverb"
        },
        {
          "text": "By way of preparation, or preliminary; previously; aforetime. They may be taught beforehand the skill of speaking. Hooker.",
          "partOfSpeech": "adverb"
        },
        {
          "text": "In comfortable circumstances as regards property; forehanded. Rich and much beforehand. Bacon.",
          "partOfSpeech": "adjective"
        }
      ],

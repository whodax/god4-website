    "fondling": {
      "word": "FONDLING",
      "definitions": [
        {
          "text": "The act of caressing; manifestation of tenderness. Cyrus made no . . . amorous fondling To fan her pride, or melt her guardless heart. Mickle.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A person or thing fondled or caressed; one treated with foolish or doting affection. Fondlings are in danger to be made fools. L'Estrange.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A fool; a simpleton; a ninny. [Obs.] Chapman.",
          "partOfSpeech": "noun"
        }

    "fond": {
      "word": "FOND",
      "definitions": [
        {
          "text": "imp. of Find. Found. Chaucer.",
          "partOfSpeech": ""
        },
        {
          "text": "Foolish; silly; simple; weak. [Archaic] Grant I may never prove so fond To trust man on his oath or bond. Shak.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Foolishly tender and loving; weakly indulgent; over-affectionate.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Affectionate; loving; tender; -- in a good sense; as, a fond mother or wife. Addison.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Loving; much pleased; affectionately regardful, indulgent, or desirous; longing or yearning; -- followed by of (formerly also by on). More fond on her than she upon her love. Shak. You are as fond of grief as of your child. Shak. A great traveler, and fond of telling his adventures. Irving.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Doted on; regarded with affection. [R.] Nor fix on fond abodes to circumscribe thy prayer. Byron.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Trifling; valued by folly; trivial. [Obs.] Shak.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "To caress; to fondle. [Obs.] The Tyrian hugs and fonds thee on her breast. Dryden.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To be fond; to dote. [Obs.] Shak.",
          "partOfSpeech": "verb"
        }
      ],

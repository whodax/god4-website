    "fondly": {
      "word": "FONDLY",
      "definitions": [
        {
          "text": "Foolishly. [Archaic] Verstegan (1673). Make him speak fondly like a frantic man. Shak.",
          "partOfSpeech": "adverb"
        },
        {
          "text": "In a fond manner; affectionately; tenderly. My heart, untarveled, fondly turns to thee. Goldsmith.",
          "partOfSpeech": "adverb"

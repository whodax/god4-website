    "fontanel": {
      "word": "FONTANEL",
      "definitions": [
        {
          "text": "(Med.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "An issue or artificial ulcer for the discharge of humors from the body.[Obs.] Wiseman.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Anat.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "One of the membranous intervals between the incompleted angles of the parietal and neighboring bones of a fetal or young skull; -- so called because it exhibits a rhythmical pulsation. anterior, or bregmatic, situated at the junction of the coronal and sagittal sutures, is much the largest, and remains open a considerable time after birth.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

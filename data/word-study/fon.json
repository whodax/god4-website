    "fondness": {
      "word": "FONDNESS",
      "definitions": [
        {
          "text": "The quality or state of being fond; foolishness. [Obs.] Fondness it were for any, being free, To covet fetters, though they golden be. Spenser.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Doting affection; tender liking; strong appetite, propensity, or relish; as, he had a fondness for truffles. My heart had still some foolish fondness for thee. Addison.",
          "partOfSpeech": "noun"
        }
      ],

      "word": "FIERI FACIAS",
      "definitions": [
        {
          "text": "A judicial writ that lies for one who has recovered in debt or damages, commanding the sheriff that he cause to be made of the goods, chattels, or real estate of the defendant, the sum claimed. Blackstone. Cowell.",
          "partOfSpeech": ""
        }
      ],

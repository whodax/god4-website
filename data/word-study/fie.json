    },
    "fieriness": {
      "word": "FIERINESS",
      "definitions": [
        {
          "text": "The quality of being fiery; heat; acrimony; irritability; as, a fieriness of temper. Addison.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "fiery": {
      "word": "FIERY",
      "definitions": [
        {
          "text": "Consisting of, containing, or resembling, fire; as, the fiery gulf of Etna; a fiery appearance. And fiery billows roll below. I. Watts.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Vehement; ardent; very active; impetuous. Hath thy fiery heart so parched thine entrails Shak. The fiery spirit of his forefathers. W. Irwing.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Passionate; easily provoked; irritable. You kniw the fiery quality of the duke. Shak.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Unrestrained; fierce; mettlesome; spirited. One curbed the fiery steed. Dryden.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "heated by fire, or as if by fire; burning hot; parched; feverish. Pope. The sword which is made fiery. Hooker. Fiery cross, a cross constructed of two firebrands, and pitched upon the point of a spear; formerly in Scotland borne by a runner as a signal for the clan to take up arms. Sir W. Scott.",
          "partOfSpeech": "adjective"
        }
      ],

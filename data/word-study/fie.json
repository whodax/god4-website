    "fierasfer": {
      "word": "FIERASFER",
      "definitions": [
        {
          "text": "A genus of small, slender fishes, remarkable for their habit of living as commensals in other animals. One species inhabits the gill cavity of the pearl oyster near Panama; another lives within an East Indian holothurian.",

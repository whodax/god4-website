    "fierce": {
      "word": "FIERCE",
      "definitions": [
        {
          "text": "Furious; violent; unrestrained; impetuous; as, a fierce wind. His fierce thunder drove us to the deep. Milton.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Vehement in anger or cruelty; ready or eager to kill or injure; of a nature to inspire terror; ferocious. \"A fierce whisper.\" Dickens. \"A fierce tyrant.\" Pope. The fierce foe hung upon our broken rear. Milton. Thou huntest me as a fierce lion. Job. x. 16.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Excessively earnest, eager, or ardent.",
          "partOfSpeech": "adjective"
        }
      ],

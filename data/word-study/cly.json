    "clydesdale": {
      "word": "CLYDESDALE",
      "definitions": [
        {
          "text": "One of a breed of heavy draft horses originally from Clydesdale, Scotland. They are about sixteen hands high and usually brown or bay.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

    "haphtarah": {
      "word": "HAPHTARAH",
      "definitions": [
        {
          "text": "One of the lessons from the Nebiim (or Prophets) read in the Jewish synagogue on Sabbaths, feast days, fasts, and the ninth of Ab, at the end of the service, after the parashoth, or lessons from the Law. Such a practice is evidenced in Luke iv.17 and Acts xiii.15.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

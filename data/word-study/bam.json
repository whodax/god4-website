    "bam": {
      "word": "BAM",
      "definitions": [
        {
          "text": "An imposition; a cheat; a hoax. Garrick. To relieve the tediumbams. Prof. Wilson.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To cheat; to wheedle. [Slang] Foote.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "bambino": {
      "word": "BAMBINO",
      "definitions": [
        {
          "text": "A child or baby; esp., a representation in art of the infant Christ wrapped in swaddling clothes.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "bambocciade": {
      "word": "BAMBOCCIADE",
      "definitions": [
        {
          "text": "A representation of a grotesque scene from common or rustic life.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []

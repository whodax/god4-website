    "dovecot": {
      "word": "DOVECOT; DOVECOTE",
      "definitions": [
        {
          "text": "A small house or box, raised to a considerable height above the ground, and having compartments, in which domestic pigeons breed; a dove house. Like an eagle in a dovecote, I Fluttered your Volscians in Corioli. Shak.",
          "partOfSpeech": "noun"
        }
      ],

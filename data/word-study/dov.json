    "dover'spowder": {
      "word": "DOVER'S POWDER",
      "definitions": [
        {
          "text": "A powder of ipecac and opium, compounded, in the United States, with sugar of milk, but in England (as formerly in the United States) with sulphate of potash, and in France (as in Dr. Dover's original prescription) with nitrate and sulphate of potash and licorice. It is an anodyne diaphoretic.",
          "partOfSpeech": ""
        }
      ],
      "relatedWords": []
    },

        }
      ],
      "relatedWords": []
    },
    "aha": {
      "word": "AHA",
      "definitions": [
        {
          "text": "An exclamation expressing, by different intonations, triumph, mixed with derision or irony, or simple surprise.",
          "partOfSpeech": "interjection"
        },
        {
          "text": "A sunk fence. See Ha-ha. Mason.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "ahead": {
      "word": "AHEAD",
      "definitions": [
        {
          "text": "In or to the front; in advance; onward. The island bore but a little ahead of us. Fielding.",
          "partOfSpeech": "adverb"
        },
        {
          "text": "Headlong; without restraint. [Obs.] L'Estrange. To go ahead. (a) To go in advance. (b) To go on onward. (c) To push on in an enterprise. [Colloq] -- To get ahead of. (a) To get in advance of. (b) To surpass; to get the better of. [Colloq.]",
          "partOfSpeech": "adverb"
        }
      ],

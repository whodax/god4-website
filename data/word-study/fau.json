    "faucal": {
      "word": "FAUCAL",
      "definitions": [
        {
          "text": "Pertaining to the fauces, or opening of the throat; faucial; esp., (Phon.) produced in the fauces, as certain deep guttural sounds found in the Semitic and some other languages. Ayin is the most difficult of the faucals. I. Taylor (The Alphabet).",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "fauces": {
      "word": "FAUCES",
      "definitions": [
        {
          "text": "(Anat.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "The narrow passage from the mouth to the pharynx, situated between the soft palate and the base of the tongue; -- called also the isthmus of the fauces. On either side of the passage two membranous folds, called the pillars of the fauces, inclose the tonsils.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Bot.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "The throat of a calyx, corolla, etc.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Zoöl.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "That portion of the interior of a spiral shell which can be seen by looking into the aperture.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "faucet": {
      "word": "FAUCET",
      "definitions": [
        {
          "text": "A fixture for drawing a liquid, as water, molasses, oil, etc., from a pipe, cask, or other vessel, in such quantities as may be desired; -- called also tap, and cock. It consists of a tubular spout, stopped with a movable plug, spigot, valve, or slide.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The enlarged end of a section of pipe which receives the spigot end of the next section.",
          "partOfSpeech": "noun"
        }
      ],

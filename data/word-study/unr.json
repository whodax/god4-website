  "entries": {
    "unravel": {
      "word": "UNRAVEL",
      "definitions": [
        {
          "text": "To disentangle; to disengage or separate the threads of; as, to unravel a stocking.",
          "partOfSpeech": "verb"
        },
        {
          "text": "Hence, to clear from complication or difficulty; to unfold; to solve; as, to unravel a plot.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To separate the connected or united parts of; to throw into disorder; to confuse. \"Art shall be conjured for it, and nature all unraveled.\" Dryden.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To become unraveled, in any sense.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "unravelment": {
      "word": "UNRAVELMENT",
      "definitions": [

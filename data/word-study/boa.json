    "boarding": {
      "word": "BOARDING",
      "definitions": [
        {
          "text": "(Naut.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "The act of entering a ship, whether with a hostile or a friendly purpose. Both slain at one time, as they attempted the boarding of a frigate. Sir F. Drake.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The act of covering with boards; also, boards, collectively; or a covering made of boards.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The act of supplying, or the state of being supplied, with regular or specified meals, or with meals and lodgings, for pay. Boarding house, a house in which boarders are kept. erected at the side of a ship to prevent an enemy from boarding it. vessel, or in repelling an attempt to board it. Totten. lodging as well as instruction.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "boarish": {

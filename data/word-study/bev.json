    "bevy": {
      "word": "BEVY",
      "definitions": [
        {
          "text": "A company; an assembly or collection of persons, especially of ladies. What a bevy of beaten slaves have we here ! Beau. & Fl.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A flock of birds, especially quails or larks; also, a herd of roes.",

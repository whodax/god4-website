    "hesperornis": {
      "word": "HESPERORNIS",
      "definitions": [
        {
          "text": "A genus of large, extinct, wingless birds from the Cretaceous deposits of Kansas, belonging to the Odontornithes. They had teeth, and were essentially carnivorous swimming ostriches. Several species are known. See Illust. in Append.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "hesperus": {
      "word": "HESPERUS",
      "definitions": [
        {
          "text": "Venus when she is the evening star; Hesper.",
          "partOfSpeech": "noun"
        },
        {

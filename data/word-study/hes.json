    "hesperides": {
      "word": "HESPERIDES",
      "definitions": [
        {
          "text": "(Class. Myth.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "The daughters of Hesperus, or Night (brother of Atlas), and fabled possessors of a garden producing golden apples, in Africa, at the western extremity of the known world. To slay the guarding dragon and get some of these apples was one of the labors of Hercules. Called also Atlantides.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The garden producing the golden apples. It not love a Hercules, Still climbing trees in the Hesperides Shak.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "hesperidin": {
      "word": "HESPERIDIN",

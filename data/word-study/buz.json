    "buzzer": {
      "word": "BUZZER",
      "definitions": [
        {
          "text": "One who, or that which, buzzes; a whisperer; a talebearer. And wants not buzzers to infect his ear With pestilent speeches of his father's death. Shak.",
          "partOfSpeech": "noun"
        }

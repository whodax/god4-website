    "buzzard": {
      "word": "BUZZARD",
      "definitions": [
        {
          "text": "(Zoöl.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A bird of prey of the Hawk family, belonging to the genus Buteo and related genera. American species (of which the most common are B. borealis, B. Pennsylvanicus, and B. lineatus) are usually called hen hawks. apivorus) feeds on bees and their larvæ, with other insects, and reptiles. buzzard, and Carrion buzzard. Bald buzzard, the fishhawk or osprey. See Fishhawk.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A blockhead; a dunce. It is common, to a proverb, to call one who can not be taught, or who continues obstinately ignorant, a buzzard. Goldsmith.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Senseless; stupid. [R.& Obs.] Milton.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "buzzardet": {
      "word": "BUZZARDET",

    "pah": {
      "word": "PAH",
      "definitions": [
        {
          "text": "An exclamation expressing disgust or contempt. See Bah. Fie! fie! fie! pah! pah! Give me an ounce of civet, good apothecary, to sweeten my imagination. Shak.",
          "partOfSpeech": "interjection"
        },
        {
          "text": "A kind of stockaded intrenchment. [New Zealand.] Farrow.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

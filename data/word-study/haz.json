    "haze": {
      "word": "HAZE",
      "definitions": [
        {
          "text": "Light vapor or smoke in the air which more or less impedes vision, with little or no dampness; a lack of transparency in the air; hence, figuratively, obscurity; dimness. O'er the sky The silvery haze of summer drawn. Tennyson. Above the world's uncertain haze. Keble.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To be hazy, or tick with haze. Ray.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To harass by exacting unnecessary, disagreeable, or difficult work.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To harass or annoy by playing abusive or shameful tricks upon; to humiliate by practical jokes; -- used esp. of college students; as, the sophomores hazed a freshman.",
          "partOfSpeech": "verb"
        }
      ],

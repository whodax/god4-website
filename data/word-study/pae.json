    "paean": {
      "word": "PAEAN",
      "definitions": [
        {
          "text": "An ancient Greek hymn in honor of Apollo as a healing deity, and, later, a song addressed to other deities.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Any loud and joyous song; a song of triumph. Dryden. \"Public pæans of congratulation.\" De Quincey.",
          "partOfSpeech": "noun"
        },
        {
          "text": "See Pæon.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

    "bewail": {
      "word": "BEWAIL",
      "definitions": [
        {
          "text": "To express deep sorrow for, as by wailing; to lament; to wail over. Hath widowed and unchilded many a one, Which to this hour bewail the injury. Shak.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To express grief; to lament. Shak.",
          "partOfSpeech": "verb"
        }
      ],

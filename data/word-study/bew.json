    "bewitch": {
      "word": "BEWITCH",
      "definitions": [
        {
          "text": "To gain an ascendency over by charms or incantations; to affect (esp. to injure) by witchcraft or sorcery. See how I am bewitched; behold, mine arm Is like a blasted sapling withered up. Shak.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To charm; to fascinate; to please to such a degree as to take away the power of resistance; to enchant. The charms of poetry our souls bewitch. Dryden.",
          "partOfSpeech": "verb"
        }
      ],

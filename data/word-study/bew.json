    "beware": {
      "word": "BEWARE",
      "definitions": [
        {
          "text": "To be on one's guard; to be cautious; to take care; -- commonly followed by of or lest before the thing that is to be avoided. Beware of all, but most beware of man ! Pope. Beware the awful avalanche. Longfellow.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To have a special regard; to heed. [Obs.] Behold, I send an Angel before thee. . . . Beware of him, and obey his voice. Ex. xxiii. 20, 21. wary, which is an adjective. \"Be ye war of false prophetis.\" Wyclif, Matt. vii. 15. It is used commonly in the imperative and infinitive modes, and with such auxiliaries (shall, should, must, etc.) as go with the infinitive.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To avoid; to take care of; to have a care for. [Obs.] \"Priest, beware your beard.\" Shak. To wish them beware the son. Milton.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "bewash": {

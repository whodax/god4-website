    "hoary": {
      "word": "HOARY",
      "definitions": [
        {
          "text": "White or whitish.\"The hoary willows.\" Addison.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "White or gray with age; hoar; as, hoary hairs. Reverence the hoary head. Dr. T. Dwight.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Hence, remote in time past; as, hoary antiquity.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Moldy; mossy; musty. [Obs.] Knolles.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Zoöl.)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Of a pale silvery gray.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Bot.)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Covered with short, dense, grayish white hairs; canescent. Hoary bat (Zoöl.), an American bat (Atalapha cinerea), having the hair yellowish, or brown, tipped with white.",
          "partOfSpeech": "adjective"
        }
      ],

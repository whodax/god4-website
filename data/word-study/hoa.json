    "hoarding": {
      "word": "HOARDING",
      "definitions": [
        {
          "text": "(Arch.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A screen of boards inclosing a house and materials while builders are at work. [Eng.] Posted on every dead wall and hoarding. London Graphic.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A fence, barrier, or cover, inclosing, surrounding, or concealing something. The whole arrangement was surrounded by a hoarding, the space within which was divided into compartments by sheets of tin. Tyndall.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

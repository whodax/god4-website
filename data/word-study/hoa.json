    "hoarfrost": {
      "word": "HOARFROST",
      "definitions": [
        {
          "text": "The white particles formed by the congelation of dew; white frost. [Written also horefrost. See Hoar, a.] He scattereth the hoarfrost like ashes. Ps. cxlvii. 16.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []

    "hoarse": {
      "word": "HOARSE",
      "definitions": [
        {
          "text": "Having a harsh, rough, grating voice or sound, as when affected with a cold; making a rough, harsh cry or sound; as, the hoarse raven. The hoarse resounding shore. Dryden.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Harsh; grating; discordant; -- said of any sound.",
          "partOfSpeech": "adjective"
        }
      ],

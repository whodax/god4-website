    "hoa": {
      "word": "HO; HOA",
      "definitions": [
        {
          "text": "A stop; a halt; a moderation of pace. There is no ho with them. Decker.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Halloo! attend! -- a call to excite attention, or to give notice of approach. \"What noise there, ho\" Shak. \"Ho! who's within\" Shak.",
          "partOfSpeech": "interjection"
        },
        {
          "text": "Etym: [Perhaps corrupted fr. hold; but cf. F. hau stop! and E. whoa.]",
          "partOfSpeech": "interjection"
        },
        {
          "text": "Stop! stand still! hold! -- a word now used by teamsters, but formerly to order the cessation of anything. [Written also whoa, and, formerly, hoo.] The duke . . . pulled out his sword and cried \"Hoo!\" Chaucer. An herald on a scaffold made an hoo. Chaucer.",
          "partOfSpeech": "interjection"
        }
      ],
      "relatedWords": []
    },
    "hoar": {
      "word": "HOAR",
      "definitions": [
        {
          "text": "White, or grayish white: as, hoar frost; hoar cliffs. \"Hoar waters.\" Spenser.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Gray or white with age; hoary. Whose beard with age is hoar. Coleridge. Old trees with trunks all hoar. Byron.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Musty; moldy; stale. [Obs.] Shak.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Hoariness; antiquity. [R.] Covered with the awful hoar of innumerable ages. Burke.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To become moldy or musty. [Obs.] Shak.",
          "partOfSpeech": "verb"
        }
      ],

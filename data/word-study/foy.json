    "foy": {
      "word": "FOY",
      "definitions": [
        {
          "text": "Faith; allegiance; fealty. [Obs.] Spenser.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A feast given by one about to leave a place. [Obs.] He did at the Dog give me, and some other friends of his, his foy, he being to set sail to-day. Pepys.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

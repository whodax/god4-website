    "bugle": {
      "word": "BUGLE",
      "definitions": [
        {
          "text": "A sort of wild ox; a buffalo. E. Phillips.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A horn used by hunters.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Mus.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A copper instrument of the horn quality of tone, shorter and more conical that the trumpet, sometimes keyed; formerly much used in military bands, very rarely in the orchestra; now superseded by the cornet; -- called also the Kent bugle.",
          "partOfSpeech": "noun"
        },
        {
          "text": "An elingated glass bead, of various colors, though commonly black.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Jet black. \"Bugle eyeballs.\" Shak.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "A plant of the genus Ajuga of the Mint family, a native of the Old World. Yellow bugle, the Ajuga chamæpitys.",
          "partOfSpeech": "noun"
        }
      ],

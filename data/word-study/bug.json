    "bugaboo": {
      "word": "BUGABOO; BUGBEAR",
      "definitions": [
        {
          "text": "Something frightful, as a specter; anything imaginary that causes needless fright; something used to excite needless fear; also, something really dangerous, used to frighten children, etc. \"Bugaboos to fright ye.\" Lloyd. But, to the world no bugbear is so great As want of figure and a small estate. Pope. The bugaboo of the liberals is the church pray. S. B. Griffin. The great bugaboo of the birds is the owl. J. Burroughs.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "bugbane": {
      "word": "BUGBANE",
      "definitions": [
        {
          "text": "A perennial white-flowered herb of the order Ranunculaceæ and genus Cimiciguga; bugwort. There are several species.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "bugbear": {
      "word": "BUGABOO; BUGBEAR",
      "definitions": [
        {
          "text": "Something frightful, as a specter; anything imaginary that causes needless fright; something used to excite needless fear; also, something really dangerous, used to frighten children, etc. \"Bugaboos to fright ye.\" Lloyd. But, to the world no bugbear is so great As want of figure and a small estate. Pope. The bugaboo of the liberals is the church pray. S. B. Griffin. The great bugaboo of the birds is the owl. J. Burroughs.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Same as Bugaboo.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Causing needless fright. Locke.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To alarm with idle phantoms.",
          "partOfSpeech": "verb"
        }
      ],

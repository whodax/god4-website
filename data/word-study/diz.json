    "dizzy": {
      "word": "DIZZY",
      "definitions": [
        {
          "text": "Having in the head a sensation of whirling, with a tendency to fall; vertiginous; giddy; hence, confused; indistinct. Alas! his brain was dizzy. Drayton.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Causing, or tending to cause, giddiness or vertigo. To climb from the brink of Fleet Ditch by a dizzy ladder. Macaulay.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Without distinct thought; unreflecting; thoughtless; heedless. \"The dizzy multitude.\" Milton.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "To make dizzy or giddy; to give the vertigo to; to confuse. If the jangling of thy bells had not dizzied thy understanding. Sir W. Scott.",
          "partOfSpeech": "verb"
        }
      ],

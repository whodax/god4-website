    "caesarism": {
      "word": "CAESARISM",
      "definitions": [
        {
          "text": "A system of government in which unrestricted power is exercised by a single person, to whom, as Cæsar or emperor, it has been committed by the popular will; imperialism; also, advocacy or support of such a system of government. an expression of the claims and political views of that emperor, and of the politicians of his court.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "caesious": {
      "word": "CAESIOUS",
      "definitions": [
        {
          "text": "Of the color of lavender; pale blue with a slight mixture of gray. Lindley.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "caesium": {
      "word": "CAESIUM",
      "definitions": [
        {
          "text": "A rare alkaline metal found in mineral water; -- so called from the two characteristic blue lines in its spectrum. It was the first element discovered by spectrum analysis, and is the most strongly basic and electro-positive substance known. Symbol Cs. Atomic weight 132.6.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "caespitose": {

    "caesarean": {
      "word": "CAESAREAN; CAESARIAN",
      "definitions": [
        {
          "text": "Of or pertaining to Cæsar or the Cæsars; imperial. Cæsarean section (Surg.), the operation of taking a child from the womb by cutting through the walls of the abdomen and uterus; -- so called because Julius Cæsar is reported to have been brought into the world by such an operation.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "caesarian": {
      "word": "CAESAREAN; CAESARIAN",
      "definitions": [
        {
          "text": "Of or pertaining to Cæsar or the Cæsars; imperial. Cæsarean section (Surg.), the operation of taking a child from the womb by cutting through the walls of the abdomen and uterus; -- so called because Julius Cæsar is reported to have been brought into the world by such an operation.",
          "partOfSpeech": "adjective"
        }

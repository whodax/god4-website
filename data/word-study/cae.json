    "caecal": {
      "word": "CAECAL",
      "definitions": [
        {
          "text": "Of or pertaining to the cæcum, or blind gut.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Having the form of a cæcum, or bag with one opening; baglike; as, the cæcal extremity of a duct.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "caecias": {
      "word": "CAECIAS",
      "definitions": [
        {
          "text": "A wind from the northeast. Milton.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "caecilian": {
      "word": "CAECILIAN",
      "definitions": [
        {
          "text": "A limbless amphibian belonging to the order Cæciliæ or Ophimorpha. See Ophiomorpha. [Written also coecilian.]",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

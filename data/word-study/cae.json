    "caesar": {
      "word": "CAESAR",
      "definitions": [
        {
          "text": "A Roman emperor, as being the successor of Augustus Cæsar. Hence, a kaiser, or emperor of Germany, or any emperor or powerful ruler. See Kaiser, Kesar. Malborough anticipated the day when he would be servilely flattered and courted by Cæsar on one side and by Louis the Great on the other. Macaulay.",
          "partOfSpeech": "noun"
        }
      ],

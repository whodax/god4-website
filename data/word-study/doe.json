    "doejohn": {
      "word": "DOE, JOHN",
      "definitions": [
        {
          "text": "The fictitious lessee acting as plaintiff in the common-law action of ejectment, the fictitious defendant being usually denominated Richard Roe. Hence, a fictitious name for a party, real or fictitious, to any action or proceeding.",
          "partOfSpeech": ""
        }
      ],
      "relatedWords": []
    },
    "doer": {
      "word": "DOER",
      "definitions": [
        {
          "text": "One who does; one performs or executes; one who is wont and ready to act; an actor; an agent. The doers of the law shall be justified. Rom. ii. 13.",
          "partOfSpeech": "verb"
        },
        {
          "text": "(Scots Law)",
          "partOfSpeech": "verb"
        },
        {
          "text": "An agent or attorney; a factor. Burrill.",

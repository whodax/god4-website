    "doe": {
      "word": "DOE",
      "definitions": [
        {
          "text": "A female deer or antelope; specifically, the female of the fallow deer, of which the male is called a buck. Also applied to the female of other animals, as the rabbit. See the Note under Buck.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A feat. [Obs.] See Do, n. Hudibras.",
          "partOfSpeech": "noun"
        }

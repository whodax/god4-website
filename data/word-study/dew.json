    "dewarvessel": {
      "word": "DEWAR VESSEL",
      "definitions": [
        {
          "text": "A double-walled glass vessel for holding liquid air, etc., having the space between the walls exhausted so as to prevent conduction of heat, and sometimes having the glass silvered to prevent absorption of radiant heat; -- called also, according to the particular shape, Dewar bulb, Dewar tube, etc.",
          "partOfSpeech": ""
        }
      ],
      "relatedWords": []
    },
    "dewclaw": {
      "word": "DEWCLAW",
      "definitions": [
        {
          "text": "In any animal, esp. of the Herbivora, a rudimentary claw or small hoof not reaching the ground. Some cut off the dewclaws [of greyhounds]. J. H. Walsh.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "dewdrop": {
      "word": "DEWDROP",
      "definitions": [
        {
          "text": "A drop of dew. Shak.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "dewfall": {
      "word": "DEWFALL",
      "definitions": [
        {
          "text": "The falling of dew; the time when dew begins to fall.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "dewiness": {
      "word": "DEWINESS",
      "definitions": [
        {
          "text": "State of being dewy.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "dewlap": {
      "word": "DEWLAP",
      "definitions": [
        {
          "text": "The pendulous skin under the neck of an ox, which laps or licks the dew in grazing.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The flesh upon the human throat, especially when with age. [Burlesque] On her withered dewlap pour the ale. Shak.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "dewlapped": {
      "word": "DEWLAPPED",
      "definitions": [
        {
          "text": "Furnished with a dewlap.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "dewless": {
      "word": "DEWLESS",
      "definitions": [
        {
          "text": "Having no dew. Tennyson.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "dewpoint": {
      "word": "DEW-POINT",
      "definitions": [
        {
          "text": "The temperature at which dew begins to form. It varies with the humidity and temperature of the atmosphere.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "dewret": {
      "word": "DEWRET",
      "definitions": [
        {
          "text": "To ret or rot by the process called dewretting.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "dewretting": {
      "word": "DEWRETTING",
      "definitions": [
        {
          "text": "Dewrotting; the process of decomposing the gummy matter of flax and hemp and setting the fibrous part, by exposure on a sward to dew, rain, and sunshine.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "dewrot": {
      "word": "DEWROT",
      "definitions": [
        {
          "text": "To rot, as flax or hemp, by exposure to rain, dew, and sun. See Dewretting.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "dewworm": {
      "word": "DEWWORM",
      "definitions": [
        {
          "text": "See Earthworm.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "dewy": {
      "word": "DEWY",
      "definitions": [
        {
          "text": "Pertaining to dew; resembling, consisting of, or moist with, dew. A dewy mist Went and watered all the ground. Milton. When dewy eve her curtain draws. Keble.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Falling gently and beneficently, like the dew. Dewy sleep ambrosial. Cowper.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Bot.)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Resembling a dew-covered surface; appearing as if covered with dew.",
          "partOfSpeech": "adjective"
        }
      ],

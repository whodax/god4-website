    "unvalued": {
      "word": "UNVALUED",
      "definitions": [
        {
          "text": "Not valued; not appraised; hence, not considered; disregarded; valueless; as, an unvalued estate. \"Unvalued persons.\" Shak.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Having inestimable value; invaluable. [Obs.] The golden apples of unvalued price. Spenser.",
          "partOfSpeech": "adjective"
        }

    "hobble": {
      "word": "HOBBLE",
      "definitions": [
        {
          "text": "To walk lame, bearing chiefly on one leg; to walk with a hitch or hop, or with crutches. The friar was hobbling the same way too. Dryden.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To move roughly or irregularly; -- said of style in writing. Prior. The hobbling versification, the mean diction. Jeffreys.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To fetter by tying the legs; to hopple; to clog. \" They hobbled their horses.\" Dickens",
          "partOfSpeech": "verb"
        },
        {
          "text": "To perplex; to embarrass.",
          "partOfSpeech": "verb"
        },
        {
          "text": "An unequal gait; a limp; a halt; as, he has a hobble in his gait. Swift.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Same as Hopple.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Difficulty; perplexity; embarrassment. Waterton.",
          "partOfSpeech": "noun"
        }
      ],

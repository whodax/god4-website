    "hobnob": {
      "word": "HOBNOB",
      "definitions": [
        {
          "text": "Have or have not; -- a familiar invitation to reciprocal drinking. Shak.",
          "partOfSpeech": "adverb"
        },
        {
          "text": "At random; hit or miss. (Obs.) Holinshed.",
          "partOfSpeech": "adverb"
        },
        {
          "text": "To drink familiarly (with another). [ Written also hob-a-nob.]",
          "partOfSpeech": "verb"
        },
        {
          "text": "To associate familiarly; to be on intimate terms.",
          "partOfSpeech": "verb"
        },
        {
          "text": "Familiar, social intercourse. W. Black.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

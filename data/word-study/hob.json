    "hobblebush": {
      "word": "HOBBLEBUSH",
      "definitions": [
        {
          "text": "A low bush (Viburnum lantanoides) having long, straggling branches and handsome flowers. It is found in the Northern United States. Called also shinhopple.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "hobbledehoyhobbletehoy": {
      "word": "HOBBLEDEHOY; HOBBLETEHOY",
      "definitions": [
        {
          "text": "A youth between boy and man; an awkward, gawky young fellow . [Colloq.] All the men, boys, and hobbledehoys attached to the farm. Dickens. .",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "hobbler": {
      "word": "HOBBLER",
      "definitions": [
        {
          "text": "One who hobbles.",
          "partOfSpeech": "noun"
        },
        {
          "text": "One who by his tenure was to maintain a horse for military service; a kind of light horseman in the Middle Ages who was mounted on a hobby. Hallam. Sir J. Davies.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "hobblingly": {

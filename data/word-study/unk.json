    "unke": {
      "word": "UNKE",
      "definitions": [
        {
          "text": "A European aquatic toad (Bombinator igneus). Its back is dark; its belly is marked with crimson. Called also feuerkröte.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "unked": {
      "word": "UNKED",
      "definitions": [
        {
          "text": "Odd; strange; ugly; old; uncouth. [Prov. Eng.]",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Lonely; dreary; unkard. [Prov. Eng.] Weston is sadly unked without you. Cowper.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "unkemmed": {
      "word": "UNKEMMED",
      "definitions": [
        {
          "text": "Unkempt. [Obs.]",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "unkempt": {
      "word": "UNKEMPT",
      "definitions": [
        {
          "text": "Not combed; disheveled; as, an urchin with unkempt hair.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Fig.; Not smoothed; unpolished; rough. My rhymes be rugged and unkempt. Spenser.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "unkennel": {
      "word": "UNKENNEL",
      "definitions": [
        {
          "text": "To drive from a kennel or hole; as, to unkennel a fox.",
          "partOfSpeech": "verb"
        },
        {
          "text": "Fig.: To discover; to disclose. Shak.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "unkent": {
      "word": "UNKENT",
      "definitions": [
        {
          "text": "Unknown; strange. [Obs. or Scot.] W. Browne.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "unketh": {
      "word": "UNKETH",
      "definitions": [
        {
          "text": "Uncouth. [Obs. or Prov. Eng.]",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "unkind": {
      "word": "UNKIND",
      "definitions": [
        {
          "text": "Having no race or kindred; childless. [Obs. & R.] Shak.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Not kind; contrary to nature, or the law of kind or kindred; unnatural. [Obs.] \"Such unkind abominations.\" Chaucer.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Wanting in kindness, sympathy, benevolence, gratitude, or the like; cruel; harsh; unjust; ungrateful. He is unkind that recompenseth not; but he is most unkind that forgetteth. Sir T. Elyot.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "unkindliness": {
      "word": "UNKINDLINESS",
      "definitions": [
        {
          "text": "Unkindness. Tennyson.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "unkindly": {
      "word": "UNKINDLY",
      "definitions": [
        {
          "text": "Not kindly; unkind; ungracious.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Unnatural; contrary to nature. [Obs.] \"Unkindly crime.\" Spenser.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Unfavorable; annoying; malignant. Milton.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "unkindred": {
      "word": "UNKINDRED",
      "definitions": [
        {
          "text": "Not kindred; not of the same kin. [Obs.] Rowe.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "unking": {
      "word": "UNKING",
      "definitions": [
        {
          "text": "To cause to cease to be a king. [R.] Shall his condescension, therefore, unking him South.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "unkingship": {
      "word": "UNKINGSHIP",
      "definitions": [
        {
          "text": "The quality or condition of being unkinged; abolition of monarchy. [Obs.] Unkingship was proclaimed, and his majesty's statues thrown down. Evelyn.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "unkiss": {
      "word": "UNKISS",
      "definitions": [
        {
          "text": "To cancel or annul what was done or sealed by a kiss; to cancel by a kiss. [Obs.] Let me unkiss the oath 'twixt thee and me. Shak.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "unkle": {
      "word": "UNKLE",
      "definitions": [
        {
          "text": "See Uncle. [Obs.]",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "unknight": {
      "word": "UNKNIGHT",
      "definitions": [
        {
          "text": "To deprive of knighthood. Fuller.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "unknit": {
      "word": "UNKNIT",
      "definitions": [
        {
          "text": "To undo or unravel what is knitted together. Fie, fie! unknit that threatening unkind brow. Shak.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "unknot": {
      "word": "UNKNOT",
      "definitions": [
        {
          "text": "To free from knots; to untie.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "unknow": {
      "word": "UNKNOW",
      "definitions": [
        {
          "text": "To cease to know; to lose the knowledge of. [Obs.]",
          "partOfSpeech": "verb"
        },
        {
          "text": "To fail of knowing; to be ignorant of. [Obs.]",
          "partOfSpeech": "verb"
        },
        {
          "text": "Unknown. [Obs.] \"French of Paris was to her unknow.\" Chaucer.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "unknowledged": {
      "word": "UNKNOWLEDGED",
      "definitions": [
        {
          "text": "Not acknowledged or recognized. [Obs.] For which bounty to us lent Of him unknowledged or unsent. B. Jonson.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "unknown": {
      "word": "UNKNOWN",
      "definitions": [
        {
          "text": "Not known; not apprehended.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    }
  }

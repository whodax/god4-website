    "exogamous": {
      "word": "EXOGAMOUS",
      "definitions": [
        {
          "text": "Relating to exogamy; marrying outside of the limits of one's own tribe; -- opposed to endogenous.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "exogamy": {
      "word": "EXOGAMY",
      "definitions": [
        {
          "text": "The custom, or tribal law, which prohibits marriage between members of the same tribe; marriage outside of the tribe; -- opposed to endogamy. Lubbock.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "exogen": {
      "word": "EXOGEN",
      "definitions": [
        {
          "text": "A plant belonging to one of the greater part of the vegetable kingdom, and which the plants are characterized by having c wood bark, and pith, the wood forming a layer between the other two, and increasing, if at all, by the animal addition of a new layer to the outside next to the bark. The leaves are commonly netted-veined, and the number of cotyledons is two, or, very rarely, several in a whorl. Cf. Endogen. Gray.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "exogenetic": {
      "word": "EXOGENETIC",
      "definitions": [
        {
          "text": "Arising or growing from without; exogenous.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "exogenous": {
      "word": "EXOGENOUS",
      "definitions": [
        {
          "text": "(Bot.)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Pertaining to, or having the character of, an exogen; -- the opposite of endogenous.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Biol.)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Growing by addition to the exterior.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Anat.)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Growing from previously ossified parts; -- opposed to autogenous. Owen. Exogenous aneurism (Med.), an aneurism which is produced by causes acting from without, as from injury.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },

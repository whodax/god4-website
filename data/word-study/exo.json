    "exorcise": {
      "word": "EXORCISE",
      "definitions": [
        {
          "text": "To cast out, as a devil, evil spirits, etc., by conjuration or summoning by a holy name, or by certain ceremonies; to expel (a demon) or to conjure (a demon) to depart out of a person possessed by one. He impudently excorciseth devils in the church. Prynne.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To deliver or purify from the influence of an evil spirit or demon. Exorcise the beds and cross the walls. Dryden. Mr. Spectator . . . do all you can to exorcise crowds who are . . . processed as I am. Spectator.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []

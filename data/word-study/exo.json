    "exode": {
      "word": "EXODE",
      "definitions": [
        {
          "text": "Departure; exodus; esp., the exodus of the Israelites from Egypt.",
          "partOfSpeech": ""
        },
        {
          "text": "(Gr. Drama)",
          "partOfSpeech": ""
        },
        {
          "text": "The final chorus; the catastrophe.",
          "partOfSpeech": ""
        },
        {
          "text": "(Rom. Antig.)",
          "partOfSpeech": ""
        },
        {
          "text": "An afterpiece of a comic description, either a farce or a travesty.",
          "partOfSpeech": ""

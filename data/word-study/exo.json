    "exonerate": {
      "word": "EXONERATE",
      "definitions": [
        {
          "text": "To unload; to disburden; to discharge. [Obs.] All exonerate themselves into one common duct. Ray.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To relieve, in a moral sense, as of a charge, obligation, or load of blame resting on one; to clear of something that lies upon oppresses one, as an accusation or imputation; as, to exonerate one's self from blame, or from the charge of avarice. Burke.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To discharge from duty or obligation, as a ball.",
          "partOfSpeech": "verb"
        }
      ],

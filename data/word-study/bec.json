    "beck": {
      "word": "BECK",
      "definitions": [
        {
          "text": "See Beak. [Obs.] Spenser.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A small brook. The brooks, the becks, the rills. Drayton.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A vat. See Back.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To nod, or make a sign with the head or hand. [Archaic] Drayton.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To notify or call by a nod, or a motion of the head or hand; to intimate a command to. [Archaic] When gold and silver becks me to come on. Shak.",
          "partOfSpeech": "verb"
        },
        {
          "text": "A significant nod, or motion of the head or hand, esp. as a call or command. They have troops of soldiers at their beck. Shak.",
          "partOfSpeech": "noun"
        }
      ],

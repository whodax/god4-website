    "maw": {
      "word": "MAW",
      "definitions": [
        {
          "text": "A gull.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A stomach; the receptacle into which food is taken by swallowing; in birds, the craw; -- now used only of the lower animals, exept humorously or in contempt. Chaucer. Bellies and maws of living creatures. Bacon.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Appetite; inclination. [Obs.] Unless you had more maw to do me good. Beau. & Fl. Fish maw. (Zoöl.) See under Fish.",
          "partOfSpeech": "noun"
        },
        {
          "text": "An old game at cards. Sir A. Weldon.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

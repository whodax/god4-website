    "fabricate": {
      "word": "FABRICATE",
      "definitions": [
        {
          "text": "To form into a whole by uniting its parts; to frame; to construct; to build; as, to fabricate a bridge or ship.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To form by art and labor; to manufacture; to produce; as, to fabricate woolens.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To invent and form; to forge; to devise falsely; as, to fabricate a lie or story. Our books were not fabricated with an accomodation to prevailing usages. Paley.",
          "partOfSpeech": "verb"
        }
      ],

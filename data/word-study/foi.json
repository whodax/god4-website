    "foible": {
      "word": "FOIBLE",
      "definitions": [
        {
          "text": "Weak; feeble. [Obs.] Lord Herbert.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "A moral weakness; a failing; a weak point; a frailty. A disposition radically noble and generous, clouded and overshadowed by superficial foibles. De Quincey.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The half of a sword blade or foil blade nearest the point; -- opposed to forte. [Written also faible.] defect. See Fault.",
          "partOfSpeech": "noun"
        }
      ],

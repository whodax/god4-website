    "ebullition": {
      "word": "EBULLITION",
      "definitions": [
        {
          "text": "A boiling or bubbling up of a liquid; the motion produced in a liquid by its rapid conversion into vapor.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Effervescence occasioned by fermentation or by any other process which causes the liberation of a gas or an aëriform fluid, as in the mixture of an acid with a carbonated alkali. [Formerly written bullition.]",
          "partOfSpeech": "noun"
        },
        {
          "text": "A sudden burst or violent display; an outburst; as, an ebullition of anger or ill temper.",
          "partOfSpeech": "noun"
        }
      ],

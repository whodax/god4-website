      "word": "HAMSTER",
      "definitions": [
        {
          "text": "A small European rodent (Cricetus frumentarius). It is remarkable for having a pouch on each side of the jaw, under the skin, and for its migrations.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "hamstring": {
      "word": "HAMSTRING",
      "definitions": [
        {
          "text": "One of the great tendons situated in each side of the ham, or space back of the knee, and connected with the muscles of the back of the thigh.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To lame or disable by cutting the tendons of the ham or knee; to hough; hence, to cripple; to incapacitate; to disable. So have they hamstrung the valor of the subject by seeking to effeminate us all at home. Milton.",
          "partOfSpeech": "verb"
        }

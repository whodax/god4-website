    "enormity": {
      "word": "ENORMITY",
      "definitions": [
        {
          "text": "The state or quality of exceeding a measure or rule, or of being immoderate, monstrous, or outrageous. The enormity of his learned acquisitions. De Quincey.",
          "partOfSpeech": "noun"
        },
        {
          "text": "That which is enormous; especially, an exceeding offense against order, right, or decency; an atrocious crime; flagitious villainy; an atrocity. These clamorous enormities which are grown too big and strong for law or shame. South.",
          "partOfSpeech": "noun"
        }
      ],

    "hogframe": {
      "word": "HOGFRAME",
      "definitions": [
        {
          "text": "A trussed frame extending fore and aft, usually above deck, and intended to increase the longitudinal strength and stiffness. Used chiefly in American river and lake steamers. Called also hogging frame, and hogback.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

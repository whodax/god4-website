    "hogmanay": {
      "word": "HOGMANAY",
      "definitions": [
        {
          "text": "The old name, in Scotland, for the last day of the year, on which children go about singing, and receive a dole of bread or cakes; also, the entertainment given on that day to a visitor, or the gift given to an applicant. [Scot.]",

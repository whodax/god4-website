    "hogshead": {
      "word": "HOGSHEAD",
      "definitions": [
        {
          "text": "An English measure of capacity, containing 63 wine gallons, or about 52 hogshead of ale was 48 ale gallons. Elsewhere in England the ale and beer hogsheads held 51 gallons. These measures are no longer in use, except for cider.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A large cask or barrel, of indefinite contents; esp. one containing from 100 to 140 gallons. [U. S.]",

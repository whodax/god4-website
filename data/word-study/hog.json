    "hogback": {
      "word": "HOGBACK",
      "definitions": [
        {
          "text": "(Arch.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "An upward curve or very obtuse angle in the upper surface of any member, as of a timber laid horizontally; -- the opposite of camber.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Naut.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "See Hogframe.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Geol.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A ridge formed by tilted strata; hence, any ridge with a sharp summit, and steeply sloping sides.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "hogchain": {
      "word": "HOGCHAIN",
      "definitions": [

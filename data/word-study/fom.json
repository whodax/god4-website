    "fomentation": {
      "word": "FOMENTATION",
      "definitions": [
        {
          "text": "(Med.) (a) The act of fomenting; the application of warm, soft, medicinal substances, as for the purpose of easing pain, by relaxing the skin, or of discussing tumors. (b) The lotion applied to a diseased part.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Excitation; instigation; encouragement. Dishonest fomentation of your pride. Young.",
          "partOfSpeech": "noun"
        }
      ],

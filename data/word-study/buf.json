    "buffoon": {
      "word": "BUFFOON",
      "definitions": [
        {
          "text": "A man who makes a practice of amusing others by low tricks, antic gestures, etc.; a droll; a mimic; a harlequin; a clown; a merry-andrew.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Characteristic of, or like, a buffoon. \"Buffoon stories.\" Macaulay. To divert the audience with buffoon postures and antic dances. Melmoth.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "To act the part of a buffoon. [R.]",
          "partOfSpeech": "verb"
        },
        {
          "text": "To treat with buffoonery. Glanvill.",
          "partOfSpeech": "verb"

    "buffelduck": {
      "word": "BUFFEL DUCK",
      "definitions": [
        {
          "text": "A small duck (Charitonetta albeola); the spirit duck, or butterball. The head of the male is covered with numerous elongated feathers, and thus appears large. Called also bufflehead.",
          "partOfSpeech": ""
        }
      ],
      "relatedWords": []

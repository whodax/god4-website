    "egret": {
      "word": "EGRET",
      "definitions": [
        {
          "text": "(Zoöl.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "The name of several species of herons which bear plumes on the back. They are generally white. Among the best known species are the American egret (Ardea, or Herodias, egretta); the great egret (A. alba); the little egret (A. garzetta), of Europe; and the American snowy egret (A. candidissima). A bunch of egrets killed for their plumage. G. W. Cable.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A plume or tuft of feathers worn as a part of a headdress, or anything imitating such an ornament; an aigrette.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Bot.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "The flying feathery or hairy crown of seeds or achenes, as the down of the thistle.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Zoöl.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A kind of ape.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

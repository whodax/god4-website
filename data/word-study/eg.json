    "egoism": {
      "word": "EGOISM",
      "definitions": [
        {
          "text": "(Philos.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "The doctrine of certain extreme adherents or disciples of Descartes and Johann Gottlieb Fichte, which finds all the elements of knowledge in the ego and the relations which it implies or provides for.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Excessive love and thought of self; the habit of regarding one's self as the center of every interest; selfishness; -- opposed to altruism.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "egoist": {
      "word": "EGOIST",
      "definitions": [
        {
          "text": "One given overmuch to egoism or thoughts of self. I, dullard egoist, taking no special recognition of such nobleness. Carlyle.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Philos.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A believer in egoism.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

    "cluck": {
      "word": "CLUCK",
      "definitions": [
        {
          "text": "To make the noise, or utter the call, of a brooding hen. Ray.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To call together, or call to follow, as a hen does her chickens. She, poor hen, fond of no second brood, Has clucked three to the wars. Shak.",
          "partOfSpeech": "verb"
        },
        {
          "text": "The call of a hen to her chickens.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A click. See 3d Click, 2.",
          "partOfSpeech": "noun"
        }

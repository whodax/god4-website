    "clubhaul": {
      "word": "CLUBHAUL",
      "definitions": [
        {
          "text": "To put on the other tack by dropping the lee anchor as soon as the wind is out of the sails (which brings the vessel's head to the wind), and by cutting the cable as soon as she pays off on the other tack. Clubhauling is attempted only in an exigency.",
          "partOfSpeech": "verb"

    "gnar": {
      "word": "GNAR",
      "definitions": [
        {
          "text": "A knot or gnarl in wood; hence, a tough, thickset man; -- written also gnarr. [Archaic] He was . . . a thick gnarre. Chaucer.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To gnarl; to snarl; to growl; -- written also gnarr. [Archaic] At them he gan to rear his bristles strong, And felly gnarre. Spenser. A thousand wants Gnarr at the heels of men. Tennison.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },

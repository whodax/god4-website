    "fob": {
      "word": "FOB",
      "definitions": [
        {
          "text": "A little pocket for a watch. Fob chain, a short watch chain worn a watch carried in the fob.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To beat; to maul. [Obs.]",
          "partOfSpeech": "transitive verb"
        },
        {
          "text": "To cheat; to trick; to impose on. Shak. To fob off, to shift off by an artifice; to put aside; to delude with a trick.\"A conspiracy of bishops could prostrate and fob off the right of the people.\" Milton.",
          "partOfSpeech": "transitive verb"
        }

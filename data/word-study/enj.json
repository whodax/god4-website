    "enjoy": {
      "word": "ENJOY",
      "definitions": [
        {
          "text": "To take pleasure or satisfaction in the possession or experience of; to feel or perceive with pleasure; to be delighted with; as, to enjoy the dainties of a feast; to enjoy conversation.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To have, possess, and use with satisfaction; to occupy or have the benefit of, as a good or profitable thing, or as something desirable; as, to enjoy a free constitution and religious liberty. That the children of Israel may enjoy every man the inheritance of his fathers. Num. xxxvi. 8. To enjoy the pleasures of sin for a season. Heb. xi. 25.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To have sexual intercourse with. Milton. To enjoy one's self, to feel pleasure; to be happy.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To take satisfaction; to live in happiness. [R.] Milton.",
          "partOfSpeech": "verb"
        }
      ],

    "exhauster": {
      "word": "EXHAUSTER",
      "definitions": [
        {
          "text": "One who, or that which, exhausts or draws out.",
          "partOfSpeech": ""
        }
      ],
      "relatedWords": []
    },
    "exhaustibility": {
      "word": "EXHAUSTIBILITY",
      "definitions": [
        {
          "text": "Capability of being exhausted. I was seriously tormented by the thought of the exhaustibility of musical combinations. J. S. Mill.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "exhaustible": {
      "word": "EXHAUSTIBLE",
      "definitions": [
        {
          "text": "Capable of being exhausted, drained off, or expended. Johnson.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "exhaustion": {
      "word": "EXHAUSTION",
      "definitions": [
        {
          "text": "The act of draining out or draining off; the act of emptying completely of the contents.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The state of being exhausted or emptied; the state of being deprived of strength or spirits.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Math.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "An ancient geometrical method in which an exhaustive process was employed. It was nearly equivalent to the modern method of limits. propositions, pertaining to rectifications and quadratures, now investigated by the calculus.",
          "partOfSpeech": "noun"
        }
      ],

    "docility": {
      "word": "DOCILITY",
      "definitions": [
        {
          "text": "teachableness; aptness for being taught; docibleness. [Obs. or R.]",
          "partOfSpeech": "noun"
        },
        {
          "text": "Willingness to be taught; tractableness. The humble docility of little children is, in the New Testament, represented as a necessary preparative to the reception of the Christian faith. Beattie.",
          "partOfSpeech": "noun"
        }

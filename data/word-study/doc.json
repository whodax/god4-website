    "docibility": {
      "word": "DOCIBILITY; DOCIBLENESS",
      "definitions": [
        {
          "text": "Aptness for being taught; teachableness; docility. To persons of docibility, the real character may be easily taught in a few days. Boyle. The docibleness of dogs in general. Walton.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

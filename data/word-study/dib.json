    "dib": {
      "word": "DIB",
      "definitions": [
        {
          "text": "To dip. [Prov. Eng.] Walton.",
          "partOfSpeech": "verb"
        },
        {
          "text": "One of the small bones in the knee joints of sheep uniting the bones above and below the joints.",
          "partOfSpeech": "noun"
        },
        {
          "text": "pl.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A child's game, played with dib bones.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "dibasic": {
      "word": "DIBASIC",
      "definitions": [
        {
          "text": "Having two acid hydrogen atoms capable of replacement by basic atoms or radicals, in forming salts; bibasic; -- said of acids, as oxalic or sulphuric acids. Cf. Diacid, Bibasic. synonymous; as, tartaric acid is tetravalent and dibasic, lactic acid is divalent but monobasic.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "dibasicity": {
      "word": "DIBASICITY",
      "definitions": [
        {
          "text": "The property or condition of being dibasic.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "dibber": {

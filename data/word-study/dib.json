    "dibble": {
      "word": "DIBBLE",
      "definitions": [
        {
          "text": "A pointed implement used to make holes in the ground in which no set out plants or to plant seeds.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To dib or dip frequently, as in angling. Walton.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To plant with a dibble; to make holes in (soil) with a dibble, for planting.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To make holes or indentations in, as if with a dibble. The clayey soil around it was dibbled thick at the time by the tiny hoofs of sheep. H. Miller.",
          "partOfSpeech": "verb"
        }
      ],

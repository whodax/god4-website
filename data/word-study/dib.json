    "dibranchiata": {
      "word": "DIBRANCHIATA",
      "definitions": [
        {
          "text": "An order of cephalopods which includes those with two gills, an apparatus for emitting an inky fluid, and either eight or ten cephalic arms bearing suckers or hooks, as the octopi and squids. See Cephalopoda.",
          "partOfSpeech": "noun"

    "hew": {
      "word": "HEW",
      "definitions": [
        {
          "text": "To cut with an ax; to fell with a sharp instrument; -- often with down, or off. Shak.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To form or shape with a sharp instrument; to cut; hence, to form laboriously; -- often with out; as, to hew out a sepulcher. Look unto the rock whence ye are hewn. Is. li. 1. Rather polishing old works than hewing out new. Pope.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To cut in pieces; to chop; to hack. Hew them to pieces; hack their bones asunder. Shak.",
          "partOfSpeech": "verb"
        },
        {
          "text": "Destruction by cutting down. [Obs.] Of whom he makes such havoc and such hew. Spenser.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Hue; color. [Obs.] Chaucer.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Shape; form. [Obs.] Spenser.",
          "partOfSpeech": "noun"
        }
      ],

.",[[[[136,139],[140,145]],[11]]],"crosswire-hebrew"],"5":["And the children of Israel removed from Rameses, and pitched in Succoth.",[[[[35,39],[40,47]],[3]]],"crosswire-hebrew"],"6":["And they departed from Succoth, and pitched in Etham, which [is] in the edge of the wilderness.",[[[[18,22],[23,30]],[1]]],"crosswire-hebrew"],"9":["And they removed from Marah, and came unto Elim: and in Elim [were] twelve fountains of water, and threescore and ten palm trees; and they pitched there.",[[[[17,21],[22,27]],[1]],[[[29,32],[33,37]],[2]],[[[118,122],[123,128]],[10]]],"crosswire-hebrew"],"10":["And they removed from Elim, and encamped by the Red sea.",[[[[17,21],[22,26]],[1]]],"crosswire-hebrew"],"13":["And they departed from Dophkah, and encamped in Alush.",[[[[18,22],[23,30]],[1]]],"crosswire-hebrew"],"15":["And they departed from Rephidim, and pitched in the wilderness of Sinai.",[[[[18,22],[23,31]],[1]]],"crosswire-hebrew"],"18":["And they departed from Hazeroth, and pitched in Rithmah.",[[[[18,22],[23,31]],[1]]],"crosswire-hebrew"],"21":["And they removed from Libnah, and pitched at Rissah.",[[[[17,21],[22,28]],[1]],[[[42,44],[45,51]],[3]]],"crosswire-hebrew"],"22":["And they journeyed from Rissah, and pitched in Kehelathah.",[[[[19,23],[24,30]],[1]]],"crosswire-hebrew"],"23":["And they went from Kehelathah, and pitched in mount Shapher.",[[[[14,18],[19,29]],[1]]],"crosswire-hebrew"],"24":["And they removed from mount Shapher, and encamped in Haradah.",[[[[17,21],[22,27]],[1]]],"crosswire-hebrew"],"25":["And they removed from Haradah, and pitched in Makheloth.",[[[[17,21],[22,29]],[1]]],"crosswire-hebrew"],"26":["And they removed from Makheloth, and encamped at Tahath.",[[[[17,21],[22,31]],[1]],[[[46,48],[49,55]],[3]]],"crosswire-hebrew"],"27":["And they departed from Tahath, and pitched at Tarah.",[[[[18,22],[23,29]],[1]]],"crosswire-hebrew"],"30":["And they departed from Hashmonah, and encamped at Moseroth.",[[[[18,22],[23,32]],[1]],[[[47,49],[50,58]],[3]]],"crosswire-hebrew"],"34":["And they removed from Jotbathah, and encamped at Ebronah.",[[[[17,21],[22,31]],[1]]],"crosswire-hebrew"],"42":["And they departed from Zalmonah, and pitched in Punon.",[[[[18,22],[23,31]],[1]]],"crosswire-hebrew"],"43":["And they departed from Punon, and pitched in Oboth.",[[[[18,22],[23,28]],[1]]],"crosswire-hebrew"],"51":["Speak unto the children of Israel, and say unto them, When ye are passed over Jordan into the land of Canaan;",[[[[0,5]],[0]]],"crosswire-hebrew"],"52":["Then ye shall drive out all the inhabitants of the land from before you, and destroy all their pictures, and destroy all their molten images, and quite pluck down all their high places:",[[[[167,172],[173,177],[178,184]],[17]]],"crosswire-hebrew"]},"asv":{"23":["And they journeyed from Kehelathah, and encamped in mount Shepher.",[[[[58,65]],[4]]],"dual-names"],"24":["And they journeyed from mount Shepher, and encamped in Haradah.",[[[[30,37]],[2]]],"dual-names"]},"rv":{"23":["And they journeyed from Kehelathah, and pitched in mount Shepher.",[[[[57,64]],[4]]],"dual-names"],"24":["And they journeyed from mount Shepher, and pitched in Haradah.",[[[[30,37]],[2]]],"dual-names"]},"web":{"24":["They traveled from Mount Shepher, and encamped in Haradah.",[[[[25,32]],[2]]],"dual-names"]}}}

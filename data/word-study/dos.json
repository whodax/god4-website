    "dosage": {
      "word": "DOSAGE",
      "definitions": [
        {
          "text": "(Med.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "The administration of medicine in doses; specif., a scheme or system of grading doses of medicine according to age, etc.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The process of adding some ingredient, as to wine, to give flavor, character, or strength.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "dosdos": {
      "word": "DOS--DOS",
      "definitions": [
        {
          "text": "Back to back; as, to sit dos-à-dos in a dogcart; to dance dos- à-dos, or so that two dancers move forward and pass back to back.",
          "partOfSpeech": "adverb"
        },
        {
          "text": "A sofa, open carriage, or the like, so constructed that the occupants sit back to back.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "dose": {
      "word": "DOSE",
      "definitions": [
        {
          "text": "The quantity of medicine given, or prescribed to be taken, at one time.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A sufficient quantity; a portion; as much as one can take, or as falls to one to receive.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Anything nauseous that one is obliged to take; a disagreeable portion thrust upon one. I am for curing the world by gentle alteratives, not by violent doses. W. Irving. I dare undertake that as fulsome a dose as you give him, he shall readily take it down. South.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To proportion properly (a medicine), with reference to the patient or the disease; to form into suitable doses.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To give doses to; to medicine or physic to; to give potions to, constantly and without need. A self-opinioned physician, worse than his distemper, who shall dose, and bleed, and kill him, \"secundum artem.\" South",
          "partOfSpeech": "verb"
        },
        {
          "text": "To give anything nauseous to.",
          "partOfSpeech": "verb"
        }
      ],

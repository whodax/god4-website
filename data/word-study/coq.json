    "coquet": {
      "word": "COQUET",
      "definitions": [
        {
          "text": "To attempt to attract the notice, admiration, or love of; to treat with a show of tenderness or regard, with a view to deceive and disappoint. You are coquetting a maid of honor. Swift.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To trifle in love; to stimulate affection or interest; to play the coquette; to deal playfully instead of seriously; to play (with); as, we have coquetted with political crime.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },

    "haggle": {
      "word": "HAGGLE",
      "definitions": [
        {
          "text": "To cut roughly or hack; to cut into small pieces; to notch or cut in an unskillful manner; to make rough or mangle by cutting; as, a boy haggles a stick of wood. Suffolk first died, and York, all haggled o'er, Comes to him, where in gore he lay insteeped. Shak.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To be difficult in bargaining; to stick at small matters; to chaffer; to higgle. Royalty and science never haggled about the value of blood. Walpole.",
          "partOfSpeech": "verb"
        },
        {
          "text": "The act or process of haggling. Carlyle.",
          "partOfSpeech": "noun"
        }
      ],

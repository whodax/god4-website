    "haggard": {
      "word": "HAGGARD",
      "definitions": [
        {
          "text": "Wild or intractable; disposed to break away from duty; untamed; as, a haggard or refractory hawk. [Obs.] Shak",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Etym: [For hagged, fr. hag a witch, influenced by haggard wild.]",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Having the expression of one wasted by want or suffering; hollow-eyed; having the features distorted or wasted, or anxious in appearance; as, haggard features, eyes. Staring his eyes, and haggard was his look. Dryden.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Falconry)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A young or untrained hawk or falcon.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A fierce, intractable creature. I have loved this proud disdainful haggard. Shak.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Etym: [See Haggard, a., 2.]",
          "partOfSpeech": "noun"
        },
        {
          "text": "A hag. [Obs.] Garth.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A stackyard. [Prov. Eng.] Swift.",
          "partOfSpeech": "noun"
        }
      ],

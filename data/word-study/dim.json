    "diminution": {
      "word": "DIMINUTION",
      "definitions": [
        {
          "text": "The act of diminishing, or of making or becoming less; state of being diminished; reduction in size, quantity, or degree; -- opposed to augmentation or increase.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The act of lessening dignity or consideration, or the state of being deprived of dignity; a lowering in estimation; degradation; abasement. The world's opinion or diminution of me. Eikon Basilike. Nor thinks it diminution to be ranked In military honor next. Philips.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Law)",
          "partOfSpeech": "noun"
        },
        {
          "text": "Omission, inaccuracy, or defect in a record.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Mus.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "In counterpoint, the imitation of, or reply to, a subject, in notes of half the length or value of those the subject itself.",
          "partOfSpeech": "noun"
        }
      ],

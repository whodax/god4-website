          "partOfSpeech": "verb"
        },
        {
          "text": "(Her.)",
          "partOfSpeech": "verb"
        },
        {
          "text": "To represent the half of; to halve.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },

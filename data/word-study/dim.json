    "dimorphic": {
      "word": "DIMORPHIC",
      "definitions": [
        {
          "text": "Having the property of dimorphism; dimorphous.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "dimorphism": {
      "word": "DIMORPHISM",
      "definitions": [
        {
          "text": "(Biol.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "Difference of form between members of the same species, as when a plant has two kinds of flowers, both hermaphrodite (as in the partridge berry), or when there are two forms of one or both sexes of the same species of butterfly. Dimorphism is the condition of the appearance of the same species under two dissimilar forms. Darwin.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Crystallog.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "Crystallization in two independent forms of the same chemical compound, as of calcium carbonate as calcite and aragonite.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "dimorphous": {
      "word": "DIMORPHOUS",
      "definitions": [
        {
          "text": "(Biol.)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Characterized by dimorphism; occurring under two distinct forms, not dependent on sex; dimorphic.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Crystallog.)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Crystallizing under two forms fundamentally different, while having the same chemical composition.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "dimple": {
      "word": "DIMPLE",
      "definitions": [
        {
          "text": "A slight natural depression or indentation on the surface of some part of the body, esp. on the cheek or chin. Milton. The dimple of her chin. Prior.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A slight indentation on any surface. The garden pool's dark surface . . . Breaks into dimples small and bright. Wordsworth.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To form dimples; to sink into depressions or little inequalities. And smiling eddies dimpled on the main. Dryden.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To mark with dimples or dimplelike depressions. Shak.",
          "partOfSpeech": "verb"
        }
      ],

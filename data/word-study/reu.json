    "reunion": {
      "word": "REUNION",
      "definitions": [
        {
          "text": "A second union; union formed anew after separation, secession, or discord; as, a reunion of parts or particles of matter; a reunion of parties or sects.",
          "partOfSpeech": "noun"
        },
        {
          "text": "An assembling of persons who have been separated, as of a family, or the members of a disbanded regiment; an assembly so composed.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

    "dejection": {
      "word": "DEJECTION",
      "definitions": [
        {
          "text": "A casting down; depression. [Obs. or Archaic] Hallywell.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The act of humbling or abasing one's self. Adoration implies submission and dejection. Bp. Pearson.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Lowness of spirits occasioned by grief or misfortune; mental depression; melancholy. What besides, Of sorrow, and dejection, and despair, Our frailty can sustain, thy tidings bring. Milton.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A low condition; weakness; inability. [R.] A dejection of appetite. Arbuthnot.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Physiol.) (a) The discharge of excrement. (b) Fæces; excrement. Ray.",
          "partOfSpeech": "noun"
        }
      ],

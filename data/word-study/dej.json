    "deject": {
      "word": "DEJECT",
      "definitions": [
        {
          "text": "To cast down. [Obs. or Archaic] Christ dejected himself even unto the hells. Udall. Sometimes she dejects her eyes in a seeming civility; and many mistake in her a cunning for a modest look. Fuller.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To cast down the spirits of; to dispirit; to discourage; to dishearten. Nor think, to die dejects my lofty mind. Pope.",
          "partOfSpeech": "verb"
        },
        {
          "text": "Dejected. [Obs.]",
          "partOfSpeech": "adjective"
        }
      ],

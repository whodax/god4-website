    "connective": {
      "word": "CONNECTIVE",
      "definitions": [
        {
          "text": "Connecting, or adapted to connect; involving connection. Connection tissue (Anat.) See Conjunctive tissue, under Conjunctive.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "That which connects. Specifically: (a) (Gram.) A word that connect words or sentences; a conjunction or preposition. (b) (Bot.) That part of an anther which connects its thecæ, lobes, or cells.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

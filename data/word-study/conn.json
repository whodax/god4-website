    "connateperfoliate": {
      "word": "CONNATE-PERFOLIATE",
      "definitions": [
        {
          "text": "Connate or coalescent at the base so as to produce a broad foliaceous body through the center of which the stem passes; -- applied to leaves, as the leaves of the boneset.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "connation": {
      "word": "CONNATION",
      "definitions": [
        {
          "text": "Connection by birth; natural union. [Obs.] Dr. H. More.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "connatural": {
      "word": "CONNATURAL",
      "definitions": [
        {
          "text": "Connected by nature; united in nature; inborn; inherent; natural. These affections are connatural to us. L'Estrange.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Partaking of the same nature. And mix with our connatural dust. Milton.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "connaturality": {
      "word": "CONNATURALITY",
      "definitions": [
        {
          "text": "Participation of the same nature; natural union or connection. [R.] A congruity and connaturality between them. Sir M. Hale.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "connaturalize": {
      "word": "CONNATURALIZE",
      "definitions": [
        {
          "text": "To bring to the same nature as something else; to adapt. [Obs.] Dr. J. Scott.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "connaturally": {
      "word": "CONNATURALLY",
      "definitions": [
        {
          "text": "By the act of nature; originally; from birth. Sir M. Hale.",
          "partOfSpeech": "adverb"
        }
      ],
      "relatedWords": []
    },
    "connaturalness": {
      "word": "CONNATURALNESS",
      "definitions": [
        {
          "text": "Participation of the same nature; natural union. I. Walton.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "connature": {
      "word": "CONNATURE",
      "definitions": [
        {
          "text": "Participation in a common nature or character. [R.] Connature was defined as likeness in kind between either two changes in consciousness, or two states of consciousness. H. Spencer.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "connect": {
      "word": "CONNECT",
      "definitions": [
        {
          "text": "To join, or fasten together, as by something intervening; to associate; to combine; to unite or link together; to establish a bond or relation between. He fills, he bounds, connect and equals all. Pope. A man must the connection of each intermediate idea with those that it connects before he can use it in a syllogism. Locke.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To associate (a person or thing, or one's self) with another person, thing, business, or affair. Connecting rod (Mach.), a rod or bar joined to, and connecting, two or more moving parts; esp. a rod connecting a crank wrist with a beam, crosshead, piston rod, or piston, as in a steam engine.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To join, unite, or cohere; to have a close relation; as, one line of railroad connects with another; one argument connect with another.",
          "partOfSpeech": "verb"
        }
      ],

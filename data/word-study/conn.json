    "connate": {
      "word": "CONNATE",
      "definitions": [
        {
          "text": "Born with another; being of the same birth.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Congenital; existing from birth. \"Connate notions.\" South. A difference has been made by some; those diseases or conditions which are dependent on original conformation being called congenital; while the diseases of affections that may have supervened during gestation or delivery are called connate. Dunglison.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Bot.)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Congenitally united; growing from one base, or united at their bases; united into one body; as, connate leaves or athers. See Illust. of Connate-perfoliate.",
          "partOfSpeech": "adjective"
        }
      ],

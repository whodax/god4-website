    "connascence": {
      "word": "CONNASCENCE; CONNASCENCY",
      "definitions": [
        {
          "text": "The common birth of two or more at the same tome; production of two or more together. Johnson.",
          "partOfSpeech": "noun"
        },
        {
          "text": "That which is born or produced with another.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The act of growing together. [Obs.] Wiseman.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

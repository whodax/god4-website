    "beild": {
      "word": "BEILD",
      "definitions": [
        {
          "text": "A place of shelter; protection; refuge. [Scot. & Prov. Eng.] [Also written bield and beeld.] The random beild o' clod or stane. Burns.",
          "partOfSpeech": "noun"
        }

    "behight": {
      "word": "BEHIGHT",
      "definitions": [
        {
          "text": "To promise; to vow. Behight by vow unto the chaste Minerve. Surrey.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To give in trust; to commit; to intrust. The keys are to thy hand behight. Spenser.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To adjudge; to assign by authority. The second was to Triamond behight. Spenser.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To mean, or intend. More than heart behighteth. Mir. for Mag.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To consider or esteem to be; to declare to be. All the lookers-on him dead behight. Spenser.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To call; to name; to address. Whom . . . he knew and thus behight. Spenser.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To command; to order. He behight those gates to be unbarred. Spenser.",
          "partOfSpeech": "verb"
        },
        {
          "text": "A vow; a promise. [Obs.] Surrey.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "behind": {
      "word": "BEHIND",
      "definitions": [
        {
          "text": "On the side opposite the front or nearest part; on the back side of; at the back of; on the other side of; as, behind a door; behind a hill. A tall Brabanter, behind whom I stood. Bp. Hall.",
          "partOfSpeech": "preposition"
        },
        {
          "text": "Left after the departure of, whether this be by removing to a distance or by death. A small part of what he left behind him. Pope.",
          "partOfSpeech": "preposition"
        },
        {
          "text": "Left a distance by, in progress of improvement Hence: Inferior to in dignity, rank, knowledge, or excellence, or in any achievement. I was not a whit behind the very chiefest apostles. 2 Cor. xi. 5.",
          "partOfSpeech": "preposition"
        },
        {
          "text": "At the back part; in the rear. \"I shall not lag behind.\" Milton.",
          "partOfSpeech": "adverb"
        },
        {
          "text": "Toward the back part or rear; backward; as, to look behind.",
          "partOfSpeech": "adverb"
        },
        {
          "text": "Not yet brought forward, produced, or exhibited to view; out of sight; remaining. We can not be sure that there is no evidence behind. Locke.",
          "partOfSpeech": "adverb"
        },
        {
          "text": "Backward in time or order of succession; past. Forgetting those things which are behind. Phil. ii. 13.",
          "partOfSpeech": "adverb"
        },
        {
          "text": "After the departure of another; as, to stay behind. Leave not a rack behind. Shak.",
          "partOfSpeech": "adverb"
        },
        {
          "text": "The backside; the rump. [Low]",
          "partOfSpeech": "noun"
        }
      ],

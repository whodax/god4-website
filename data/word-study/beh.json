    "behold": {
      "word": "BEHOLD",
      "definitions": [
        {
          "text": "To have in sight; to see clearly; to look at; to regard with the eyes. When he beheld the serpent of brass, he lived. Num. xxi. 9. Behold the Lamb of God, which taketh away the sin of the world. John. i. 29.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To direct the eyes to, or fix them upon, an object; to look; to see. And I beheld, and, lo, in the midst of the throne, . . . a lamb as it had been slain. Rev. v. 6.",
          "partOfSpeech": "verb"
        }
      ],

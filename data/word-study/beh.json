    "behoove": {
      "word": "BEHOOVE",
      "definitions": [
        {
          "text": "To be necessary for; to be fit for; to be meet for, with respect to necessity, duty, or convenience; -- mostly used impersonally. And thus it behooved Christ to suffer. Luke xxiv. 46. [Also written behove.]",
          "partOfSpeech": "verb"
        },
        {
          "text": "To be necessary, fit, or suitable; to befit; to belong as due. Chaucer.",
          "partOfSpeech": "verb"
        },
        {
          "text": "Advantage; behoof. [Obs.] It shall not be to his behoove. Gower.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

    "behest": {
      "word": "BEHEST",
      "definitions": [
        {
          "text": "That which is willed or ordered; a command; a mandate; an injunction. To do his master's high behest. Sir W. Scott.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A vow; a promise. [Obs.] The time is come that I should send it her, if I keep the behest that I have made. Paston.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To vow. [Obs.] Paston.",
          "partOfSpeech": "verb"
        }
      ],

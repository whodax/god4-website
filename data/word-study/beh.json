    "behindhand": {
      "word": "BEHINDHAND",
      "definitions": [
        {
          "text": "In arrears financially; in a state where expenditures have exceeded the receipt of funds.",
          "partOfSpeech": "adverb"
        },
        {
          "text": "In a state of backwardness, in respect to what is seasonable or appropriate, or as to what should have been accomplished; not equally forward with some other person or thing; dilatory; backward; late; tardy; as, behindhand in studies or in work. In this also [dress] the country are very much behindhand. Addison.",
          "partOfSpeech": "adverb"
        }

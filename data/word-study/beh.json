    "behave": {
      "word": "BEHAVE",
      "definitions": [
        {
          "text": "To manage or govern in point of behavior; to discipline; to handle; to restrain. [Obs.] He did behave his anger ere 't was spent. Shak.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To carry; to conduct; to comport; to manage; to bear; -- used reflexively. Those that behaved themselves manfully. 2 Macc. ii. 21.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To act; to conduct; to bear or carry one's self; as, to behave well or ill. manner; as, if he does not behave, he will be punished. It is also often applied to inanimate objects; as, the ship behaved splendidly.",
          "partOfSpeech": "verb"
        }
      ],

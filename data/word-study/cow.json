    "cowardly": {
      "word": "COWARDLY",
      "definitions": [
        {
          "text": "Wanting courage; basely or weakly timid or fearful; pusillanimous; spiritless. The cowardly rascals that ran from the battle. Shak.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Proceeding from fear of danger or other consequences; befitting a coward; dastardly; base; as, cowardly malignity. Macualay. The cowardly rashness of those who dare not look danger in the face. Burke. craven; faint-hearted; chicken-hearted; white-livered.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "In the manner of a coward. Spenser.",
          "partOfSpeech": "adverb"
        }
      ],

    "cow": {
      "word": "COW",
      "definitions": [
        {
          "text": "A chimney cap; a cowl",
          "partOfSpeech": "noun"
        },
        {
          "text": "The mature female of bovine animals.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The female of certain large mammals, as whales, seals, etc.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To depress with fear; to daunt the spirits or courage of; to overawe. To vanquish a people already cowed. Shak. THe French king was cowed. J. R. Green.",
          "partOfSpeech": "verb"
        },

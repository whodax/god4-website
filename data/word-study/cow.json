    "coward": {
      "word": "COWARD",
      "definitions": [
        {
          "text": "(Her.)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Borne in the escutcheon with his tail doubled between his legs;",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Destitute of courage; timid; cowardly. Fie, coward woman, and soft-hearted wretch. Shak.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Belonging to a coward; proceeding from, or expressive of, base fear or timidity. He raised the house with loud and coward cries. Shak. Invading fears repel my coward joy. Proir.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "A person who lacks courage; a timid or pusillanimous person; a poltroon. A fool is nauseous, but a coward worse. Dryden.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To make timoroys; to frighten. [Obs.] That which cowardeth a man's heart. Foxe.",
          "partOfSpeech": "verb"
        }
      ],

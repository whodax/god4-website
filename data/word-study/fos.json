    "fossette": {
      "word": "FOSSETTE",
      "definitions": [
        {
          "text": "A little hollow; hence, a dimple.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Med.)",
          "partOfSpeech": "noun"

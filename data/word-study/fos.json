    "fossilist": {
      "word": "FOSSILIST",
      "definitions": [
        {
          "text": "One who is versed in the science of fossils; a paleontologist. Joseph Black.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "fossilization": {
      "word": "FOSSILIZATION",
      "definitions": [
        {
          "text": "The process of converting, or of being converted, into a fossil.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "fossilize": {
      "word": "FOSSILIZE",
      "definitions": [
        {
          "text": "To convert into a fossil; to petrify; as, to fossilize bones or wood.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To cause to become antiquated, rigid, or fixed, as by fossilization; to mummify; to deaden. Ten layers of birthdays on a woman's head Are apt to fossilize her girlish mirth. Mrs. Browning.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To become fossil.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To become antiquated, rigid, or fixed, beyond the influence of change or progress.",
          "partOfSpeech": "verb"
        }
      ],

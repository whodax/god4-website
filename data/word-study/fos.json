    "foster": {
      "word": "FOSTER",
      "definitions": [
        {
          "text": "To feed; to nourish; to support; to bring up. Some say that ravens foster forlorn children. Shak.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To cherish; to promote the growth of; to encourage; to sustain and promote; as, to foster genius.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To be nourished or trained up together. [Obs.] Spenser.",
          "partOfSpeech": "verb"
        },
        {
          "text": "Relating to nourishment; affording, receiving, or sharing nourishment or nurture; -- applied to father, mother, child, brother, etc., to indicate that the person so called stands in the relation of parent, child, brother, etc., as regards sustenance and nurture, but not by tie of blood. Foster babe, or child, an infant of child nursed by a woman not its mother, or bred by a man not its father. the same breast, or brought up by the same nurse as another, but is not of the same parentage. native soil. J. Philips. for a child. Bacon. remuneration fixed for the rearing of a foster child; also, the jointure of a wife. [Obs.] Wharton. and care of a child; a nurse.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "A forester. [Obs.] Spenser.",
          "partOfSpeech": "noun"
        },
        {
          "text": "One who, or that which, fosters.",
          "partOfSpeech": "noun"
        }
      ],

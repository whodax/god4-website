    "fossilism": {
      "word": "FOSSILISM",
      "definitions": [
        {
          "text": "The science or state of fossils. Coleridge.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The state of being extremely antiquated in views and opinions.",
          "partOfSpeech": "noun"
        }

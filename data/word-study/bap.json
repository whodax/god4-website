    "baptize": {
      "word": "BAPTIZE",
      "definitions": [
        {
          "text": "To administer the sacrament of baptism to.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To christen ( because a name is given to infants at their baptism); to give a name to; to name. I'll be new baptized; Henceforth I never will be Romeo. Shak.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To sanctify; to consecrate.",
          "partOfSpeech": "verb"
        }
      ],

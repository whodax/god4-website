    "anvil": {
      "word": "ANVIL",
      "definitions": [
        {
          "text": "An iron block, usually with a steel face, upon which metals are hammered and shaped.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Anything resembling an anvil in shape or use. Specifically (Anat.),",
          "partOfSpeech": "noun"
        },
        {
          "text": "the incus. See Incus. To be on the anvil, to be in a state of discussion, formation, or preparation, as when a scheme or measure is forming, but not matured. Swift.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To form or shape on an anvil; to hammer out; as, anviled armor. Beau. & Fl.",
          "partOfSpeech": "verb"
        }
      ],

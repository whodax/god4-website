  "entries": {
    "build": {
      "word": "BUILD",
      "definitions": [
        {
          "text": "To erect or construct, as an edifice or fabric of any kind; to form by uniting materials into a regular structure; to fabricate; to make; to raise. Nor aught availed him now To have built in heaven high towers. Milton.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To raise or place on a foundation; to form, establish, or produce by using appropriate means. Who builds his hopes in air of your good looks. Shak.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To increase and strengthen; to increase the power and stability of; to settle, or establish, and preserve; -- frequently with up; as, to build up one's constitution. I commend you to God, and to the word of his grace, which is able to build you up. Acts xx. 32.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To exercise the art, or practice the business, of building.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To rest or depend, as on a foundation; to ground one's self or one's hopes or opinions upon something deemed reliable; to rely; as, to build on the opinions or advice of others.",
          "partOfSpeech": "verb"
        },
        {
          "text": "Form or mode of construction; general figure; make; as, the build of a ship.",
          "partOfSpeech": "noun"
        }
      ],

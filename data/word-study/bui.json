    "builder": {
      "word": "BUILDER",
      "definitions": [
        {
          "text": "One who builds; one whose occupation is to build, as a carpenter, a shipwright, or a mason. In the practice of civil architecture, the builder comes between the architect who designs the work and the artisans who execute it. Eng. Cyc.",
          "partOfSpeech": "noun"
        }
      ],

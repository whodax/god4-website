    "begettingbirthgenerationfrgeneregigneretobegetcff": {
      "word": "begetting, birth, generation, fr. genere, gignere, to beget: cf. F.",
      "definitions": [
        {
          "text": "The state of being the firstborn of the same parents; seniority by birth among children of the same family.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Eng. Law)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "The exclusive right of inheritance which belongs to the eldest son. Thus in England the right of inheriting the estate of the father belongs to the eldest son, and in the royal family the eldest son of the sovereign is entitled to the throne by primogeniture. In exceptional cases, among the female children, the crown descends by right of primogeniture to the eldest daughter only and her issue. Blackstone.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },

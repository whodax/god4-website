    "beggar": {
      "word": "BEGGAR",
      "definitions": [
        {
          "text": "One who begs; one who asks or entreats earnestly, or with humility; a petitioner.",
          "partOfSpeech": "noun"
        },
        {
          "text": "One who makes it his business to ask alms.",
          "partOfSpeech": "noun"
        },
        {
          "text": "One who is dependent upon others for support; -- a contemptuous or sarcastic use.",
          "partOfSpeech": "noun"
        },
        {
          "text": "One who assumes in argument what he does not prove. Abp. Tillotson.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To reduce to beggary; to impoverish; as, he had beggared himself. Milton.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To cause to seem very poor and inadequate. It beggared all description. Shak.",
          "partOfSpeech": "verb"
        }
      ],

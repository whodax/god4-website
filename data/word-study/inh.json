    "inhabitation": {
      "word": "INHABITATION",
      "definitions": [
        {
          "text": "The act of inhabiting, or the state of being inhabited; indwelling. The inhabitation of the Holy Ghost. Bp. Pearson.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Abode; place of dwelling; residence. [Obs.] Milton.",
          "partOfSpeech": "noun"
        },
        {

    "inhabitable": {
      "word": "INHABITABLE",
      "definitions": [
        {
          "text": "Capable of being inhabited; habitable. Systems of inhabitable planets. Locke.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Not habitable; not suitable to be inhabited. [Obs.] The frozen ridges of the Alps Or other ground inhabitable. Shak.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "inhabitanceinhabitancy": {
      "word": "INHABITANCE; INHABITANCY",
      "definitions": [
        {
          "text": "The act of inhabiting, or the state of being inhabited; the condition of an inhabitant; residence; occupancy. Ruins yet resting in the wild moors testify a former inhabitance. Carew.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Law)",
          "partOfSpeech": "noun"
        },
        {
          "text": "The state of having legal right to claim the privileges of a recognized inhabitant; especially, the right to support in case of poverty, acquired by residence in a town; habitancy.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "inhabitant": {
      "word": "INHABITANT",
      "definitions": [
        {
          "text": "One who dwells or resides permanently in a place, as distinguished from a transient lodger or visitor; as, an inhabitant of a house, a town, a city, county, or state. \"Frail inhabitants of earth.\" Cowper. In this place, they report that they saw inhabitants which were very fair and fat people. Abp. Abbot.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Law)",
          "partOfSpeech": "noun"
        },
        {
          "text": "One who has a legal settlement in a town, city, or parish; a permanent resident.",
          "partOfSpeech": "noun"
        }
      ],

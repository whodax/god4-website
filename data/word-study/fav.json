    "favorable": {
      "word": "FAVORABLE",
      "definitions": [
        {
          "text": "Full of favor; favoring; manifesting partiality; kind; propitious; friendly. Lend favorable ears to our request. Shak. Lord, thou hast been favorable unto thy land. Ps. lxxxv. 1.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Conducive; contributing; tending to promote or facilitate; advantageous; convenient. A place very favorable for the making levies of men. Clarendon. The temper of the climate, favorable to generation, health, and long life. Sir W. Temple.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Beautiful; well-favored. [Obs.] Spenser. The faborableness of the present times to all extertions in the cause of liberty. Burke.",
          "partOfSpeech": "adjective"
        }
      ],

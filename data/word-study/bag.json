    "baggage": {
      "word": "BAGGAGE",
      "definitions": [
        {
          "text": "The clothes, tents, utensils, and provisions of an army. clothing and to small personal effects.\" Farrow.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The trunks, valises, satchels, etc., which a traveler carries with him on a journey; luggage. The baronet's baggage on the roof of the coach. Thackeray. We saw our baggage following below. Johnson.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Purulent matter. [Obs.] Barrough.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Trashy talk. [Obs.] Ascham.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A man of bad character. [Obs.] Holland.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A woman of loose morals; a prostitute. A disreputable, daring, laughing, painted French baggage. Thackeray.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A romping, saucy girl. [Playful] Goldsmith.",
          "partOfSpeech": "noun"
        }
      ],

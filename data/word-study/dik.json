  "entries": {
    "dika": {
      "word": "DIKA",
      "definitions": [
        {
          "text": "A kind of food, made from the almondlike seeds of the Irvingia Barteri, much used by natives of the west coast of Africa; -- called also dika bread.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "dike": {
      "word": "DIKE",
      "definitions": [
        {
          "text": "A ditch; a channel for water made by digging. Little channels or dikes cut to every bed. Ray.",
          "partOfSpeech": "noun"
        },
        {
          "text": "An embankment to prevent inundations; a levee. Dikes that the hands of the farmers had raised . . . Shut out the turbulent tides. Longfellow.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A wall of turf or stone. [Scot.]",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Geol.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A wall-like mass of mineral matter, usually an intrusion of igneous rocks, filling up rents or fissures in the original strata.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To surround or protect with a dike or dry bank; to secure with a bank.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To drain by a dike or ditch.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To work as a ditcher; to dig. [Obs.] He would thresh and thereto dike and delve. Chaucer.",
          "partOfSpeech": "verb"
        }
      ],

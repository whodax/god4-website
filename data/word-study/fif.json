    "fifteenth": {
      "word": "FIFTEENTH",
      "definitions": [
        {
          "text": "Next in order after the fourteenth; -- the ordinal of fifteen.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Consisting of one of fifteen equal parts or divisions of a thing.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "One of fifteen equal parts or divisions; the quotient of a unit divided by fifteen.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A species of tax upon personal property formerly laid on towns, boroughs, etc., in England, being one fifteenth part of what the personal property in each town, etc., had been valued at. Burrill.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Mus.) (a) A stop in an organ tuned two octaves above the diaposon. (b) An interval consisting of two octaves.",
          "partOfSpeech": "noun"
        }

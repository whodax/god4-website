    "bumboat": {
      "word": "BUMBOAT",
      "definitions": [
        {
          "text": "A clumsy boat, used for conveying provisions, fruit, etc., for sale, to vessels lying in port or off shore.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "bumkin": {
      "word": "BUMKIN",
      "definitions": [
        {
          "text": "A projecting beam or boom; as: (a) One projecting from each bow of a vessel, to haul the fore tack to, called a tack bumpkin. (b) Onr from each quarter, for the main-brace blocks, and called brace bumpkin. (c) A small outrigger over the stern of a boat, to extend the mizzen. [Written also boomkin.]",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "bummalo": {
      "word": "BUMMALO",

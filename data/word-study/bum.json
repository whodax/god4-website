    "bummery": {
      "word": "BUMMERY",
      "definitions": [
        {
          "text": "See Bottomery. [Obs.] There was a scivener of Wapping brought to hearing for relief against a bummery bond. R. North.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []

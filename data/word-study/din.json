    "ding": {
      "word": "DING",
      "definitions": [
        {
          "text": "To dash; to throw violently. [Obs.] To ding the book a coit's distance from him. Milton.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To cause to sound or ring. To ding (anything) in one's ears, to impress one by noisy repetition, as if by hammering.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To strike; to thump; to pound. [Obs.] Diken, or delven, or dingen upon sheaves. Piers Plowman.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To sound, as a bell; to ring; to clang. The fretful tinkling of the convent bell evermore dinging among the mountain echoes. W. Irving.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To talk with vehemence, importunity, or reiteration; to bluster. [Low]",
          "partOfSpeech": "verb"
        },
        {
          "text": "A thump or stroke, especially of a bell.",
          "partOfSpeech": "noun"
        }
      ],

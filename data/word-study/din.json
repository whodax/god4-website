    "din": {
      "word": "DIN",
      "definitions": [
        {
          "text": "Loud, confused, harsh noise; a loud, continuous, rattling or clanging sound; clamor; roar. Think you a little din can daunt mine ears Shak. He knew the battle's din afar. Sir W. Scott. The dust and din and steam of town. Tennyson.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To strike with confused or clanging sound; to stun with loud and continued noise; to harass with clamor; as, to din the ears with cries.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To utter with a din; to repeat noisily; to ding. This hath been often dinned in my ears. Swift. To din into, to fix in the mind of another by frequent and noisy repetitions. Sir W. Scott.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To sound with a din; a ding. The gay viol dinning in the dale. A. Seward.",
          "partOfSpeech": "verb"
        }
      ],

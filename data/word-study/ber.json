    "bereave": {
      "word": "BEREAVE",
      "definitions": [
        {
          "text": "To make destitute; to deprive; to strip; -- with of before the person or thing taken away. Madam, you have bereft me of all words. Shak. Bereft of him who taught me how to sing. Tickell.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To take away from. [Obs.] All your interest in those territories Is utterly bereft you; all is lost. Shak.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To take away. [Obs.] Shall move you to bereave my life. Marlowe. to immaterial objects. We say bereaved or bereft by death of a relative, bereft of hope and strength.",
          "partOfSpeech": "verb"
        }
      ],

    "henbane": {
      "word": "HENBANE",
      "definitions": [
        {
          "text": "A plant of the genus Hyoscyamus (H. niger). All parts of the plant are poisonous, and the leaves are used for the same purposes as belladonna. It is poisonous to domestic fowls; whence the name. Called also, stinking nightshade, from the fetid odor of the plant. See Hyoscyamus.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

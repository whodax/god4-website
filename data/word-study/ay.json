    "ay": {
      "word": "AY",
      "definitions": [
        {
          "text": "Ah! alas! \"Ay me! I fondly dream `Had ye been there.'\" Milton.",
          "partOfSpeech": "interjection"
        },
        {
          "text": "Same as Aye.",
          "partOfSpeech": "adverb"
        },
        {
          "text": "Yes; yea; -- a word expressing assent, or an affirmative answer to a question. It is much used in viva voce voting in legislative bodies, etc. other old writers.",
          "partOfSpeech": "adverb"
        },
        {
          "text": "Always; ever; continually; for an indefinite time. For his mercies aye endure. Milton. For aye, always; forever; eternally.",
          "partOfSpeech": "adverb"
        }
      ],
      "relatedWords": []
    },

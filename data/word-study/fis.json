        }
      ],
      "relatedWords": []
    },
    "fiscal": {
      "word": "FISCAL",
      "definitions": [
        {
          "text": "Pertaining to the public treasury or revenue. The fiscal arreangements of government. A. Hamilton.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "The income of a prince or a state; revenue; exchequer. [Obs.] Bacon.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A treasurer. H. Swinburne.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A public officer in Scotland who prosecutes in petty criminal cases; -- called also procurator fiscal.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The solicitor in Spain and Portugal; the attorney-general.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

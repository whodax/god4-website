    "fisetin": {
      "word": "FISETIN",
      "definitions": [
        {
          "text": "A yellow crystalline substance extracted from fustet, and regarded as its essential coloring principle; -- called also fisetic acid.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []

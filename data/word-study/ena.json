    "enact": {
      "word": "ENACT",
      "definitions": [
        {
          "text": "To decree; to establish by legal and authoritative act; to make into a law; especially, to perform the legislative act with reference to (a bill) which gives it the validity of law.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To act; to perform; to do; to effect. [Obs.] The king enacts more wonders than a man. Shak.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To act the part of; to represent; to play. I did enact Julius Caesar. Shak. Enacting clause, that clause of a bill which formally expresses the legislative sanction.",
          "partOfSpeech": "verb"
        },
        {
          "text": "Purpose; determination. [Obs.]",
          "partOfSpeech": "noun"
        }
      ],

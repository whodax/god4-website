    "heighten": {
      "word": "HEIGHTEN",
      "definitions": [
        {
          "text": "To make high; to raise higher; to elevate.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To carry forward; to advance; to increase; to augment; to aggravate; to intensify; to render more conspicuous; -- used of things, good or bad; as, to heighten beauty; to heighten a flavor or a tint. \"To heighten our confusion.\" Addison. An aspect of mystery which was easily heightened to the miraculous. Hawthorne.",
          "partOfSpeech": "verb"
        }
      ],

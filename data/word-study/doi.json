    "doit": {
      "word": "DOIT",
      "definitions": [
        {
          "text": "A small Dutch coin, worth about half a farthing; also, a similar small coin once used in Scotland; hence, any small piece of money. Shak.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A thing of small value; as, I care not a doit.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

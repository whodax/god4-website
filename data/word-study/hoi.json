    "hoiden": {
      "word": "HOIDEN",
      "definitions": [
        {
          "text": "A rude, clownish youth. [Obs.] Milton.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A rude, bold girl; a romp. H. Kingsley.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Rustic; rude; bold. Younq.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "To romp rudely or indecently. Swift.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "hoidenhood": {
      "word": "HOIDENHOOD",
      "definitions": [
        {
          "text": "State of being a hoiden.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "hoidenish": {

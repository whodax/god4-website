    "ens": {
      "word": "ENS",
      "definitions": [
        {
          "text": "(Metaph.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "Entity, being, or existence; an actually existing being; also, God, as the Being of Beings.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Chem.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "Something supposed to condense within itself all the virtues and qualities of a substance from which it is extracted; essence.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

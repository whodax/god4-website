    "boxhaul": {
      "word": "BOXHAUL",
      "definitions": [
        {
          "text": "To put (a vessel) on the other tack by veering her short round on her heel; -- so called from the circumstance of bracing the head yards abox (i. e., sharp aback, on the wind). Totten.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "boxhauling": {
      "word": "BOXHAULING",
      "definitions": [

    "ankylosis": {
      "word": "ANCHYLOSIS; ANKYLOSIS",
      "definitions": [
        {
          "text": "(Med.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "Stiffness or fixation of a joint; formation of a stiff joint. Dunglison.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Anat.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "The union of two or more separate bones to from a single bone; the close union of bones or other structures in various animals.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Same as Anchylosis.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "ankylostomiasis": {
      "word": "ANKYLOSTOMIASIS",
      "definitions": [
        {
          "text": "A disease due to the presence of the parasites Agchylostoma duodenale, Uncinaria (subgenus Necator) americana, or allied nematodes, in the small intestine. When present in large numbers they produce a severe anæmia by sucking the blood from the intestinal walls. Called also miner's anæmia, tunnel disease, brickmaker's anæmia, Egyptian chlorosis.",
          "partOfSpeech": "noun"
        }
      ],

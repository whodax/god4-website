        }
      ],
      "relatedWords": []
    },
    "anecdote": {
      "word": "ANECDOTE",
      "definitions": [
        {
          "text": "pl.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Unpublished narratives. Burke.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A particular or detached incident or fact of an interesting nature; a biographical incident or fragment; a single passage of private life.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

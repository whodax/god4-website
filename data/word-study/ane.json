    "anecdotage": {
      "word": "ANECDOTAGE",
      "definitions": [
        {
          "text": "Anecdotes collectively; a collection of anecdotes. All history, therefore, being built partly, and some of it altogether, upon anecdotage, must be a tissue of lies. De Quincey.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "anecdotal": {
      "word": "ANECDOTAL",
      "definitions": [
        {
          "text": "Pertaining to, or abounding with, anecdotes; as, anecdotal conversation.",

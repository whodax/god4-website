    "anear": {
      "word": "ANEAR",
      "definitions": [
        {
          "text": "Near. [R.] \"It did not come anear.\" Coleridge. The measure of misery anear us. I. Taylor.",
          "partOfSpeech": "preposition"
        },
        {
          "text": "To near; to approach. [Archaic]",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },

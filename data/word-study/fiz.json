    "fizgig": {
      "word": "FIZGIG",
      "definitions": [
        {
          "text": "A fishing spear. [Obs.] Sandys.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A firework, made of damp powder, which makes a fizzing or hissing noise when it explodes.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A gadding, flirting girl. Gosson.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

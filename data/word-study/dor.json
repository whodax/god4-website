    "dor": {
      "word": "DOR",
      "definitions": [
        {
          "text": "A large European scaraboid beetle (Geotrupes stercorarius), which makes a droning noise while flying. The name is also applied to allied American species, as the June bug. Called also dorr, dorbeetle, or dorrbeetle, dorbug, dorrfly, and buzzard clock.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A trick, joke, or deception. Beau. & Fl. To give one the dor, to make a fool of him. [Archaic] P. Fletcher.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To make a fool of; to deceive. [Obs.] [Written also dorr.] B. Jonson.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "dorado": {
      "word": "DORADO",
      "definitions": [
        {
          "text": "(Astron.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A southern constellation, within which is the south pole of the ecliptic; -- called also sometimes Xiphias, or the Swordfish.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Zoöl.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A large, oceanic fish of the genus Coryphæna.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "dorbeetle": {
      "word": "DORBEETLE",
      "definitions": [
        {
          "text": "See 1st Dor.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "doree": {
      "word": "DOREE",
      "definitions": [
        {
          "text": "A European marine fish (Zeus faber), of a yellow color. See Illust. of John Doree. to be a corruption of F. jaune-dorée, i. e., golden-yellow. See 1st Dory.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "doretree": {
      "word": "DORETREE",
      "definitions": [
        {
          "text": "A doorpost. [Obs.] \"As dead as a doretree.\" Piers Plowman.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "dorhawk": {
      "word": "DORHAWK",
      "definitions": [
        {
          "text": "The European goatsucker; -- so called because it eats the dor beetle. See Goatsucker. [Written also dorrhawk.] Booth.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "dorian": {
      "word": "DORIAN",
      "definitions": [
        {
          "text": "Of or pertaining to the ancient Greeks of Doris; Doric; as, a Dorian fashion.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Mus.)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Same as Doric, 3. \"Dorian mood.\" Milton. Dorian mode (Mus.), the first of the authentic church modes or tones, from D to D, resembling our D minor scale, but with the B natural. Grove.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "A native or inhabitant of Doris in Greece.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "doric": {
      "word": "DORIC",
      "definitions": [
        {
          "text": "Pertaining to Doris, in ancient Greece, or to the Dorians; as, the Doric dialect.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Arch.)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Belonging to, or resembling, the oldest and simplest of the three orders of architecture used by the Greeks, but ranked as second of the five orders adopted by the Romans. See Abacus, Capital, Order. details, as Grecian Doric, or Roman Doric.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Mus.)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Of or relating to one of the ancient Greek musical modes or keys. Its character was adapted both to religions occasions and to war.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "The Doric dialect.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "doricism": {
      "word": "DORICISM",
      "definitions": [
        {

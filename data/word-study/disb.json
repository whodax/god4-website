    "disband": {
      "word": "DISBAND",
      "definitions": [
        {
          "text": "To loose the bands of; to set free; to disunite; to scatter; to disperse; to break up the organization of; especially, to dismiss from military service; as, to disband an army. They disbanded themselves and returned, every man to his own dwelling. Knolles.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To divorce. [Obs.] And therefore . . . she ought to be disbanded. Milton.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To become separated, broken up, dissolved, or scattered; especially, to quit military service by breaking up organization. When both rocks and all things shall disband. Herbert. Human society would in a short space disband. Tillotson.",
          "partOfSpeech": "verb"
        }
      ],

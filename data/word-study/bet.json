    "bethink": {
      "word": "BETHINK",
      "definitions": [
        {
          "text": "To call to mind; to recall or bring to recollection, reflection, or consideration; to think; to consider; -- generally followed by a reflexive pronoun, often with of or that before the subject of thought. I have bethought me of another fault. Shak. The rest . . . may . . . bethink themselves, and recover. Milton. We bethink a means to break it off. Shak.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To think; to recollect; to consider. \"Bethink ere thou dismiss us.\" Byron.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },

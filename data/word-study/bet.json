    "bet": {
      "word": "BET",
      "definitions": [
        {
          "text": "That which is laid, staked, or pledged, as between two parties, upon the event of a contest or any contingent issue; the act of giving such a pledge; a wager. \"Having made his bets.\" Goldsmith.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To stake or pledge upon the event of a contingent issue; to wager. John a Gaunt loved him well, and betted much money on his head. Shak. I'll bet you two to one I'll make him do it. O. W. Holmes.",
          "partOfSpeech": "verb"
        },
        {
          "text": "imp. & p. p. of Beat. [Obs.]",
          "partOfSpeech": ""
        },
        {
          "text": "An early form of Better. [Obs.] To go bet, to go fast; to hurry. [Obs.] Chaucer.",
          "partOfSpeech": "adjective"
        }
      ],

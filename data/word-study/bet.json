    "betimebetimes": {
      "word": "BETIME; BETIMES",
      "definitions": [
        {
          "text": "In good season or time; before it is late; seasonably; early. To measure life learn thou betimes. Milton. To rise betimes is often harder than to do all the day's work. Barrow.",

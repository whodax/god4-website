    "betroth": {
      "word": "BETROTH",
      "definitions": [
        {
          "text": "To contract to any one for a marriage; to engage or promise in order to marriage; to affiance; -- used esp. of a woman. He, in the first flower of my freshest age, Betrothed me unto the only heir. Spenser. Ay, and we are betrothed. Shak.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To promise to take (as a future spouse); to plight one's troth to. What man is there that hath betrothed a wife, and hath not taken her Deut. xx. 7.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To nominate to a bishopric, in order to consecration. Ayliffe.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },

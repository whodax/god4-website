    "buccaneer": {
      "word": "BUCCANEER",
      "definitions": [
        {
          "text": "A robber upon the sea; a pirate; -- a term applied especially to the piratical adventurers who made depredations on the Spaniards in America in the 17th and 18th centuries. [Written also bucanier.] manner of the Indians. The name was first given to the French settlers in Hayti or Hispaniola, whose business was to hunt wild cattle and swine.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To act the part of a buccaneer; to live as a piratical adventurer or sea robber.",
          "partOfSpeech": "verb"
        }
      ],

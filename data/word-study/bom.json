    "bombazine": {
      "word": "BOMBAZINE",
      "definitions": [
        {
          "text": "A twilled fabric for dresses, of which the warp is silk, and the weft worsted. Black bombazine has been much used for mourning garments. [Sometimes spelt bombasin, and bombasine.] Tomlinson.",
          "partOfSpeech": "noun"
        }

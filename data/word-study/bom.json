    "bombardobombardon": {
      "word": "BOMBARDO; BOMBARDON",
      "definitions": [
        {
          "text": "Originally, a deep-toned instrument of the oboe or bassoon family; thence, a bass reed stop on the organ. The name bombardon is now given to a brass instrument, the lowest of the saxhorns, in tone resembling the ophicleide. Grove.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

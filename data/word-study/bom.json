    "bombastry": {
      "word": "BOMBASTRY",
      "definitions": [
        {
          "text": "Swelling words without much meaning; bombastic language; fustian. Bombastry and buffoonery, by nature lofty and light, soar highest of all. Swift.",
          "partOfSpeech": "noun"

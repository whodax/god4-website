    "haul": {
      "word": "HAUL",
      "definitions": [
        {
          "text": "(Naut.)",
          "partOfSpeech": "verb"
        },
        {
          "text": "A pulling with force; a violent pull.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A single draught of a net; as, to catch a hundred fish at a haul.",
          "partOfSpeech": "noun"
        },
        {
          "text": "That which is caught, taken, or gained at once, as by hauling a net.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Transportation by hauling; the distance through which anything is hauled, as freight in a railroad car; as, a long haul or short haul.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Rope Making)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A bundle of about four hundred threads, to be tarred.",
          "partOfSpeech": "noun"
        }
      ],

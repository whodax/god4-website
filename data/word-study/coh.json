    "cohabitant": {
      "word": "COHABITANT",
      "definitions": [
        {
          "text": "One who dwells with another, or in the same place or country. No small number of the Danes became peaceable cohabitants with the Saxons in England. Sir W. Raleigh.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "cohabitation": {
      "word": "COHABITATION",
      "definitions": [
        {
          "text": "The act or state of dwelling together, or in the same place with another. Feltham.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Law)",
          "partOfSpeech": "noun"
        },
        {
          "text": "The living together of a man and woman in supposed sexual relationship. That the duty of cohabitation is released by the cruelty of one of the parties is admitted. Lord Stowell.",
          "partOfSpeech": "noun"
        }
      ],

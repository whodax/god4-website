    "coherent": {
      "word": "COHERENT",
      "definitions": [
        {
          "text": "Sticking together; cleaving; as the parts of bodies; solid or fluid. Arbuthnot.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Composed of mutually dependent parts; making a logical whole; consistent; as, a coherent plan, argument, or discourse.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Logically consistent; -- applied to persons; as, a coherent thinker. Watts.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Suitable or suited; adapted; accordant. [Obs.] Instruct my daughter how she shall persever, That time and place, with this deceit so lawful, May prove coherent. Shak.",
          "partOfSpeech": "adjective"
        }
      ],

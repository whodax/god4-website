    "dilapidate": {
      "word": "DILAPIDATE",
      "definitions": [
        {
          "text": "To bring into a condition of decay or partial ruin, by misuse or through neglect; to destroy the fairness and good condition of; -- said of a building. If the bishop, parson, or vicar, etc., dilapidates the buildings, or cuts down the timber of the patrimony. Blackstone.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To impair by waste and abuse; to squander. The patrimony of the bishopric of Oxon was much dilapidated. Wood.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To get out of repair; to fall into partial ruin; to become decayed; as, the church was suffered to dilapidate. Johnson.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },

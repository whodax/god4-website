    "dilate": {
      "word": "DILATE",
      "definitions": [
        {
          "text": "To expand; to distend; to enlarge or extend in all directions; to swell; -- opposed to contract; as, the air dilates the lungs; air is dilated by increase of heat.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To enlarge upon; to relate at large; to tell copiously or diffusely. [R.] Do me the favor to dilate at full What hath befallen of them and thee till now. Shak. expatiate.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To grow wide; to expand; to swell or extend in all directions. His heart dilates and glories in his strength. Addison.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To speak largely and copiously; to dwell in narration; to enlarge; But still on their ancient joys dilate. Crabbe.",
          "partOfSpeech": "verb"
        },
        {
          "text": "Extensive; expanded. [Obs.] B. Jonson.",
          "partOfSpeech": "adjective"
        }
      ],

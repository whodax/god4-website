    "disobey": {
      "word": "DISOBEY",
      "definitions": [
        {
          "text": "Not to obey; to neglect or refuse to obey (a superior or his commands, the laws, etc.); to transgress the commands of (one in authority); to violate, as an order; as, refractory children disobey their parents; men disobey their Maker and the laws. Not to disobey her lord's behest. Tennyson.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To refuse or neglect to obey; to violate commands; to be disobedient. He durst not know how to disobey. Sir P. Sidney.",
          "partOfSpeech": "verb"
        }
      ],

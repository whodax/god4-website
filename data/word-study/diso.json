    "disobedient": {
      "word": "DISOBEDIENT",
      "definitions": [
        {
          "text": "Neglecting or refusing to obey; omitting to do what is commanded, or doing what is prohibited; refractory; not observant of duty or rules prescribed by authority; -- applied to persons and acts. This disobedient spirit in the colonies. Burke. Disobedient unto the word of the Lord. 1 Kings xiii. 26.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Not yielding. Medicines used unnecessarily contribute to shorten life, by sooner rendering peculiar parts of the system disobedient to stimuli. E. Darwin.",
          "partOfSpeech": "adjective"
        }
      ],

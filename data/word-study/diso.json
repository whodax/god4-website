    "disorderly": {
      "word": "DISORDERLY",
      "definitions": [
        {
          "text": "Not in order; marked by disorder; disarranged; immethodical; as, the books and papers are in a disorderly state.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Not acting in an orderly way, as the functions of the body or mind.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Not complying with the restraints of order and law; tumultuous; unruly; lawless; turbulent; as, disorderly people; disorderly assemblies.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "(Law)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Offensive to good morals and public decency; notoriously offensive; as, a disorderly house. intemperate; unruly; lawless; vicious.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "In a disorderly manner; without law or order; irregularly; confusedly. Withdraw yourselves from every brother that walketh disorderly. 2 Thess. iii. 6. Savages fighting disorderly with stones. Sir W. Raleigh.",
          "partOfSpeech": "adverb"
        }
      ],

    "buxeous": {
      "word": "BUXEOUS",
      "definitions": [
        {
          "text": "Belonging to the box tree.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "buxine": {
      "word": "BUXINE",
      "definitions": [
        {
          "text": "An alkaloid obtained from the Buxus sempervirens, or common box tree. It is identical with bebeerine; -- called also buxina.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "buxom": {
      "word": "BUXOM",
      "definitions": [
        {
          "text": "Yielding; pliable or compliant; ready to obey; obedient; tractable; docile; meek; humble. [Obs.] So wild a beast, so tame ytaught to be, And buxom to his bands, is joy to see. Spenser. I submit myself unto this holy church of Christ, to be ever buxom and obedient to the ordinance of it. Foxe.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Having the characteristics of health, vigor, and comeliness, combined with a gay, lively manner; stout and rosy; jolly; frolicsome. A daughter fair, So buxom, blithe, and debonair. Milton. A parcel of buxom bonny dames, that were laughing, singing, dancing,",
          "partOfSpeech": "adjective"
        }
      ],

    "disrelish": {
      "word": "DISRELISH",
      "definitions": [
        {
          "text": "Want of relish; dislike (of the palate or of the mind); distaste; a slight degree of disgust; as, a disrelish for some kinds of food. Men love to hear of their power, but have an extreme disrelish to be told of their duty. Burke.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Absence of relishing or palatable quality; bad taste; nauseousness. Milton.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Not to relish; to regard as unpalatable or offensive; to feel a degree of disgust at. Pope.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To deprive of relish; to make nauseous or disgusting in a slight degree. Milton.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },

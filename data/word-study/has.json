    "hasty": {
      "word": "HASTY",
      "definitions": [
        {
          "text": "Involving haste; done, made, etc., in haste; as, a hasty sketch.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Demanding haste or immediate action. [R.] Chaucer. \"Hasty employment.\" Shak.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Moving or acting with haste or in a hurry; hurrying; hence, acting without deliberation; precipitate; rash; easily excited; eager.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Made or reached without deliberation or due caution; as, a hasty conjecture, inference, conclusion, etc., a hasty resolution. 5.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Proceeding from, or indicating, a quick temper. Take no unkindness of his hasty words. Shak",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Forward; early; first ripe. [Obs.] \"As the hasty fruit before the summer.\" Is. xxviii. 4.",
          "partOfSpeech": "adjective"
        }
      ],

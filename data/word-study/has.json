    "hasheeshhashish": {
      "word": "HASHEESH; HASHISH",
      "definitions": [
        {
          "text": "A slightly acrid gum resin produced by the common hemp (Cannabis saltiva), of the variety Indica, when cultivated in a warm climate; also, the tops of the plant, from which the resinous product is obtained. It is narcotic, and has long been used in the East for its intoxicating effect. See Bhang, and Ganja.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

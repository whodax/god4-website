    "hash": {
      "word": "HASH",
      "definitions": [
        {
          "text": "That which is hashed or chopped up; meat and vegetables, especially such as have been already cooked, chopped into small pieces and mixed.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A new mixture of old matter; a second preparation or exhibition. I can not bear elections, and still less the hash of them over again in a first session. Walpole.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To as, to hash meat. Hudibras.",
          "partOfSpeech": "verb"
        }
      ],

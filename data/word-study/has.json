    "hasp": {
      "word": "HASP",
      "definitions": [
        {
          "text": "A clasp, especially a metal strap permanently fast at one end to a staple or pin, while the other passes over a staple, and is fastened by a padlock or a pin; also, a metallic hook for fastening a door.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A spindle to wind yarn, thread, or silk on.",
          "partOfSpeech": "noun"
        },
        {
          "text": "An instrument for cutting the surface of grass land; a scarifier.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To shut or fasten with a hasp.",
          "partOfSpeech": "verb"
        }
      ],

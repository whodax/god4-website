    "caffeic": {
      "word": "CAFFEIC",
      "definitions": [
        {
          "text": "Pertaining to, or obtained from, coffee. Caffeic acid, an acid obtained from coffee tannin, as a yellow crystalline substance,",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "caffeine": {
      "word": "CAFFEINE",
      "definitions": [
        {
          "text": "A white, bitter, crystallizable substance, obtained from coffee. It is identical with the alkaloid theine from tea leaves, and with guaranine from guarana.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "caffetannic": {
      "word": "CAFFETANNIC",
      "definitions": [
        {
          "text": "Pertaining to, or derived from, the tannin of coffee. Caffetannic acid, a variety of tannin obtained from coffee berries, regarded as a glucoside.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },

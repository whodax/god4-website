    "baa": {
      "word": "BAA",
      "definitions": [
        {
          "text": "To cry baa, or bleat as a sheep. He treble baas for help, but none can get. Sir P. Sidney.",
          "partOfSpeech": "verb"
        },
        {
          "text": "The cry or bleating of a sheep; a bleat.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "baaing": {
      "word": "BAAING",
      "definitions": [
        {
          "text": "The bleating of a sheep. Marryat.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "baal": {
      "word": "BAAL",
      "definitions": [
        {
          "text": "(Myth.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "The supreme male divinity of the Phoenician and Canaanitish nations. with qualifying epithets subjoined, answering to the different ideas of his character; as, Baal-berith (the Covenant Baal), Baal-zebub (Baal of the fly).",
          "partOfSpeech": "noun"
        },
        {
          "text": "pl.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The whole class of divinities to whom the name Baal was applied. Judges x. 6.",
          "partOfSpeech": "noun"
        }
      ],

    "unnail": {
      "word": "UNNAIL",
      "definitions": [
        {
          "text": "To remove the nails from; to unfasten by removing nails.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "unnapped": {
      "word": "UNNAPPED",
      "definitions": [
        {
          "text": "Finished without a nap. I did not attempt her with a threadbare name, Unnapped with meritorious actions. Beau. & Fl.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "unnatural": {
      "word": "UNNATURAL",
      "definitions": [
        {
          "text": "Not natural; contrary, or not conforming, to the order of nature; being without natural traits; as, unnatural crimes.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "unnaturalize": {
      "word": "UNNATURALIZE",
      "definitions": [
        {
          "text": "To make unnatural. [R.] Hales.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "unnature": {
      "word": "UNNATURE",
      "definitions": [
        {
          "text": "To change the nature of; to invest with a different or contrary nature. [Obs.] A right heavenly nature, indeed, as if were unnaturing them, doth so bridle them [the elements]. Sir P. Sidney.",
          "partOfSpeech": "verb"
        },
        {
          "text": "The contrary of nature; that which is unnatural. [R.] So as to be rather unnature, after all, than nature. H. Bushnell.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "unnear": {
      "word": "UNNEAR",
      "definitions": [
        {
          "text": "Not near; not close to; at a distance from. [Obs.] Davies (Muse's Sacrifice).",
          "partOfSpeech": "preposition"
        }
      ],
      "relatedWords": []
    },

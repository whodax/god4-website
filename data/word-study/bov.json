    "bovate": {
      "word": "BOVATE",
      "definitions": [
        {
          "text": "An oxgang, or as much land as an ox can plow in a year; an ancient measure of land, of indefinite quantity, but usually estimated at fifteen acres.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "boveycoal": {
      "word": "BOVEY COAL",
      "definitions": [
        {
          "text": "A kind of mineral coal, or brown lignite, burning with a weak flame, and generally a disagreeable odor; -- found at Bovey Tracey, Devonshire, England. It is of geological age of the oölite, and not of the true coal era.",
          "partOfSpeech": ""
        }
      ],
      "relatedWords": []
    },
    "bovid": {
      "word": "BOVID",
      "definitions": [
        {
          "text": "Relating to that tribe of ruminant mammals of which the genus Bos is the type.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "boviform": {
      "word": "BOVIFORM",
      "definitions": [
        {
          "text": "Resembling an ox in form; ox-shaped. [R.]",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "bovine": {
      "word": "BOVINE",
      "definitions": [
        {
          "text": "(Zoöl.)",
          "partOfSpeech": "adjective"
        },
        {
          "text": "of or pertaining to the genus Bos; relating to, or resembling, the ox or cow; oxlike; as, the bovine genus; a bovine antelope.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Having qualities characteristic of oxen or cows; sluggish and patient; dull; as, a bovine temperament. The bovine gaze of gaping rustics. W. Black.",
          "partOfSpeech": "adjective"
        }
      ],

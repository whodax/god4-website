    "unyoke": {
      "word": "UNYOKE",
      "definitions": [
        {
          "text": "To loose or free from a yoke. \"Like youthful steers unyoked, they take their courses.\" Shak.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To part; to disjoin; to disconnect. Shak.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "unyoked": {
      "word": "UNYOKED",
      "definitions": [
        {
          "text": "Not yet yoked; not having worn the yoke.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Freed or loosed from a yoke.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Licentious; unrestrained. [R.] Shak.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "unyolden": {
      "word": "UNYOLDEN",
      "definitions": [
        {
          "text": "Not yielded. [Obs.] \"[By] force . . . is he taken unyolden.\" Sir T. Browne.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    }
  }

    "imbibe": {
      "word": "IMBIBE",
      "definitions": [
        {
          "text": "To drink in; to absorb; to suck or take in; to receive as by drinking; as, a person imbibes drink, or a sponge imbibes moisture.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To receive or absorb into the mind and retain; as, to imbibe principles; to imbibe errors.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To saturate; to imbue. [Obs.] \"Earth, imbibed with . . . acid.\" Sir I. Newton.",
          "partOfSpeech": "verb"
        }
      ],

    "buoyant": {
      "word": "BUOYANT",
      "definitions": [
        {
          "text": "Having the quality of rising or floating in a fluid; tending to rise or float; as, iron is buoyant in mercury. \"Buoyant on the flood.\" Pope.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Bearing up, as a fluid; sustaining another body by being specifically heavier. The water under me was buoyant. Dryden.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Light-hearted; vivacious; cheerful; as, a buoyant disposition;",
          "partOfSpeech": "adjective"
        }

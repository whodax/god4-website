    "badger": {
      "word": "BADGER",
      "definitions": [
        {
          "text": "An itinerant licensed dealer in commodities used for food; a hawker; a huckster; -- formerly applied especially to one who bought grain in one place and sold it in another. [Now dialectic, Eng.]",
          "partOfSpeech": "noun"
        },
        {
          "text": "A carnivorous quadruped of the genus Meles or of an allied genus. It is a burrowing animal, with short, thick legs, and long claws on the fore feet. One species (M. vulgaris), called also brock, inhabits the north of Europe and Asia; another species (Taxidea Americana or Labradorica) inhabits the northern parts of North America. See Teledu.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A brush made of badgers' hair, used by artists. Badger dog. (Zoöl.) See Dachshund.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To tease or annoy, as a badger when baited; to worry or irritate persistently.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To beat down; to cheapen; to barter; to bargain.",
          "partOfSpeech": "verb"
        }
      ],

    "badge": {
      "word": "BADGE",
      "definitions": [
        {
          "text": "A distinctive mark, token, sign, or cognizance, worn on the person; as, the badge of a society; the badge of a policeman. \"Tax gatherers, recognized by their official badges. \" Prescott.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Something characteristic; a mark; a token. Sweet mercy is nobility's true badge. Shak.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Naut.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A carved ornament on the stern of a vessel, containing a window or the representation of one.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To mark or distinguish with a badge.",
          "partOfSpeech": "verb"
        }
      ],

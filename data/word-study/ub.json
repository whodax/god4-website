    "ubiquistubiquitarian": {
      "word": "UBIQUIST; UBIQUITARIAN",
      "definitions": [
        {
          "text": "One of a school of Lutheran divines which held that the body of Christ is present everywhere, and especially in the eucharist, in virtue of his omnipresence. Called also Ubiquitist, Ubiquitary.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "ubiquitariness": {
      "word": "UBIQUITARINESS",
      "definitions": [
        {
          "text": "Quality or state of being ubiquitary, or ubiquitous. [R.] Fuller.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "ubiquitary": {
      "word": "UBIQUITARY",
      "definitions": [
        {
          "text": "Ubiquitous. Howell.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "One who exists everywhere. B. Jonson.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Eccl. Hist.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A ubiquist. Bp. Hall.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "ubiquitist": {

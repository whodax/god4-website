      "relatedWords": []
    },
    "ubiquitous": {
      "word": "UBIQUITOUS",
      "definitions": [
        {
          "text": "Existing or being everywhere, or in all places, at the same",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "ubiquity": {
      "word": "UBIQUITY",
      "definitions": [
        {
          "text": "Existence everywhere, or in places, at the same time; omnipresence; as, the ubiquity of God is not disputed by those who admit his existence. The arms of Rome . . . were impeded by . . . the wide spaces to be traversed and the ubiquity of the enemy. C. Merivale.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Theol.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "The doctrine, as formulated by Luther, that Christ's glorified body is omnipresent.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    }
  }

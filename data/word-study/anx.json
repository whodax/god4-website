    "anxious": {
      "word": "ANXIOUS",
      "definitions": [
        {
          "text": "Full of anxiety or disquietude; greatly concerned or solicitous, esp. respecting future or unknown; being in painful suspense; -- applied to persons; as, anxious for the issue of a battle.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Accompanied with, or causing, anxiety; worrying; -- applied to things; as, anxious labor. The sweet of life, from which God hath bid dwell far off all anxious cares. Milton.",
          "partOfSpeech": "adjective"
        },
        {
          "text": "Earnestly desirous; as, anxious to please. He sneers alike at those who are anxious to preserve and at those who are eager for reform. Macaulay. object of solicitude. disturbed; watchful.",
          "partOfSpeech": "adjective"
        }
      ],

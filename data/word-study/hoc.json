    "hockle": {
      "word": "HOCKLE",
      "definitions": [
        {
          "text": "To hamstring; to hock; to hough. Hanmer.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To mow, as stubble. Mason.",

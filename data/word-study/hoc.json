    "hocus": {
      "word": "HOCUS",
      "definitions": [
        {
          "text": "To deceive or cheat. Halliwell.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To adulterate; to drug; as, liquor is said to be hocused for the purpose of stupefying the drinker. Dickens.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To stupefy with drugged liquor. Thackeray.",
          "partOfSpeech": "verb"
        },
        {
          "text": "One who cheats or deceives. South.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Drugged liquor.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "hocuspocus": {
      "word": "HOCUSPOCUS; HOCUS-POCUS",
      "definitions": [
        {
          "text": "A term used by jugglers in pretended incantations.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A juggler or trickster. Sir T. Herbert.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A juggler's trick; a cheat; nonsense. Hudibras.",
          "partOfSpeech": "noun"
        },

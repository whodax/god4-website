    "haven": {
      "word": "HAVEN",
      "definitions": [
        {
          "text": "A bay, recess, or inlet of the sea, or the mouth of a river, which affords anchorage and shelter for shipping; a harbor; a port. What shipping and what lading's in our haven. Shak. Their haven under the hill. Tennyson.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A place of safety; a shelter; an asylum. Shak. The haven, or the rock of love. Waller.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To shelter, as in a haven. Keats.",
          "partOfSpeech": "verb"
        }
      ],

    "anfractuosity": {
      "word": "ANFRACTUOSITY",
      "definitions": [
        {
          "text": "A state of being anfractuous, or full of windings and turnings; sinuosity. The anfractuosities of his intellect and temper. Macaulay.",
          "partOfSpeech": "noun"
        },
        {
          "text": "(Anat.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A sinuous depression or sulcus like those separating the convolutions of the brain.",
          "partOfSpeech": "noun"
        }
      ],

    "bruise": {
      "word": "BRUISE",
      "definitions": [
        {
          "text": "To fight with the fists; to box. Bruising was considered a fine, manly, old English custom. Thackeray.",
          "partOfSpeech": "verb"
        },
        {
          "text": "An injury to the flesh of animals, or to plants, fruit, etc., with a blunt or heavy instrument, or by collision with some other body; a contusion; as, a bruise on the head; bruises on fruit. From the sole of the foot even unto the head there is no soundness in it; but wounds, and bruises. Isa. i. 6.",
          "partOfSpeech": "noun"
        }
      ],

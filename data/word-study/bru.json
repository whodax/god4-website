    "bruisierbrusertobreakshiverperhfromohgbrochisoncf": {
      "word": "bruisier, bruser, to break, shiver, perh. from OHG. brochison. Cf.",
      "definitions": [
        {
          "text": "To injure, as by a blow or collision, without laceration; to contuse; as, to bruise one's finger with a hammer; to bruise the bark of a tree with a stone; to bruise an apple by letting it fall.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To break; as in a mortar; to bray, as minerals, roots, etc.; to crush. Nor bruise her flowerets with the armed hoofs. Shak.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },
    "bruit": {
      "word": "BRUIT",
      "definitions": [
        {
          "text": "Report; rumor; fame. The bruit thereof will bring you many friends. Shak.",
          "partOfSpeech": "noun"
        },
        {
          "text": "[French pron. (Med.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "An abnormal sound of several kinds, heard on auscultation.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To report; to noise abroad. I find thou art no less than fame hath bruited. Shak.",
          "partOfSpeech": "verb"
        }
      ],
      "relatedWords": []
    },

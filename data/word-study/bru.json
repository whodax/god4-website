    "bruiser": {
      "word": "BRUISER",
      "definitions": [
        {
          "text": "One who, or that which, bruises.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A boxer; a pugilist. R. Browning. Like a new bruiser on Broughtonic aand, Amid the lists our hero takes his stand. T. Warton.",

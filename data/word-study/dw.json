    "dwindle": {
      "word": "DWINDLE",
      "definitions": [
        {
          "text": "To diminish; to become less; to shrink; to waste or consume away; to become degenerate; to fall away. Weary sennights nine times nine Shall he dwindle, peak and pine. Shak. Religious societies, though begun with excellent intentions, are said to have dwindled into factious clubs. Swift.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To make less; to bring low. Our drooping days are dwindled down to naught. Thomson.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To break; to disperse. [R.] Clarendon.",
          "partOfSpeech": "verb"
        },
        {
          "text": "The process of dwindling; dwindlement; decline; degeneracy. [R.] Johnson.",
          "partOfSpeech": "noun"
        }
      ],

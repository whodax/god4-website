    "ogre": {
      "word": "OGRE",
      "definitions": [
        {
          "text": "An imaginary monster, or hideous giant of fairy tales, who lived on human beings; hence, any frightful giant; a cruel monster. His schoolroom must have resembled an ogre's den. Maccaulay.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "ogreish": {
      "word": "OGREISH",
      "definitions": [
        {
          "text": "Resembling an ogre; having the character or appearance of an ogre; suitable for an ogre. \"An ogreish kind of jocularity.\" Dickens.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "ogress": {
      "word": "OGRESS",
      "definitions": [
        {

    "ogee": {
      "word": "OGEE",
      "definitions": [
        {
          "text": "(Arch.)",
          "partOfSpeech": "noun"
        },
        {
          "text": "A molding, the section of which is the form of the letter S, with the convex part above; cyma reversa. See Illust. under Cyma.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Hence, any similar figure used for any purpose. Ogee arch (Arch.), a pointed arch, each of the sides of which has the curve of an ogee, that is, has a reversed curve near the apex.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "ogganition": {
      "word": "OGGANITION",
      "definitions": [
        {
          "text": "Snarling; grumbling. [R.] Bp. Montagu.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "ogham": {
      "word": "OGHAM",
      "definitions": [
        {
          "text": "A particular kind of writing practiced by the ancient Irish, and found in inscriptions on stones, metals, etc. [Written also ogam.]",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },

    "ogle": {
      "word": "OGLE",
      "definitions": [
        {
          "text": "To view or look at with side glances, as in fondness, or with a design to attract notice. And ogling all their audience, ere they speak. Dryden.",
          "partOfSpeech": "verb"
        },
        {
          "text": "An amorous side glance or look. Byron.",
          "partOfSpeech": "noun"
        }
      ],
      "relatedWords": []
    },
    "ogler": {

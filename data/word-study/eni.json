    "enigmaticenigmatical": {
      "word": "ENIGMATIC; ENIGMATICAL",
      "definitions": [
        {
          "text": "Relating to or resembling an enigma; not easily explained or accounted for; darkly expressed; obscure; puzzling; as, an enigmatical answer.",
          "partOfSpeech": "adjective"
        }
      ],
      "relatedWords": []
    },
    "enigmatist": {

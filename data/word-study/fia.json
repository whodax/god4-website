    "fiar": {
      "word": "FIAR",
      "definitions": [
        {
          "text": "(Scots Law)",
          "partOfSpeech": "noun"
        },
        {
          "text": "One in whom the property of an estate is vested, subject to the estate of a life renter. I am fiar of the lands; she a life renter. Sir W. Scott.",
          "partOfSpeech": "noun"
        },
        {
          "text": "pl.",
          "partOfSpeech": "noun"
        },
        {
          "text": "The price of grain, as legally fixed, in the counties of Scotland, for the current year.",
          "partOfSpeech": "noun"
        }

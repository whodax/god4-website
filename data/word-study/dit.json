    "ditty": {
      "word": "DITTY",
      "definitions": [
        {
          "text": "A saying or utterance; especially, one that is short and frequently repeated; a theme. O, too high ditty for my simple rhyme. Spenser.",
          "partOfSpeech": "noun"
        },
        {
          "text": "A song; a lay; a little poem intended to be sung. \"Religious, martial, or civil ditties.\" Milton.ditties sing. Sandys.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To sing; to warble a little tune. Beasts fain would sing; birds ditty to their notes. Herbert.",
          "partOfSpeech": "verb"

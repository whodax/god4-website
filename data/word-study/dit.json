    "ditch": {
      "word": "DITCH",
      "definitions": [
        {
          "text": "A trench made in the earth by digging, particularly a trench for draining wet land, for guarding or fencing inclosures, or for preventing an approach to a town or fortress. In the latter sense, it is called also a moat or a fosse.",
          "partOfSpeech": "noun"
        },
        {
          "text": "Any long, narrow receptacle for water on the surface of the earth.",
          "partOfSpeech": "noun"
        },
        {
          "text": "To dig a ditch or ditches in; to drain by a ditch or ditches; as, to ditch moist land.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To surround with a ditch. Shak.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To throw into a ditch; as, the engine was ditched and turned on its side.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To dig a ditch or ditches. Swift.",
          "partOfSpeech": "verb"
        }
      ],

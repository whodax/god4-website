    "coddle": {
      "word": "CODDLE",
      "definitions": [
        {
          "text": "To parboil, or soften by boiling. It [the guava fruit] may be coddled. Dampier.",
          "partOfSpeech": "verb"
        },
        {
          "text": "To treat with excessive tenderness; to pamper. How many of our English princes have been coddled at home by their fond papas and mammas! Thackeray. He [Lord Byron] never coddled his reputation. Southey.",
          "partOfSpeech": "verb"
        }
      ],
